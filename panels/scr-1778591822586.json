{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因の相関関係を分析し、需要予測の精度向上に活用</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h3>分析条件設定</h3>\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <label for=\"analysis-start-date\">分析期間（開始日）</label>\n        <input type=\"date\" id=\"analysis-start-date\" class=\"input\" required>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"analysis-end-date\">分析期間（終了日）</label>\n        <input type=\"date\" id=\"analysis-end-date\" class=\"input\" required>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>商品カテゴリ選択</label>\n        <div class=\"checkbox-group\" id=\"category-checkboxes\">\n          <label><input type=\"checkbox\" id=\"category-all\" class=\"category-checkbox\"> 全選択</label>\n        </div>\n      </div>\n      <div class=\"form-group\">\n        <label>分析要因選択</label>\n        <div class=\"checkbox-group\">\n          <label><input type=\"checkbox\" id=\"factor-weather\" class=\"factor-checkbox\" value=\"weather\"> 天候</label>\n          <label><input type=\"checkbox\" id=\"factor-event\" class=\"factor-checkbox\" value=\"event\"> イベント</label>\n          <label><input type=\"checkbox\" id=\"factor-season\" class=\"factor-checkbox\" value=\"season\"> 季節</label>\n        </div>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"comparison-products\">比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n        </select>\n      </div>\n    </div>\n    <div class=\"form-actions\">\n      <button id=\"btn-execute-analysis\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-clear-conditions\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 分析結果表示エリア -->\n  <div class=\"analysis-results\" id=\"analysis-results\" style=\"display: none;\">\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card\">\n      <h3>相関係数表</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性レベル</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- グラフ表示エリア -->\n    <div class=\"chart-container\">\n      <div class=\"card chart-card\">\n        <h3>散布図</h3>\n        <canvas id=\"scatter-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n      <div class=\"card chart-card\">\n        <h3>時系列比較チャート</h3>\n        <canvas id=\"timeseries-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- 相関強度ヒートマップ -->\n    <div class=\"card\">\n      <h3>相関強度ヒートマップ</h3>\n      <canvas id=\"heatmap-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n\n    <!-- 統計値サマリー -->\n    <div class=\"card\">\n      <h3>統計値サマリー</h3>\n      <div class=\"stats-grid\" id=\"stats-summary\">\n      </div>\n    </div>\n\n    <!-- 分析結果サマリー -->\n    <div class=\"card\">\n      <h3>分析結果サマリー</h3>\n      <div id=\"analysis-summary\" class=\"summary-panel\">\n      </div>\n    </div>\n\n    <!-- エクスポート機能 -->\n    <div class=\"card\">\n      <h3>結果エクスポート</h3>\n      <div class=\"export-actions\">\n        <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n        <button id=\"btn-export-pdf\" class=\"action-btn secondary\">PDF出力</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ローディング表示 -->\n  <div id=\"loading-overlay\" class=\"loading-overlay hidden\">\n    <div class=\"loading-content\">\n      <div class=\"spinner\"></div>\n      <p>分析処理中...</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.screen-header h1 {\n  margin: 0 0 8px 0;\n  color: var(--text);\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.checkbox-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.checkbox-group label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 0;\n  font-weight: normal;\n}\n\n.form-actions {\n  display: flex;\n  gap: 12px;\n  margin-top: 20px;\n}\n\n.analysis-results {\n  margin-top: 32px;\n}\n\n.chart-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.chart-card canvas {\n  width: 100%;\n  height: auto;\n  background: var(--bg-card);\n  border-radius: 4px;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n}\n\n.stat-item {\n  padding: 16px;\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n}\n\n.stat-label {\n  font-size: 14px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.stat-value {\n  font-size: 24px;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.summary-panel {\n  padding: 16px;\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  line-height: 1.6;\n}\n\n.export-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.loading-content {\n  background: var(--bg-card);\n  padding: 32px;\n  border-radius: 8px;\n  text-align: center;\n  color: var(--text);\n}\n\n.spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 16px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.correlation-row {\n  cursor: pointer;\n}\n\n.correlation-row:hover {\n  background: var(--bg-main);\n}\n\n.correlation-row.selected {\n  background: rgba(74, 144, 226, 0.1);\n}\n\n@media (max-width: 768px) {\n  .chart-container {\n    grid-template-columns: 1fr;\n  }\n  \n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}