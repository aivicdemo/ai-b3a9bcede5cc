{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因の相関関係を分析し、需要予測の精度向上に活用します</p>\n  </div>\n\n  <!-- 分析条件設定パネル -->\n  <div class=\"card analysis-conditions\">\n    <h2>分析条件設定</h2>\n    \n    <div class=\"form-grid\">\n      <!-- 分析対象期間 -->\n      <div class=\"form-group\">\n        <label for=\"start-date\">分析期間（開始日）</label>\n        <input type=\"date\" id=\"start-date\" class=\"input\" required>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"end-date\">分析期間（終了日）</label>\n        <input type=\"date\" id=\"end-date\" class=\"input\" required>\n      </div>\n\n      <!-- 店舗選択 -->\n      <div class=\"form-group\">\n        <label for=\"store-select\">対象店舗</label>\n        <select id=\"store-select\" class=\"input\" multiple required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n\n      <!-- 商品カテゴリ選択 -->\n      <div class=\"form-group\">\n        <label>商品カテゴリ</label>\n        <div class=\"checkbox-group\" id=\"category-checkboxes\">\n          <label><input type=\"checkbox\" id=\"select-all-categories\"> 全選択</label>\n        </div>\n      </div>\n\n      <!-- 分析要因選択 -->\n      <div class=\"form-group\">\n        <label>分析要因</label>\n        <div class=\"checkbox-group\">\n          <label><input type=\"checkbox\" id=\"factor-weather\" value=\"weather\"> 天候</label>\n          <label><input type=\"checkbox\" id=\"factor-event\" value=\"event\"> イベント</label>\n          <label><input type=\"checkbox\" id=\"factor-season\" value=\"season\"> 季節</label>\n        </div>\n      </div>\n\n      <!-- 比較対象商品選択 -->\n      <div class=\"form-group\">\n        <label for=\"comparison-products\">比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n          <option value=\"\">商品を選択してください</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"form-actions\">\n      <button id=\"btn-analyze\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-reset\" class=\"action-btn secondary\">条件リセット</button>\n    </div>\n  </div>\n\n  <!-- 分析結果表示エリア -->\n  <div id=\"analysis-results\" class=\"analysis-results hidden\">\n    \n    <!-- 分析結果サマリー -->\n    <div class=\"card analysis-summary\">\n      <h2>分析結果サマリー</h2>\n      <div class=\"summary-grid\">\n        <div class=\"summary-item\">\n          <span class=\"label\">分析期間</span>\n          <span id=\"summary-period\" class=\"value\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">対象店舗数</span>\n          <span id=\"summary-stores\" class=\"value\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">対象商品数</span>\n          <span id=\"summary-products\" class=\"value\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">最強相関係数</span>\n          <span id=\"summary-max-correlation\" class=\"value\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card correlation-table-card\">\n      <h2>相関係数表</h2>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性</th>\n              <th>評価</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- グラフエリア -->\n    <div class=\"chart-container\">\n      <!-- 散布図 -->\n      <div class=\"card chart-card\">\n        <h2>散布図</h2>\n        <canvas id=\"scatter-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n\n      <!-- 時系列比較チャート -->\n      <div class=\"card chart-card\">\n        <h2>時系列比較チャート</h2>\n        <canvas id=\"timeseries-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- 相関強度ヒートマップ -->\n    <div class=\"card heatmap-card\">\n      <h2>相関強度ヒートマップ</h2>\n      <canvas id=\"heatmap-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n\n    <!-- 統計値表示エリア -->\n    <div class=\"card statistics-card\">\n      <h2>統計値</h2>\n      <div class=\"statistics-grid\">\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">平均値</span>\n          <span id=\"stat-mean\" class=\"stat-value\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">標準偏差</span>\n          <span id=\"stat-stddev\" class=\"stat-value\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">最大値</span>\n          <span id=\"stat-max\" class=\"stat-value\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">最小値</span>\n          <span id=\"stat-min\" class=\"stat-value\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">中央値</span>\n          <span id=\"stat-median\" class=\"stat-value\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-label\">サンプル数</span>\n          <span id=\"stat-count\" class=\"stat-value\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- エクスポート機能 -->\n    <div class=\"card export-card\">\n      <h2>分析結果エクスポート</h2>\n      <div class=\"export-actions\">\n        <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n        <button id=\"btn-export-pdf\" class=\"action-btn secondary\">PDF出力</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ローディング表示 -->\n  <div id=\"loading-overlay\" class=\"loading-overlay hidden\">\n    <div class=\"loading-content\">\n      <div class=\"loading-spinner\"></div>\n      <p>分析を実行中です...</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.screen-header {\n  margin-bottom: 30px;\n}\n\n.screen-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.checkbox-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.checkbox-group label {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  margin-bottom: 0;\n  font-weight: normal;\n}\n\n.form-actions {\n  display: flex;\n  gap: 10px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n.analysis-results {\n  margin-top: 30px;\n}\n\n.summary-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n}\n\n.summary-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.summary-item .label {\n  color: var(--text-muted);\n  font-size: 0.9em;\n}\n\n.summary-item .value {\n  color: var(--text);\n  font-size: 1.2em;\n  font-weight: 600;\n}\n\n.chart-container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.chart-card canvas {\n  width: 100%;\n  height: auto;\n  background: var(--bg-main);\n  border-radius: 4px;\n}\n\n.heatmap-card canvas {\n  width: 100%;\n  height: auto;\n  background: var(--bg-main);\n  border-radius: 4px;\n}\n\n.statistics-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 15px;\n}\n\n.stat-item {\n  text-align: center;\n  padding: 15px;\n  background: var(--bg-main);\n  border-radius: 4px;\n}\n\n.stat-label {\n  display: block;\n  color: var(--text-muted);\n  font-size: 0.9em;\n  margin-bottom: 5px;\n}\n\n.stat-value {\n  display: block;\n  color: var(--text);\n  font-size: 1.3em;\n  font-weight: 600;\n}\n\n.export-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.loading-content {\n  background: var(--bg-card);\n  padding: 30px;\n  border-radius: 8px;\n  text-align: center;\n  color: var(--text);\n}\n\n.loading-spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 15px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.correlation-row {\n  cursor: pointer;\n}\n\n.correlation-row:hover {\n  background: var(--bg-main);\n}\n\n.correlation-row.selected {\n  background: rgba(74, 144, 226, 0.1);\n}\n\n@media (max-width: 768px) {\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .chart-container {\n    grid-template-columns: 1fr;\n  }\n  \n  .statistics-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}