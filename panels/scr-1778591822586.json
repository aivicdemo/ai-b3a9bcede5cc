{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因との相関関係を分析し、需要予測の精度向上に活用</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h2>分析条件設定</h2>\n    \n    <div class=\"condition-row\">\n      <div class=\"condition-group\">\n        <label>分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" required>\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" required>\n        </div>\n      </div>\n      \n      <div class=\"condition-group\">\n        <label>店舗選択</label>\n        <select id=\"store-select\" class=\"input\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"condition-row\">\n      <div class=\"condition-group\">\n        <label>商品カテゴリ選択</label>\n        <div class=\"checkbox-group\" id=\"category-checkboxes\">\n          <label><input type=\"checkbox\" value=\"all\" id=\"select-all-categories\"> 全て選択</label>\n        </div>\n      </div>\n      \n      <div class=\"condition-group\">\n        <label>分析要因選択</label>\n        <div class=\"checkbox-group\" id=\"factor-checkboxes\">\n          <label><input type=\"checkbox\" value=\"weather\"> 天候</label>\n          <label><input type=\"checkbox\" value=\"event\"> イベント</label>\n          <label><input type=\"checkbox\" value=\"season\"> 季節</label>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"condition-row\">\n      <div class=\"condition-group\">\n        <label>比較対象商品選択</label>\n        <select id=\"comparison-products\" class=\"input\" multiple size=\"4\">\n        </select>\n      </div>\n    </div>\n\n    <div class=\"analysis-actions\">\n      <button id=\"btn-execute-analysis\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-reset-conditions\" class=\"action-btn secondary\">条件リセット</button>\n    </div>\n  </div>\n\n  <!-- 分析結果エリア -->\n  <div class=\"card analysis-results\" id=\"analysis-results\" style=\"display: none;\">\n    <h2>分析結果</h2>\n    \n    <!-- 分析結果サマリー -->\n    <div class=\"result-summary\" id=\"result-summary\">\n      <div class=\"summary-item\">\n        <span class=\"label\">分析対象期間:</span>\n        <span id=\"summary-period\">-</span>\n      </div>\n      <div class=\"summary-item\">\n        <span class=\"label\">対象店舗:</span>\n        <span id=\"summary-store\">-</span>\n      </div>\n      <div class=\"summary-item\">\n        <span class=\"label\">分析データ件数:</span>\n        <span id=\"summary-count\">-</span>\n      </div>\n      <div class=\"summary-item\">\n        <span class=\"label\">最高相関係数:</span>\n        <span id=\"summary-max-correlation\">-</span>\n      </div>\n    </div>\n\n    <!-- タブナビゲーション -->\n    <div class=\"result-tabs\">\n      <button class=\"tab-btn active\" data-tab=\"correlation\">相関係数表</button>\n      <button class=\"tab-btn\" data-tab=\"scatter\">散布図</button>\n      <button class=\"tab-btn\" data-tab=\"timeseries\">時系列比較</button>\n      <button class=\"tab-btn\" data-tab=\"heatmap\">ヒートマップ</button>\n      <button class=\"tab-btn\" data-tab=\"statistics\">統計値</button>\n    </div>\n\n    <!-- 相関係数表 -->\n    <div class=\"tab-content active\" id=\"tab-correlation\">\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性レベル</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- 散布図 -->\n    <div class=\"tab-content\" id=\"tab-scatter\">\n      <div class=\"chart-container\">\n        <canvas id=\"scatter-chart\" width=\"800\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- 時系列比較チャート -->\n    <div class=\"tab-content\" id=\"tab-timeseries\">\n      <div class=\"chart-container\">\n        <canvas id=\"timeseries-chart\" width=\"800\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- ヒートマップ -->\n    <div class=\"tab-content\" id=\"tab-heatmap\">\n      <div class=\"chart-container\">\n        <canvas id=\"heatmap-chart\" width=\"800\" height=\"400\"></canvas>\n        <div class=\"heatmap-legend\">\n          <span>弱い相関</span>\n          <div class=\"legend-gradient\"></div>\n          <span>強い相関</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 統計値 -->\n    <div class=\"tab-content\" id=\"tab-statistics\">\n      <div class=\"statistics-grid\">\n        <div class=\"stat-item\">\n          <h4>平均値</h4>\n          <div id=\"stat-mean\">-</div>\n        </div>\n        <div class=\"stat-item\">\n          <h4>標準偏差</h4>\n          <div id=\"stat-stddev\">-</div>\n        </div>\n        <div class=\"stat-item\">\n          <h4>最大値</h4>\n          <div id=\"stat-max\">-</div>\n        </div>\n        <div class=\"stat-item\">\n          <h4>最小値</h4>\n          <div id=\"stat-min\">-</div>\n        </div>\n        <div class=\"stat-item\">\n          <h4>中央値</h4>\n          <div id=\"stat-median\">-</div>\n        </div>\n        <div class=\"stat-item\">\n          <h4>分散</h4>\n          <div id=\"stat-variance\">-</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- エクスポートボタン -->\n    <div class=\"export-actions\">\n      <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n      <button id=\"btn-export-chart\" class=\"action-btn secondary\">グラフ出力</button>\n    </div>\n  </div>\n\n  <!-- エラー表示エリア -->\n  <div class=\"error-message\" id=\"error-message\" style=\"display: none;\">\n    <div class=\"error-content\">\n      <h3>エラーが発生しました</h3>\n      <p id=\"error-text\"></p>\n      <button id=\"btn-close-error\" class=\"action-btn secondary\">閉じる</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n  min-height: 100vh;\n}\n\n.screen-header {\n  margin-bottom: 30px;\n}\n\n.screen-header h1 {\n  margin: 0 0 10px 0;\n  color: var(--text);\n  font-size: 28px;\n}\n\n.analysis-conditions {\n  margin-bottom: 30px;\n}\n\n.condition-row {\n  display: flex;\n  gap: 30px;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n}\n\n.condition-group {\n  flex: 1;\n  min-width: 250px;\n}\n\n.condition-group label {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.checkbox-group {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.checkbox-group label {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  font-weight: normal;\n  margin-bottom: 0;\n}\n\n.analysis-actions {\n  text-align: center;\n  margin-top: 30px;\n}\n\n.analysis-actions button {\n  margin: 0 10px;\n}\n\n.analysis-results {\n  margin-bottom: 30px;\n}\n\n.result-summary {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 30px;\n  margin-bottom: 20px;\n  padding: 15px;\n  background: var(--bg-sidebar);\n  border-radius: 5px;\n}\n\n.summary-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.summary-item .label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.result-tabs {\n  display: flex;\n  border-bottom: 2px solid var(--border);\n  margin-bottom: 20px;\n}\n\n.tab-btn {\n  padding: 10px 20px;\n  border: none;\n  background: transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.3s;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.tab-content {\n  display: none;\n}\n\n.tab-content.active {\n  display: block;\n}\n\n.chart-container {\n  text-align: center;\n  padding: 20px;\n  background: var(--bg-sidebar);\n  border-radius: 5px;\n}\n\n.heatmap-legend {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  margin-top: 15px;\n}\n\n.legend-gradient {\n  width: 200px;\n  height: 20px;\n  background: linear-gradient(to right, #3b82f6, #ef4444);\n  border-radius: 10px;\n}\n\n.statistics-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n}\n\n.stat-item {\n  padding: 15px;\n  background: var(--bg-sidebar);\n  border-radius: 5px;\n  text-align: center;\n}\n\n.stat-item h4 {\n  margin: 0 0 10px 0;\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.stat-item div {\n  font-size: 24px;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.export-actions {\n  text-align: center;\n  margin-top: 30px;\n}\n\n.export-actions button {\n  margin: 0 10px;\n}\n\n.error-message {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.8);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.error-content {\n  background: var(--bg-card);\n  padding: 30px;\n  border-radius: 10px;\n  text-align: center;\n  max-width: 500px;\n  width: 90%;\n}\n\n.error-content h3 {\n  color: #ef4444;\n  margin: 0 0 15px 0;\n}\n\n.error-content p {\n  margin: 0 0 20px 0;\n  color: var(--text);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}