  "screenName": "相関分析・比較分析",
  "html": "<div class=\"analysis-header\">\n  <h2>相関分析・比較分析</h2>\n  <p class=\"muted\">売上実績と外部要因の相関関係を分析し、需要予測の精度向上に活用します</p>\n</div>\n\n<div class=\"analysis-controls card\">\n  <div class=\"control-row\">\n    <div class=\"control-group\">\n      <label>分析対象期間</label>\n      <div class=\"date-range\">\n        <input type=\"date\" id=\"start-date\" class=\"input\" />\n        <span>〜</span>\n        <input type=\"date\" id=\"end-date\" class=\"input\" />\n      </div>\n    </div>\n    \n    <div class=\"control-group\">\n      <label>店舗選択</label>\n      <select id=\"store-select\" class=\"input\">\n        <option value=\"\">店舗を選択してください</option>\n      </select>\n    </div>\n  </div>\n\n  <div class=\"control-row\">\n    <div class=\"control-group\">\n      <label>商品カテゴリ</label>\n      <div class=\"category-checkboxes\">\n        <label><input type=\"checkbox\" id=\"category-all\" /> 全選択</label>\n        <div id=\"category-list\"></div>\n      </div>\n    </div>\n    \n    <div class=\"control-group\">\n      <label>分析要因</label>\n      <div class=\"factor-checkboxes\">\n        <label><input type=\"checkbox\" id=\"factor-weather\" value=\"weather\" /> 天候</label>\n        <label><input type=\"checkbox\" id=\"factor-event\" value=\"event\" /> イベント</label>\n        <label><input type=\"checkbox\" id=\"factor-season\" value=\"season\" /> 季節</label>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"control-row\">\n    <div class=\"control-group\">\n      <label>比較対象商品</label>\n      <select id=\"compare-product\" class=\"input\" multiple>\n        <option value=\"\">商品を選択してください</option>\n      </select>\n    </div>\n    \n    <div class=\"control-group\">\n      <button id=\"btn-analyze\" class=\"action-btn\">分析実行</button>\n    </div>\n  </div>\n</div>\n\n<div id=\"analysis-results\" class=\"analysis-results hidden\">\n  <div class=\"results-header\">\n    <h3>分析結果</h3>\n    <div class=\"view-controls\">\n      <button id=\"btn-correlation-table\" class=\"action-btn secondary active\">相関係数表</button>\n      <button id=\"btn-scatter-plot\" class=\"action-btn secondary\">散布図</button>\n      <button id=\"btn-time-series\" class=\"action-btn secondary\">時系列チャート</button>\n      <button id=\"btn-heatmap\" class=\"action-btn secondary\">ヒートマップ</button>\n    </div>\n  </div>\n\n  <div class=\"results-content\">\n    <div id=\"correlation-table-view\" class=\"result-view\">\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性</th>\n              <th>サンプル数</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div id=\"scatter-plot-view\" class=\"result-view hidden\">\n      <canvas id=\"scatter-canvas\" width=\"800\" height=\"400\"></canvas>\n    </div>\n\n    <div id=\"time-series-view\" class=\"result-view hidden\">\n      <canvas id=\"timeseries-canvas\" width=\"800\" height=\"400\"></canvas>\n    </div>\n\n    <div id=\"heatmap-view\" class=\"result-view hidden\">\n      <canvas id=\"heatmap-canvas\" width=\"600\" height=\"400\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"statistics-summary card\">\n    <h4>統計値サマリー</h4>\n    <div class=\"stats-grid\">\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">平均売上</span>\n        <span id=\"stat-avg-sales\" class=\"stat-value\">-</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">標準偏差</span>\n        <span id=\"stat-std-dev\" class=\"stat-value\">-</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">最大相関係数</span>\n        <span id=\"stat-max-correlation\" class=\"stat-value\">-</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">分析期間</span>\n        <span id=\"stat-period\" class=\"stat-value\">-</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.analysis-header {\n  margin-bottom: 24px;\n}\n\n.analysis-controls {\n  margin-bottom: 24px;\n  padding: 20px;\n}\n\n.control-row {\n  display: flex;\n  gap: 20px;\n  margin-bottom: 16px;\n  align-items: flex-end;\n}\n\n.control-group {\n  flex: 1;\n}\n\n.control-group label {\n  display: block;\n  margin-bottom: 8px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.category-checkboxes label, .factor-checkboxes label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  margin-bottom: 0;\n  font-weight: normal;\n}\n\n#category-list {\n  margin-top: 8px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.analysis-results {\n  margin-top: 24px;\n}\n\n.results-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n}\n\n.view-controls {\n  display: flex;\n  gap: 8px;\n}\n\n.view-controls .action-btn.active {\n  background: var(--primary);\n  color: white;\n}\n\n.result-view {\n  background: var(--bg-card);\n  border-radius: 8px;\n  padding: 16px;\n  margin-bottom: 16px;\n}\n\n.result-view canvas {\n  width: 100%;\n  height: auto;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n}\n\n.statistics-summary {\n  padding: 16px;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  margin-top: 12px;\n}\n\n.stat-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 12px;\n  background: var(--bg-main);\n  border-radius: 4px;\n}\n\n.stat-label {\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.stat-value {\n  color: var(--text);\n  font-weight: 600;\n}\n\n#correlation-table tbody tr:hover {\n  background: var(--bg-main);\n  cursor: pointer;\n}\n\n.correlation-cell {\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.correlation-cell:hover {\n  background: var(--bg-main);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}