{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"analysis-header\" style=\"background: var(--bg-card); padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--border);\">\n  <h2 style=\"color: var(--text); margin: 0 0 20px 0;\">相関分析・比較分析</h2>\n  \n  <div class=\"analysis-controls\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;\">\n    <!-- 分析対象期間選択 -->\n    <div class=\"control-group\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 8px; font-weight: 500;\">分析対象期間</label>\n      <div style=\"display: flex; gap: 10px; align-items: center;\">\n        <input type=\"date\" id=\"start-date\" class=\"input\" style=\"flex: 1;\" />\n        <span style=\"color: var(--text-muted);\">〜</span>\n        <input type=\"date\" id=\"end-date\" class=\"input\" style=\"flex: 1;\" />\n      </div>\n    </div>\n\n    <!-- 店舗選択 -->\n    <div class=\"control-group\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 8px; font-weight: 500;\">対象店舗</label>\n      <select id=\"store-select\" class=\"input\" multiple style=\"height: 80px;\">\n        <option value=\"\">店舗を選択してください</option>\n      </select>\n    </div>\n\n    <!-- 商品カテゴリ選択 -->\n    <div class=\"control-group\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 8px; font-weight: 500;\">商品カテゴリ</label>\n      <div id=\"category-checkboxes\" style=\"max-height: 80px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px; padding: 8px; background: var(--bg-main);\">\n        <label style=\"display: block; color: var(--text); margin-bottom: 4px;\">\n          <input type=\"checkbox\" id=\"select-all-categories\" style=\"margin-right: 8px;\" />\n          全選択\n        </label>\n      </div>\n    </div>\n\n    <!-- 分析要因選択 -->\n    <div class=\"control-group\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 8px; font-weight: 500;\">分析要因</label>\n      <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n        <label style=\"color: var(--text);\">\n          <input type=\"checkbox\" id=\"factor-weather\" value=\"weather\" style=\"margin-right: 8px;\" />\n          天候要因\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"checkbox\" id=\"factor-event\" value=\"event\" style=\"margin-right: 8px;\" />\n          イベント要因\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"checkbox\" id=\"factor-season\" value=\"season\" style=\"margin-right: 8px;\" />\n          季節要因\n        </label>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"margin-top: 20px; text-align: center;\">\n    <button id=\"btn-analyze\" class=\"action-btn\" style=\"padding: 12px 30px; font-size: 16px;\">分析実行</button>\n  </div>\n</div>\n\n<!-- 分析結果表示エリア -->\n<div id=\"analysis-results\" class=\"hidden\" style=\"margin-top: 20px;\">\n  <!-- 相関係数表示テーブル -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">相関係数マトリックス</h3>\n    <div class=\"table-wrap\">\n      <table id=\"correlation-table\">\n        <thead>\n          <tr>\n            <th>要因</th>\n            <th>売上数量</th>\n            <th>売上金額</th>\n            <th>気温</th>\n            <th>降水量</th>\n            <th>イベント影響度</th>\n          </tr>\n        </thead>\n        <tbody id=\"correlation-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- グラフエリア -->\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n    <!-- 散布図 -->\n    <div class=\"card\">\n      <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">散布図</h3>\n      <canvas id=\"scatter-chart\" width=\"400\" height=\"300\" style=\"width: 100%; max-width: 400px; border: 1px solid var(--border);\"></canvas>\n    </div>\n\n    <!-- 相関強度ヒートマップ -->\n    <div class=\"card\">\n      <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">相関強度ヒートマップ</h3>\n      <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\" style=\"width: 100%; max-width: 400px; border: 1px solid var(--border);\"></canvas>\n    </div>\n  </div>\n\n  <!-- 時系列比較チャート -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">時系列比較チャート</h3>\n    <canvas id=\"timeseries-chart\" width=\"800\" height=\"400\" style=\"width: 100%; max-width: 800px; border: 1px solid var(--border);\"></canvas>\n  </div>\n\n  <!-- 統計値表示エリア -->\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px;\">\n    <!-- 分析結果サマリー -->\n    <div class=\"card\">\n      <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">分析結果サマリー</h3>\n      <div id=\"analysis-summary\" style=\"color: var(--text);\">\n        <div class=\"summary-item\" style=\"margin-bottom: 10px;\">\n          <span style=\"font-weight: 500;\">分析期間:</span>\n          <span id=\"summary-period\" style=\"color: var(--text-muted);\"></span>\n        </div>\n        <div class=\"summary-item\" style=\"margin-bottom: 10px;\">\n          <span style=\"font-weight: 500;\">対象店舗数:</span>\n          <span id=\"summary-stores\" style=\"color: var(--text-muted);\"></span>\n        </div>\n        <div class=\"summary-item\" style=\"margin-bottom: 10px;\">\n          <span style=\"font-weight: 500;\">対象商品数:</span>\n          <span id=\"summary-products\" style=\"color: var(--text-muted);\"></span>\n        </div>\n        <div class=\"summary-item\" style=\"margin-bottom: 10px;\">\n          <span style=\"font-weight: 500;\">最強相関要因:</span>\n          <span id=\"summary-strongest\" style=\"color: var(--primary);\"></span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 統計値 -->\n    <div class=\"card\">\n      <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">統計値</h3>\n      <div id=\"statistics-display\" style=\"color: var(--text);\">\n        <div class=\"stat-item\" style=\"display: flex; justify-content: space-between; margin-bottom: 8px;\">\n          <span>平均売上数量:</span>\n          <span id=\"stat-avg-quantity\" style=\"color: var(--text-muted);\">-</span>\n        </div>\n        <div class=\"stat-item\" style=\"display: flex; justify-content: space-between; margin-bottom: 8px;\">\n          <span>標準偏差:</span>\n          <span id=\"stat-std-dev\" style=\"color: var(--text-muted);\">-</span>\n        </div>\n        <div class=\"stat-item\" style=\"display: flex; justify-content: space-between; margin-bottom: 8px;\">\n          <span>最大値:</span>\n          <span id=\"stat-max\" style=\"color: var(--text-muted);\">-</span>\n        </div>\n        <div class=\"stat-item\" style=\"display: flex; justify-content: space-between; margin-bottom: 8px;\">\n          <span>最小値:</span>\n          <span id=\"stat-min\" style=\"color: var(--text-muted);\">-</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- エラーメッセージ表示エリア -->\n<div id=\"error-message\" class=\"hidden\" style=\"background: rgba(255, 107, 107, 0.1); border: 1px solid #ff6b6b; border-radius: 4px; padding: 15px; margin-top: 20px; color: var(--text);\">\n  <span id=\"error-text\"></span>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}