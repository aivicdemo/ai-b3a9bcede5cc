{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2>相関分析・比較分析</h2>\n  <p class=\"muted\">売上実績と天候・イベント・季節などの外部要因との相関関係を分析し、需要予測の精度向上に活用します。</p>\n</div>\n\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h3>分析条件設定</h3>\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 20px;\">\n    <div>\n      <label for=\"start-date\">分析対象期間（開始日）</label>\n      <input type=\"date\" id=\"start-date\" class=\"input\" required>\n    </div>\n    <div>\n      <label for=\"end-date\">分析対象期間（終了日）</label>\n      <input type=\"date\" id=\"end-date\" class=\"input\" required>\n    </div>\n    <div>\n      <label for=\"store-select\">店舗選択</label>\n      <select id=\"store-select\" class=\"input\" required>\n        <option value=\"\">店舗を選択してください</option>\n      </select>\n    </div>\n  </div>\n\n  <div style=\"margin-bottom: 20px;\">\n    <label>商品カテゴリ選択</label>\n    <div id=\"category-checkboxes\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;\">\n      <!-- 商品カテゴリのチェックボックスが動的に生成される -->\n    </div>\n  </div>\n\n  <div style=\"margin-bottom: 20px;\">\n    <label>分析要因選択</label>\n    <div style=\"display: flex; gap: 20px; margin-top: 10px;\">\n      <label><input type=\"checkbox\" id=\"weather-factor\" value=\"weather\"> 天候要因</label>\n      <label><input type=\"checkbox\" id=\"event-factor\" value=\"event\"> イベント要因</label>\n      <label><input type=\"checkbox\" id=\"season-factor\" value=\"season\"> 季節要因</label>\n    </div>\n  </div>\n\n  <div style=\"margin-bottom: 20px;\">\n    <label for=\"comparison-products\">比較対象商品選択</label>\n    <select id=\"comparison-products\" class=\"input\" multiple style=\"height: 120px;\">\n      <!-- 商品リストが動的に生成される -->\n    </select>\n    <small class=\"muted\">Ctrlキーを押しながらクリックで複数選択可能</small>\n  </div>\n\n  <div style=\"text-align: center;\">\n    <button id=\"btn-analyze\" class=\"action-btn\">分析実行</button>\n    <button id=\"btn-clear\" class=\"action-btn secondary\">条件クリア</button>\n  </div>\n</div>\n\n<div id=\"analysis-results\" class=\"hidden\">\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3>分析結果サマリー</h3>\n    <div id=\"summary-panel\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;\">\n      <div style=\"text-align: center; padding: 15px; background: var(--bg-main); border-radius: 5px;\">\n        <div style=\"font-size: 24px; font-weight: bold; color: var(--primary);\" id=\"total-correlations\">0</div>\n        <div class=\"muted\">分析対象相関数</div>\n      </div>\n      <div style=\"text-align: center; padding: 15px; background: var(--bg-main); border-radius: 5px;\">\n        <div style=\"font-size: 24px; font-weight: bold; color: var(--primary);\" id=\"strong-correlations\">0</div>\n        <div class=\"muted\">強い相関関係</div>\n      </div>\n      <div style=\"text-align: center; padding: 15px; background: var(--bg-main); border-radius: 5px;\">\n        <div style=\"font-size: 24px; font-weight: bold; color: var(--primary);\" id=\"sample-count\">0</div>\n        <div class=\"muted\">サンプル数</div>\n      </div>\n      <div style=\"text-align: center; padding: 15px; background: var(--bg-main); border-radius: 5px;\">\n        <div style=\"font-size: 24px; font-weight: bold; color: var(--primary);\" id=\"analysis-date\">-</div>\n        <div class=\"muted\">分析実行日時</div>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n    <div class=\"card\">\n      <h3>相関係数表</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因1</th>\n              <th>要因2</th>\n              <th>相関係数</th>\n              <th>有意性</th>\n            </tr>\n          </thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h3>統計値</h3>\n      <div class=\"table-wrap\">\n        <table id=\"statistics-table\">\n          <thead>\n            <tr>\n              <th>項目</th>\n              <th>平均値</th>\n              <th>標準偏差</th>\n              <th>最大値</th>\n              <th>最小値</th>\n            </tr>\n          </thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n    <div class=\"card\">\n      <h3>散布図</h3>\n      <canvas id=\"scatter-chart\" width=\"400\" height=\"300\" style=\"width: 100%; max-width: 400px; border: 1px solid var(--border);\"></canvas>\n    </div>\n\n    <div class=\"card\">\n      <h3>相関強度ヒートマップ</h3>\n      <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\" style=\"width: 100%; max-width: 400px; border: 1px solid var(--border);\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h3>時系列比較チャート</h3>\n    <canvas id=\"timeseries-chart\" width=\"800\" height=\"400\" style=\"width: 100%; max-width: 800px; border: 1px solid var(--border);\"></canvas>\n  </div>\n\n  <div style=\"text-align: center; margin-top: 20px;\">\n    <button id=\"btn-export-csv\" class=\"action-btn secondary\">結果をCSVエクスポート</button>\n    <button id=\"btn-export-pdf\" class=\"action-btn secondary\">結果をPDFエクスポート</button>\n  </div>\n</div>\n\n<div id=\"error-message\" class=\"hidden\" style=\"background: rgba(255, 0, 0, 0.1); border: 1px solid #ff4444; padding: 15px; border-radius: 5px; margin-top: 20px;\">\n  <strong style=\"color: #ff4444;\">エラー</strong>\n  <div id=\"error-text\" style=\"color: var(--text); margin-top: 5px;\"></div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}