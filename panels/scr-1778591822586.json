{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>相関分析・比較分析</h2>\n    <p class=\"muted\">売上実績と外部要因との相関関係を分析し、需要予測の精度向上に活用</p>\n  </div>\n\n  <div class=\"analysis-controls\">\n    <div class=\"control-row\">\n      <div class=\"control-group\">\n        <label>分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n      \n      <div class=\"control-group\">\n        <label>店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"control-row\">\n      <div class=\"control-group\">\n        <label>商品カテゴリ</label>\n        <div class=\"category-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"select-all-categories\"> 全選択\n          </label>\n          <div id=\"category-list\"></div>\n        </div>\n      </div>\n\n      <div class=\"control-group\">\n        <label>分析要因</label>\n        <div class=\"factor-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" value=\"weather\" class=\"factor-checkbox\"> 天候\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" value=\"event\" class=\"factor-checkbox\"> イベント\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" value=\"season\" class=\"factor-checkbox\"> 季節\n          </label>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"control-row\">\n      <div class=\"control-group\">\n        <label>比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n        </select>\n      </div>\n      \n      <div class=\"control-group\">\n        <label>分析タイプ</label>\n        <select id=\"analysis-type\" class=\"input\">\n          <option value=\"correlation\">相関分析</option>\n          <option value=\"comparison\">比較分析</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"action-buttons\">\n      <button id=\"btn-execute\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-export\" class=\"action-btn secondary\">結果エクスポート</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"analysis-results\" id=\"results-container\" style=\"display: none;\">\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3>分析結果サマリー</h3>\n    </div>\n    <div id=\"summary-panel\" class=\"summary-stats\">\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">分析期間:</span>\n        <span id=\"summary-period\" class=\"stat-value\">-</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">対象店舗:</span>\n        <span id=\"summary-store\" class=\"stat-value\">-</span>\n      </div>\n      <div class=\"stat-item\">\n        <span class=\"stat-label\">サンプル数:</span>\n        <span id=\"summary-samples\" class=\"stat-value\">-</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"results-grid\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>相関係数表</h3>\n      </div>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>統計値</h3>\n      </div>\n      <div id=\"statistics-panel\" class=\"stats-grid\">\n        <div class=\"stat-box\">\n          <div class=\"stat-title\">平均売上</div>\n          <div id=\"avg-sales\" class=\"stat-number\">-</div>\n        </div>\n        <div class=\"stat-box\">\n          <div class=\"stat-title\">標準偏差</div>\n          <div id=\"std-deviation\" class=\"stat-number\">-</div>\n        </div>\n        <div class=\"stat-box\">\n          <div class=\"stat-title\">最大値</div>\n          <div id=\"max-value\" class=\"stat-number\">-</div>\n        </div>\n        <div class=\"stat-box\">\n          <div class=\"stat-title\">最小値</div>\n          <div id=\"min-value\" class=\"stat-number\">-</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"charts-grid\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>散布図</h3>\n      </div>\n      <canvas id=\"scatter-chart\" width=\"400\" height=\"300\"></canvas>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>相関強度ヒートマップ</h3>\n      </div>\n      <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\"></canvas>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>時系列比較チャート</h3>\n      </div>\n      <canvas id=\"timeseries-chart\" width=\"800\" height=\"300\"></canvas>\n    </div>\n  </div>\n</div>\n\n<style>\n.analysis-controls {\n  background: var(--bg-card);\n  padding: 20px;\n  border-radius: 8px;\n  margin-bottom: 20px;\n}\n\n.control-row {\n  display: flex;\n  gap: 20px;\n  margin-bottom: 15px;\n  flex-wrap: wrap;\n}\n\n.control-group {\n  flex: 1;\n  min-width: 200px;\n}\n\n.control-group label {\n  display: block;\n  margin-bottom: 5px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.checkbox-item {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  cursor: pointer;\n  font-size: 14px;\n}\n\n.checkbox-item input[type=\"checkbox\"] {\n  margin: 0;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 10px;\n  margin-top: 20px;\n}\n\n.results-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.charts-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n\n.charts-grid .card:last-child {\n  grid-column: 1 / -1;\n}\n\n.summary-stats {\n  display: flex;\n  gap: 30px;\n  flex-wrap: wrap;\n  padding: 15px;\n}\n\n.stat-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.stat-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.stat-value {\n  font-weight: 600;\n  color: var(--text);\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 15px;\n  padding: 15px;\n}\n\n.stat-box {\n  text-align: center;\n  padding: 15px;\n  background: var(--bg-main);\n  border-radius: 6px;\n}\n\n.stat-title {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 5px;\n}\n\n.stat-number {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text);\n}\n\ncanvas {\n  width: 100%;\n  height: auto;\n  background: var(--bg-main);\n  border-radius: 6px;\n}\n\n.correlation-row {\n  cursor: pointer;\n}\n\n.correlation-row:hover {\n  background: var(--bg-main);\n}\n\n.error-message {\n  color: #ff6b6b;\n  font-size: 14px;\n  margin-top: 5px;\n  display: none;\n}\n\n@media (max-width: 768px) {\n  .control-row {\n    flex-direction: column;\n  }\n  \n  .results-grid, .charts-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .charts-grid .card:last-child {\n    grid-column: 1;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}