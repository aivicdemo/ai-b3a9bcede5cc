{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因の相関関係を分析し、需要予測の精度向上に活用します</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h2>分析条件設定</h2>\n    <div class=\"condition-grid\">\n      <!-- 分析対象期間 -->\n      <div class=\"condition-item\">\n        <label>分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" required>\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" required>\n        </div>\n      </div>\n\n      <!-- 店舗選択 -->\n      <div class=\"condition-item\">\n        <label>対象店舗</label>\n        <select id=\"store-select\" class=\"input\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n\n      <!-- 商品カテゴリ選択 -->\n      <div class=\"condition-item\">\n        <label>商品カテゴリ</label>\n        <div class=\"category-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"select-all-categories\"> 全選択\n          </label>\n          <div id=\"category-list\" class=\"category-grid\">\n            <!-- 動的に生成される -->\n          </div>\n        </div>\n      </div>\n\n      <!-- 分析要因選択 -->\n      <div class=\"condition-item\">\n        <label>分析要因</label>\n        <div class=\"factor-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-weather\" value=\"weather\"> 天候\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-event\" value=\"event\"> イベント\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-season\" value=\"season\"> 季節\n          </label>\n        </div>\n      </div>\n\n      <!-- 比較対象商品 -->\n      <div class=\"condition-item\">\n        <label>比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n          <!-- 動的に生成される -->\n        </select>\n      </div>\n    </div>\n\n    <div class=\"analysis-actions\">\n      <button id=\"btn-analyze\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-clear\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 分析結果エリア -->\n  <div id=\"analysis-results\" class=\"analysis-results hidden\">\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card\">\n      <h3>相関係数マトリックス</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr id=\"correlation-header\">\n              <!-- 動的に生成される -->\n            </tr>\n          </thead>\n          <tbody id=\"correlation-body\">\n            <!-- 動的に生成される -->\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- グラフエリア -->\n    <div class=\"charts-container\">\n      <!-- 散布図 -->\n      <div class=\"card chart-card\">\n        <h3>散布図</h3>\n        <canvas id=\"scatter-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 時系列比較チャート -->\n      <div class=\"card chart-card\">\n        <h3>時系列比較チャート</h3>\n        <canvas id=\"timeseries-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 相関強度ヒートマップ -->\n      <div class=\"card chart-card\">\n        <h3>相関強度ヒートマップ</h3>\n        <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n    </div>\n\n    <!-- 統計値表示エリア -->\n    <div class=\"card\">\n      <h3>統計値サマリー</h3>\n      <div class=\"stats-grid\">\n        <div class=\"stat-item\">\n          <label>平均値</label>\n          <span id=\"stat-mean\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>標準偏差</label>\n          <span id=\"stat-stddev\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最大相関係数</label>\n          <span id=\"stat-max-correlation\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最小相関係数</label>\n          <span id=\"stat-min-correlation\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>サンプル数</label>\n          <span id=\"stat-sample-count\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>有意性レベル</label>\n          <span id=\"stat-significance\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 分析結果サマリー -->\n    <div class=\"card\">\n      <h3>分析結果サマリー</h3>\n      <div id=\"analysis-summary\" class=\"summary-content\">\n        <!-- 動的に生成される -->\n      </div>\n    </div>\n\n    <!-- エクスポートボタン -->\n    <div class=\"export-actions\">\n      <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n      <button id=\"btn-export-report\" class=\"action-btn secondary\">レポート出力</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n}\n\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.screen-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.condition-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.condition-item label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 8px;\n  font-weight: 500;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.checkbox-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.category-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 8px;\n  margin-top: 8px;\n}\n\n.analysis-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n.analysis-results {\n  margin-top: 30px;\n}\n\n.charts-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.chart-card {\n  text-align: center;\n}\n\n.chart-card canvas {\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: var(--bg-main);\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n}\n\n.stat-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 12px;\n  background: var(--bg-main);\n  border-radius: 4px;\n  border: 1px solid var(--border);\n}\n\n.stat-item label {\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.stat-item span {\n  color: var(--text);\n  font-weight: 500;\n}\n\n.summary-content {\n  padding: 16px;\n  background: var(--bg-main);\n  border-radius: 4px;\n  border: 1px solid var(--border);\n  color: var(--text);\n  line-height: 1.6;\n}\n\n.export-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n#correlation-table {\n  min-width: 100%;\n}\n\n#correlation-table th, #correlation-table td {\n  text-align: center;\n  padding: 8px 12px;\n}\n\n#correlation-table th {\n  background: var(--bg-main);\n  color: var(--text);\n  font-weight: 500;\n}\n\n#correlation-table td {\n  color: var(--text);\n}\n\n.correlation-cell {\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.correlation-cell:hover {\n  background: var(--bg-main);\n}\n\n.correlation-strong {\n  background: rgba(34, 197, 94, 0.1);\n  color: #22c55e;\n  font-weight: 600;\n}\n\n.correlation-moderate {\n  background: rgba(251, 191, 36, 0.1);\n  color: #fbbf24;\n  font-weight: 500;\n}\n\n.correlation-weak {\n  background: rgba(239, 68, 68, 0.1);\n  color: #ef4444;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}