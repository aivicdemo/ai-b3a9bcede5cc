{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h2>相関分析・比較分析</h2>\n    <p class=\"muted\">売上実績と外部要因の相関関係を分析し、需要予測の精度向上に活用します</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h3>分析条件設定</h3>\n    <div class=\"condition-grid\">\n      <!-- 分析対象期間 -->\n      <div class=\"condition-item\">\n        <label>分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n\n      <!-- 店舗選択 -->\n      <div class=\"condition-item\">\n        <label>店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n\n      <!-- 商品カテゴリ選択 -->\n      <div class=\"condition-item\">\n        <label>商品カテゴリ</label>\n        <div class=\"category-checkboxes\" id=\"category-checkboxes\">\n          <label><input type=\"checkbox\" id=\"select-all-categories\"> 全て選択</label>\n        </div>\n      </div>\n\n      <!-- 分析要因選択 -->\n      <div class=\"condition-item\">\n        <label>分析要因</label>\n        <div class=\"factor-checkboxes\">\n          <label><input type=\"checkbox\" id=\"factor-weather\" value=\"weather\"> 天候</label>\n          <label><input type=\"checkbox\" id=\"factor-event\" value=\"event\"> イベント</label>\n          <label><input type=\"checkbox\" id=\"factor-season\" value=\"season\"> 季節</label>\n        </div>\n      </div>\n\n      <!-- 比較対象商品選択 -->\n      <div class=\"condition-item\">\n        <label>比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple size=\"4\">\n        </select>\n      </div>\n    </div>\n\n    <div class=\"analysis-actions\">\n      <button id=\"btn-analyze\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-clear\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div id=\"error-message\" class=\"error-message hidden\"></div>\n\n  <!-- 分析結果エリア -->\n  <div id=\"analysis-results\" class=\"analysis-results hidden\">\n    <!-- 分析結果サマリー -->\n    <div class=\"card result-summary\">\n      <h3>分析結果サマリー</h3>\n      <div class=\"summary-grid\" id=\"summary-content\">\n        <div class=\"summary-item\">\n          <span class=\"label\">分析対象期間:</span>\n          <span id=\"summary-period\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">対象データ件数:</span>\n          <span id=\"summary-count\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">最高相関係数:</span>\n          <span id=\"summary-max-correlation\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"label\">主要相関要因:</span>\n          <span id=\"summary-main-factor\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card correlation-table\">\n      <h3>相関係数表</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-matrix\">\n          <thead>\n            <tr id=\"correlation-header\">\n              <th>要因</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- 統計値表示エリア -->\n    <div class=\"card statistics-area\">\n      <h3>統計値</h3>\n      <div class=\"stats-grid\" id=\"statistics-content\">\n        <div class=\"stat-item\">\n          <span class=\"label\">平均値:</span>\n          <span id=\"stat-mean\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"label\">標準偏差:</span>\n          <span id=\"stat-stddev\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"label\">最大値:</span>\n          <span id=\"stat-max\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"label\">最小値:</span>\n          <span id=\"stat-min\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- グラフエリア -->\n    <div class=\"charts-container\">\n      <!-- 散布図 -->\n      <div class=\"card chart-card\">\n        <h3>散布図</h3>\n        <canvas id=\"scatter-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 時系列比較チャート -->\n      <div class=\"card chart-card\">\n        <h3>時系列比較チャート</h3>\n        <canvas id=\"timeseries-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 相関強度ヒートマップ -->\n      <div class=\"card chart-card\">\n        <h3>相関強度ヒートマップ</h3>\n        <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\"></canvas>\n        <div class=\"heatmap-legend\">\n          <span>弱い相関</span>\n          <div class=\"legend-bar\"></div>\n          <span>強い相関</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.screen-header h2 {\n  color: var(--text);\n  margin: 0 0 8px 0;\n  font-size: 24px;\n}\n\n.condition-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.condition-item label {\n  display: block;\n  color: var(--text);\n  font-weight: 500;\n  margin-bottom: 8px;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.category-checkboxes label, .factor-checkboxes label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: normal;\n  margin: 0;\n  cursor: pointer;\n}\n\n.analysis-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  padding-top: 20px;\n  border-top: 1px solid var(--border);\n}\n\n.error-message {\n  background: var(--bg-card);\n  border-left: 4px solid #ff4444;\n  padding: 12px 16px;\n  margin: 16px 0;\n  color: var(--text);\n  border-radius: 4px;\n}\n\n.analysis-results {\n  margin-top: 24px;\n}\n\n.summary-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n}\n\n.summary-item, .stat-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 8px 0;\n  border-bottom: 1px solid var(--border);\n}\n\n.summary-item .label, .stat-item .label {\n  color: var(--text-muted);\n  font-weight: 500;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 12px;\n}\n\n.charts-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.chart-card {\n  text-align: center;\n}\n\n.chart-card canvas {\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  max-width: 100%;\n}\n\n.heatmap-legend {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 12px;\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.legend-bar {\n  width: 100px;\n  height: 12px;\n  background: linear-gradient(to right, #4a90e2, #f39c12, #e74c3c);\n  border-radius: 6px;\n}\n\n#comparison-products {\n  min-height: 100px;\n}\n\n.correlation-table .table-wrap {\n  max-height: 400px;\n  overflow: auto;\n}\n\n.correlation-matrix td {\n  text-align: center;\n  font-family: monospace;\n}\n\n.correlation-strong {\n  background: rgba(231, 76, 60, 0.1);\n  color: var(--text);\n}\n\n.correlation-moderate {\n  background: rgba(243, 156, 18, 0.1);\n  color: var(--text);\n}\n\n.correlation-weak {\n  background: rgba(74, 144, 226, 0.1);\n  color: var(--text);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}