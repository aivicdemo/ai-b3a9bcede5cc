{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因との相関関係を分析し、需要予測の精度向上に活用</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h2>分析条件設定</h2>\n    <div class=\"condition-grid\">\n      <!-- 分析対象期間 -->\n      <div class=\"condition-item\">\n        <label for=\"start-date\">分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n\n      <!-- 店舗選択 -->\n      <div class=\"condition-item\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\" multiple>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n\n      <!-- 商品カテゴリ選択 -->\n      <div class=\"condition-item\">\n        <label>商品カテゴリ選択</label>\n        <div class=\"category-checkboxes\">\n          <label><input type=\"checkbox\" id=\"select-all-categories\"> 全選択</label>\n          <div id=\"category-list\" class=\"checkbox-list\"></div>\n        </div>\n      </div>\n\n      <!-- 分析要因選択 -->\n      <div class=\"condition-item\">\n        <label>分析要因選択</label>\n        <div class=\"factor-checkboxes\">\n          <label><input type=\"checkbox\" value=\"weather\" class=\"factor-checkbox\"> 天候</label>\n          <label><input type=\"checkbox\" value=\"event\" class=\"factor-checkbox\"> イベント</label>\n          <label><input type=\"checkbox\" value=\"season\" class=\"factor-checkbox\"> 季節</label>\n        </div>\n      </div>\n\n      <!-- 比較対象商品選択 -->\n      <div class=\"condition-item\">\n        <label for=\"comparison-products\">比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n          <option value=\"\">商品を選択してください</option>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"analysis-actions\">\n      <button id=\"btn-execute-analysis\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-clear-conditions\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 分析結果表示エリア -->\n  <div class=\"analysis-results hidden\" id=\"analysis-results\">\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card correlation-table-card\">\n      <h3>相関係数表</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性レベル</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- グラフエリア -->\n    <div class=\"chart-area\">\n      <!-- 散布図 -->\n      <div class=\"card chart-card\">\n        <h3>散布図</h3>\n        <div class=\"chart-controls\">\n          <select id=\"scatter-x-axis\" class=\"input\">\n            <option value=\"\">X軸を選択</option>\n          </select>\n          <select id=\"scatter-y-axis\" class=\"input\">\n            <option value=\"\">Y軸を選択</option>\n          </select>\n        </div>\n        <canvas id=\"scatter-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n\n      <!-- 時系列比較チャート -->\n      <div class=\"card chart-card\">\n        <h3>時系列比較チャート</h3>\n        <canvas id=\"timeseries-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n\n      <!-- 相関強度ヒートマップ -->\n      <div class=\"card chart-card\">\n        <h3>相関強度ヒートマップ</h3>\n        <canvas id=\"heatmap-chart\" width=\"600\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- 統計値表示エリア -->\n    <div class=\"card statistics-card\">\n      <h3>統計値サマリー</h3>\n      <div class=\"stats-grid\">\n        <div class=\"stat-item\">\n          <label>平均値</label>\n          <span id=\"stat-mean\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>標準偏差</label>\n          <span id=\"stat-stddev\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最大値</label>\n          <span id=\"stat-max\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最小値</label>\n          <span id=\"stat-min\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>サンプル数</label>\n          <span id=\"stat-count\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>分散</label>\n          <span id=\"stat-variance\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 分析結果サマリー -->\n    <div class=\"card summary-card\">\n      <h3>分析結果サマリー</h3>\n      <div id=\"analysis-summary\" class=\"summary-content\">\n        <p class=\"muted\">分析を実行すると結果が表示されます</p>\n      </div>\n    </div>\n\n    <!-- エクスポート機能 -->\n    <div class=\"export-actions\">\n      <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n      <button id=\"btn-export-report\" class=\"action-btn secondary\">レポート出力</button>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div id=\"error-message\" class=\"error-message hidden\"></div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.screen-header h1 {\n  margin: 0 0 8px 0;\n  font-size: 24px;\n  color: var(--text);\n}\n\n.condition-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.condition-item label {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.checkbox-list {\n  max-height: 120px;\n  overflow-y: auto;\n  border: 1px solid var(--border);\n  padding: 8px;\n  border-radius: 4px;\n  background: var(--bg-card);\n}\n\n.analysis-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n.chart-area {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.chart-card canvas {\n  width: 100%;\n  height: 300px;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: var(--bg-card);\n}\n\n.chart-controls {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 16px;\n}\n\n.stat-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.stat-item label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin: 0;\n}\n\n.stat-item span {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text);\n}\n\n.summary-content {\n  line-height: 1.6;\n}\n\n.export-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n.error-message {\n  background: rgba(255, 106, 0, 0.1);\n  border: 1px solid #ff6a00;\n  border-radius: 4px;\n  padding: 12px;\n  margin-top: 16px;\n  color: var(--text);\n}\n\n.hidden {\n  display: none;\n}\n\n#correlation-table tbody tr:hover {\n  background: rgba(255, 255, 255, 0.05);\n  cursor: pointer;\n}\n\nselect[multiple] {\n  min-height: 80px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}