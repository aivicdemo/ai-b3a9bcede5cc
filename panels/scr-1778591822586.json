{
  "screenId": "scr-1778591822586",
  "screenName": "相関分析・比較分析",
  "html": "<div class=\"correlation-analysis-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>相関分析・比較分析</h1>\n    <p class=\"muted\">売上実績と外部要因との相関関係を分析し、需要予測の精度向上に活用します</p>\n  </div>\n\n  <!-- 分析条件設定エリア -->\n  <div class=\"card analysis-conditions\">\n    <h2>分析条件設定</h2>\n    <div class=\"condition-grid\">\n      <!-- 分析対象期間 -->\n      <div class=\"condition-item\">\n        <label>分析対象期間</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" required>\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" required>\n        </div>\n      </div>\n\n      <!-- 店舗選択 -->\n      <div class=\"condition-item\">\n        <label>対象店舗</label>\n        <select id=\"store-select\" class=\"input\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n\n      <!-- 商品カテゴリ選択 -->\n      <div class=\"condition-item\">\n        <label>商品カテゴリ</label>\n        <div class=\"category-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"select-all-categories\"> 全選択\n          </label>\n          <div id=\"category-list\" class=\"category-options\">\n            <!-- 動的に生成 -->\n          </div>\n        </div>\n      </div>\n\n      <!-- 分析要因選択 -->\n      <div class=\"condition-item\">\n        <label>分析要因</label>\n        <div class=\"factor-checkboxes\">\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-weather\" value=\"weather\"> 天候\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-event\" value=\"event\"> イベント\n          </label>\n          <label class=\"checkbox-item\">\n            <input type=\"checkbox\" id=\"factor-season\" value=\"season\"> 季節\n          </label>\n        </div>\n      </div>\n\n      <!-- 比較対象商品 -->\n      <div class=\"condition-item\">\n        <label>比較対象商品</label>\n        <select id=\"comparison-products\" class=\"input\" multiple>\n          <!-- 動的に生成 -->\n        </select>\n      </div>\n    </div>\n\n    <div class=\"analysis-actions\">\n      <button id=\"btn-execute-analysis\" class=\"action-btn\">分析実行</button>\n      <button id=\"btn-clear-conditions\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 分析結果表示エリア -->\n  <div id=\"analysis-results\" class=\"analysis-results hidden\">\n    <!-- 相関係数表示テーブル -->\n    <div class=\"card\">\n      <h3>相関係数表</h3>\n      <div class=\"table-wrap\">\n        <table id=\"correlation-table\">\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>相関係数</th>\n              <th>有意性</th>\n              <th>サンプル数</th>\n              <th>評価</th>\n            </tr>\n          </thead>\n          <tbody id=\"correlation-tbody\">\n            <!-- 動的に生成 -->\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- グラフエリア -->\n    <div class=\"chart-container\">\n      <!-- 散布図 -->\n      <div class=\"card chart-card\">\n        <h3>散布図</h3>\n        <canvas id=\"scatter-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 時系列比較チャート -->\n      <div class=\"card chart-card\">\n        <h3>時系列比較チャート</h3>\n        <canvas id=\"timeseries-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n\n      <!-- 相関強度ヒートマップ -->\n      <div class=\"card chart-card\">\n        <h3>相関強度ヒートマップ</h3>\n        <canvas id=\"heatmap-chart\" width=\"400\" height=\"300\"></canvas>\n      </div>\n    </div>\n\n    <!-- 統計値表示エリア -->\n    <div class=\"card statistics-panel\">\n      <h3>統計値サマリー</h3>\n      <div class=\"stats-grid\">\n        <div class=\"stat-item\">\n          <label>平均値</label>\n          <span id=\"stat-mean\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>標準偏差</label>\n          <span id=\"stat-stddev\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最大値</label>\n          <span id=\"stat-max\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>最小値</label>\n          <span id=\"stat-min\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>中央値</label>\n          <span id=\"stat-median\">-</span>\n        </div>\n        <div class=\"stat-item\">\n          <label>データ数</label>\n          <span id=\"stat-count\">-</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 分析結果サマリー -->\n    <div class=\"card summary-panel\">\n      <h3>分析結果サマリー</h3>\n      <div id=\"analysis-summary\">\n        <!-- 動的に生成 -->\n      </div>\n    </div>\n\n    <!-- エクスポート機能 -->\n    <div class=\"export-actions\">\n      <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSV出力</button>\n      <button id=\"btn-export-report\" class=\"action-btn secondary\">レポート出力</button>\n    </div>\n  </div>\n\n  <!-- ローディング表示 -->\n  <div id=\"loading-overlay\" class=\"loading-overlay hidden\">\n    <div class=\"loading-content\">\n      <div class=\"loading-spinner\"></div>\n      <p>分析を実行中です...</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.correlation-analysis-screen {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.screen-header h1 {\n  margin: 0 0 8px 0;\n  font-size: 24px;\n  color: var(--text);\n}\n\n.analysis-conditions {\n  margin-bottom: 24px;\n}\n\n.condition-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.condition-item label {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.category-checkboxes, .factor-checkboxes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.checkbox-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: normal;\n  margin-bottom: 0;\n}\n\n.category-options {\n  margin-left: 20px;\n  margin-top: 8px;\n}\n\n.analysis-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n}\n\n.chart-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 20px;\n  margin-bottom: 24px;\n}\n\n.chart-card {\n  text-align: center;\n}\n\n.chart-card canvas {\n  max-width: 100%;\n  height: auto;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 16px;\n}\n\n.stat-item {\n  text-align: center;\n  padding: 12px;\n  background: var(--bg-main);\n  border-radius: 4px;\n  border: 1px solid var(--border);\n}\n\n.stat-item label {\n  display: block;\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.stat-item span {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text);\n}\n\n.export-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 20px;\n}\n\n.loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.loading-content {\n  background: var(--bg-card);\n  padding: 40px;\n  border-radius: 8px;\n  text-align: center;\n  color: var(--text);\n}\n\n.loading-spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 16px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n#correlation-table tbody tr:hover {\n  background: var(--bg-main);\n  cursor: pointer;\n}\n\n.summary-panel #analysis-summary {\n  line-height: 1.6;\n  color: var(--text);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}