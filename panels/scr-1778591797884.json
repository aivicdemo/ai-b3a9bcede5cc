{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>売上実績データ管理</h2>\n    <div class=\"header-actions\">\n      <button class=\"action-btn\" id=\"btn-new\">新規登録</button>\n      <button class=\"action-btn secondary\" id=\"btn-import\">一括インポート</button>\n      <button class=\"action-btn secondary\" id=\"btn-export\">CSVエクスポート</button>\n    </div>\n  </div>\n\n  <div class=\"search-area\">\n    <div class=\"search-row\">\n      <div class=\"search-group\">\n        <label>店舗</label>\n        <select class=\"input\" id=\"select-store\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"search-group\">\n        <label>商品</label>\n        <select class=\"input\" id=\"select-product\">\n          <option value=\"\">全商品</option>\n        </select>\n      </div>\n      <div class=\"search-group\">\n        <label>売上日（開始）</label>\n        <input type=\"date\" class=\"input\" id=\"input-date-start\">\n      </div>\n      <div class=\"search-group\">\n        <label>売上日（終了）</label>\n        <input type=\"date\" class=\"input\" id=\"input-date-end\">\n      </div>\n    </div>\n    <div class=\"search-row\">\n      <div class=\"search-group\">\n        <label>売上金額（最小）</label>\n        <input type=\"number\" class=\"input\" id=\"input-amount-min\" placeholder=\"0\">\n      </div>\n      <div class=\"search-group\">\n        <label>売上金額（最大）</label>\n        <input type=\"number\" class=\"input\" id=\"input-amount-max\" placeholder=\"999999999\">\n      </div>\n      <div class=\"search-group\">\n        <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>売上日</th>\n          <th>店舗名</th>\n          <th>商品名</th>\n          <th>販売数量</th>\n          <th>単価</th>\n          <th>売上金額</th>\n          <th>曜日</th>\n          <th>特売</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"sales-tbody\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 新規登録・編集モーダル -->\n<div id=\"modal-form\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3 id=\"modal-title\">売上実績登録</h3>\n      <button class=\"modal-close\" id=\"btn-modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>店舗 <span class=\"required\">*</span></label>\n        <select class=\"input\" id=\"form-store-id\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>商品 <span class=\"required\">*</span></label>\n        <select class=\"input\" id=\"form-product-id\" required>\n          <option value=\"\">商品を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>売上日 <span class=\"required\">*</span></label>\n        <input type=\"date\" class=\"input\" id=\"form-sales-date\" required>\n      </div>\n      <div class=\"form-group\">\n        <label>販売数量 <span class=\"required\">*</span></label>\n        <input type=\"number\" class=\"input\" id=\"form-quantity\" min=\"0\" required>\n      </div>\n      <div class=\"form-group\">\n        <label>単価 <span class=\"required\">*</span></label>\n        <input type=\"number\" class=\"input\" id=\"form-unit-price\" min=\"0\" required>\n      </div>\n      <div class=\"form-group\">\n        <label>天候区分</label>\n        <select class=\"input\" id=\"form-weather\">\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>気温（℃）</label>\n        <input type=\"number\" class=\"input\" id=\"form-temperature\">\n      </div>\n      <div class=\"form-group\">\n        <label>特売フラグ</label>\n        <input type=\"checkbox\" id=\"form-sale-flag\">\n      </div>\n      <div class=\"form-group\">\n        <label>割引率（%）</label>\n        <input type=\"number\" class=\"input\" id=\"form-discount-rate\" min=\"0\" max=\"100\">\n      </div>\n      <div class=\"form-group\">\n        <label>在庫切れフラグ</label>\n        <input type=\"checkbox\" id=\"form-stock-out-flag\">\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn secondary\" id=\"btn-cancel\">キャンセル</button>\n      <button class=\"action-btn\" id=\"btn-save\">保存</button>\n    </div>\n  </div>\n</div>\n\n<!-- インポートモーダル -->\n<div id=\"modal-import\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>売上実績データインポート</h3>\n      <button class=\"modal-close\" id=\"btn-import-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"import-area\">\n        <button class=\"action-btn secondary\" id=\"btn-download-template\">テンプレートCSVダウンロード</button>\n        <div class=\"drop-zone\" id=\"drop-zone\">\n          <p>CSVファイルをドラッグ&ドロップするか、クリックしてファイルを選択してください</p>\n          <input type=\"file\" id=\"file-input\" accept=\".csv\" style=\"display: none;\">\n        </div>\n        <div id=\"preview-area\" class=\"hidden\">\n          <h4>プレビュー</h4>\n          <div class=\"table-wrap\">\n            <table id=\"preview-table\">\n              <thead id=\"preview-thead\"></thead>\n              <tbody id=\"preview-tbody\"></tbody>\n            </table>\n          </div>\n          <button class=\"action-btn\" id=\"btn-bulk-import\">一括登録実行</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.search-area {\n  background: var(--bg-card);\n  padding: 1rem;\n  margin-bottom: 1rem;\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.search-row {\n  display: flex;\n  gap: 1rem;\n  margin-bottom: 1rem;\n  flex-wrap: wrap;\n}\n\n.search-row:last-child {\n  margin-bottom: 0;\n}\n\n.search-group {\n  display: flex;\n  flex-direction: column;\n  min-width: 150px;\n}\n\n.search-group label {\n  font-size: 0.9rem;\n  color: var(--text-muted);\n  margin-bottom: 0.25rem;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n}\n\n.header-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 1.5rem;\n  cursor: pointer;\n  color: var(--text-muted);\n}\n\n.modal-body {\n  padding: 1rem;\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.5rem;\n  padding: 1rem;\n  border-top: 1px solid var(--border);\n}\n\n.form-group {\n  margin-bottom: 1rem;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 0.25rem;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6a00;\n}\n\n.drop-zone {\n  border: 2px dashed var(--border);\n  border-radius: 8px;\n  padding: 2rem;\n  text-align: center;\n  cursor: pointer;\n  margin: 1rem 0;\n  transition: border-color 0.3s;\n}\n\n.drop-zone:hover {\n  border-color: var(--primary);\n}\n\n.drop-zone.dragover {\n  border-color: var(--primary);\n  background: rgba(0, 123, 255, 0.05);\n}\n\n.import-area {\n  text-align: center;\n}\n\n#preview-area {\n  margin-top: 1rem;\n  text-align: left;\n}\n\n#preview-table {\n  max-height: 300px;\n  overflow-y: auto;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}