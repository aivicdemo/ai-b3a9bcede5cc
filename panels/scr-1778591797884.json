{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>売上実績データ管理</h2>\n    <p class=\"muted\">店舗の売上実績データを登録・編集・削除し、AI需要予測の基礎データとして活用</p>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div class=\"card\">\n    <h3>検索・絞り込み</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;\">\n      <div>\n        <label>店舗選択</label>\n        <select id=\"filter-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div>\n        <label>商品選択</label>\n        <select id=\"filter-product\" class=\"input\">\n          <option value=\"\">全商品</option>\n        </select>\n      </div>\n      <div>\n        <label>開始日</label>\n        <input type=\"date\" id=\"filter-date-start\" class=\"input\">\n      </div>\n      <div>\n        <label>終了日</label>\n        <input type=\"date\" id=\"filter-date-end\" class=\"input\">\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 0.5rem; flex-wrap: wrap;\">\n      <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n      <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n    </div>\n  </div>\n\n  <!-- 操作ボタンエリア -->\n  <div style=\"display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;\">\n    <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n    <button id=\"btn-import\" class=\"action-btn secondary\">一括インポート</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n\n  <!-- 売上実績一覧テーブル -->\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>売上日</th>\n          <th>店舗名</th>\n          <th>商品名</th>\n          <th>販売数量</th>\n          <th>単価</th>\n          <th>売上金額</th>\n          <th>曜日</th>\n          <th>特売</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"sales-table-body\">\n      </tbody>\n    </table>\n  </div>\n\n  <!-- ページネーション -->\n  <div id=\"pagination\" style=\"display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem;\">\n  </div>\n</div>\n\n<!-- 新規登録・編集モーダル -->\n<div id=\"modal-form\" class=\"modal hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;\">\n    <div class=\"card-header\">\n      <h3 id=\"modal-title\">新規売上実績登録</h3>\n    </div>\n    <form id=\"sales-form\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;\">\n        <div>\n          <label>店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"form-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label>商品 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"form-product-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label>売上日 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"date\" id=\"form-sales-date\" class=\"input\" required>\n        </div>\n        <div>\n          <label>販売数量 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"form-quantity\" class=\"input\" min=\"0\" required>\n        </div>\n        <div>\n          <label>単価 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"form-unit-price\" class=\"input\" min=\"0\" required>\n        </div>\n        <div>\n          <label>売上金額 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"form-sales-amount\" class=\"input\" min=\"0\" required readonly>\n        </div>\n        <div>\n          <label>天候区分</label>\n          <select id=\"form-weather\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n          </select>\n        </div>\n        <div>\n          <label>気温</label>\n          <input type=\"number\" id=\"form-temperature\" class=\"input\">\n        </div>\n        <div>\n          <label>特売フラグ</label>\n          <select id=\"form-sale-flag\" class=\"input\">\n            <option value=\"false\">通常販売</option>\n            <option value=\"true\">特売対象</option>\n          </select>\n        </div>\n        <div>\n          <label>割引率（%）</label>\n          <input type=\"number\" id=\"form-discount-rate\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n        <div style=\"grid-column: 1 / -1;\">\n          <label>在庫切れフラグ</label>\n          <select id=\"form-stock-out-flag\" class=\"input\">\n            <option value=\"false\">在庫あり</option>\n            <option value=\"true\">在庫切れ発生</option>\n          </select>\n        </div>\n      </div>\n      <div style=\"display: flex; gap: 0.5rem; justify-content: flex-end;\">\n        <button type=\"button\" id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button type=\"submit\" id=\"btn-save\" class=\"action-btn\">保存</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<!-- インポートモーダル -->\n<div id=\"modal-import\" class=\"modal hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto;\">\n    <div class=\"card-header\">\n      <h3>CSVファイル一括インポート</h3>\n    </div>\n    <div style=\"margin-bottom: 1rem;\">\n      <button id=\"btn-download-template\" class=\"action-btn secondary\">テンプレートCSVダウンロード</button>\n    </div>\n    <div id=\"drop-zone\" style=\"border: 2px dashed var(--border); padding: 2rem; text-align: center; margin-bottom: 1rem; background: var(--bg-main);\">\n      <p>CSVファイルをドラッグ＆ドロップするか、下のボタンでファイルを選択してください</p>\n      <input type=\"file\" id=\"file-input\" accept=\".csv\" style=\"display: none;\">\n      <button id=\"btn-select-file\" class=\"action-btn secondary\">ファイル選択</button>\n    </div>\n    <div id=\"preview-area\" class=\"hidden\">\n      <h4>プレビュー</h4>\n      <div class=\"table-wrap\" style=\"max-height: 300px; overflow-y: auto;\">\n        <table id=\"preview-table\">\n        </table>\n      </div>\n      <div style=\"display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem;\">\n        <button id=\"btn-import-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button id=\"btn-import-execute\" class=\"action-btn\">インポート実行</button>\n      </div>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}