{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div style=\"background: var(--bg-main); color: var(--text); padding: 20px;\">\n  <!-- ヘッダー -->\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;\">\n    <h1 style=\"margin: 0; font-size: 24px; color: var(--text);\">売上実績データ管理</h1>\n    <div style=\"display: flex; gap: 12px;\">\n      <button id=\"btn-csv-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n      <button id=\"btn-csv-import\" class=\"action-btn secondary\">一括インポート</button>\n      <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n    </div>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div class=\"card\" style=\"margin-bottom: 24px; padding: 20px;\">\n    <h3 style=\"margin: 0 0 16px 0; color: var(--text);\">検索・絞り込み条件</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">店舗選択</label>\n        <select id=\"select-store\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">商品選択</label>\n        <select id=\"select-product\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">全商品</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">売上日（開始）</label>\n        <input type=\"date\" id=\"input-date-start\" class=\"input\" style=\"width: 100%;\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">売上日（終了）</label>\n        <input type=\"date\" id=\"input-date-end\" class=\"input\" style=\"width: 100%;\">\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 12px;\">\n      <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n      <button id=\"btn-reset\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 売上実績一覧 -->\n  <div class=\"card\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\">\n      <h3 style=\"margin: 0; color: var(--text);\">売上実績一覧</h3>\n      <div id=\"result-count\" style=\"color: var(--text-muted); font-size: 14px;\">0件</div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th style=\"color: var(--text);\">売上日</th>\n            <th style=\"color: var(--text);\">店舗名</th>\n            <th style=\"color: var(--text);\">商品名</th>\n            <th style=\"color: var(--text);\">販売数量</th>\n            <th style=\"color: var(--text);\">単価</th>\n            <th style=\"color: var(--text);\">売上金額</th>\n            <th style=\"color: var(--text);\">曜日</th>\n            <th style=\"color: var(--text);\">特売</th>\n            <th style=\"color: var(--text);\">操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"sales-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 新規登録・編集モーダル -->\n  <div id=\"modal-form\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n    <div class=\"card\" style=\"width: 90%; max-width: 600px; max-height: 90%; overflow-y: auto;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n        <h3 id=\"modal-title\" style=\"margin: 0; color: var(--text);\">新規売上実績登録</h3>\n        <button id=\"btn-modal-close\" class=\"action-btn secondary\">×</button>\n      </div>\n      <form id=\"form-sales\">\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n            <select id=\"form-store-id\" class=\"input\" style=\"width: 100%;\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">商品 <span style=\"color: #ff6a00;\">*</span></label>\n            <select id=\"form-product-id\" class=\"input\" style=\"width: 100%;\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">売上日 <span style=\"color: #ff6a00;\">*</span></label>\n            <input type=\"date\" id=\"form-sales-date\" class=\"input\" style=\"width: 100%;\" required>\n          </div>\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">販売数量 <span style=\"color: #ff6a00;\">*</span></label>\n            <input type=\"number\" id=\"form-quantity\" class=\"input\" style=\"width: 100%;\" min=\"0\" required>\n          </div>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">単価 <span style=\"color: #ff6a00;\">*</span></label>\n            <input type=\"number\" id=\"form-unit-price\" class=\"input\" style=\"width: 100%;\" min=\"0\" required>\n          </div>\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">売上金額</label>\n            <input type=\"number\" id=\"form-sales-amount\" class=\"input\" style=\"width: 100%;\" readonly>\n          </div>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;\">\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">特売フラグ</label>\n            <select id=\"form-special-sale\" class=\"input\" style=\"width: 100%;\">\n              <option value=\"false\">通常販売</option>\n              <option value=\"true\">特売対象</option>\n            </select>\n          </div>\n          <div>\n            <label style=\"display: block; margin-bottom: 4px; color: var(--text-muted);\">割引率（%）</label>\n            <input type=\"number\" id=\"form-discount-rate\" class=\"input\" style=\"width: 100%;\" min=\"0\" max=\"100\" value=\"0\">\n          </div>\n        </div>\n        <div style=\"display: flex; gap: 12px; justify-content: flex-end;\">\n          <button type=\"button\" id=\"btn-form-cancel\" class=\"action-btn secondary\">キャンセル</button>\n          <button type=\"submit\" id=\"btn-form-save\" class=\"action-btn\">保存</button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <!-- CSVインポートモーダル -->\n  <div id=\"modal-import\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n    <div class=\"card\" style=\"width: 90%; max-width: 800px; max-height: 90%; overflow-y: auto;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n        <h3 style=\"margin: 0; color: var(--text);\">CSVファイル一括インポート</h3>\n        <button id=\"btn-import-close\" class=\"action-btn secondary\">×</button>\n      </div>\n      <div style=\"margin-bottom: 20px;\">\n        <button id=\"btn-download-template\" class=\"action-btn secondary\">テンプレートCSVダウンロード</button>\n      </div>\n      <div id=\"drop-zone\" style=\"border: 2px dashed var(--border); padding: 40px; text-align: center; margin-bottom: 20px; background: var(--bg-main);\">\n        <p style=\"margin: 0 0 10px 0; color: var(--text-muted);\">CSVファイルをここにドラッグ＆ドロップするか</p>\n        <input type=\"file\" id=\"file-input\" accept=\".csv\" style=\"display: none;\">\n        <button id=\"btn-file-select\" class=\"action-btn secondary\">ファイルを選択</button>\n      </div>\n      <div id=\"preview-area\" class=\"hidden\">\n        <h4 style=\"color: var(--text); margin-bottom: 10px;\">プレビュー</h4>\n        <div class=\"table-wrap\" style=\"margin-bottom: 20px;\">\n          <table>\n            <thead id=\"preview-thead\"></thead>\n            <tbody id=\"preview-tbody\"></tbody>\n          </table>\n        </div>\n        <div style=\"display: flex; gap: 12px; justify-content: flex-end;\">\n          <button id=\"btn-import-execute\" class=\"action-btn\">一括登録実行</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}