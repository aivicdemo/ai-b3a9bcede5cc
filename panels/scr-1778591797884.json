{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2 style=\"color: var(--text); margin-bottom: 20px;\">売上実績データ管理</h2>\n  \n  <!-- 検索・絞り込みエリア -->\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; padding: 20px; background: var(--bg-card); border-radius: 8px; border: 1px solid var(--border);\">\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗選択</label>\n      <select id=\"filter-store\" class=\"input\" style=\"width: 100%;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商品選択</label>\n      <select id=\"filter-product\" class=\"input\" style=\"width: 100%;\">\n        <option value=\"\">全商品</option>\n      </select>\n    </div>\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">開始日</label>\n      <input type=\"date\" id=\"filter-start-date\" class=\"input\" style=\"width: 100%;\">\n    </div>\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">終了日</label>\n      <input type=\"date\" id=\"filter-end-date\" class=\"input\" style=\"width: 100%;\">\n    </div>\n    <div style=\"display: flex; align-items: end; gap: 10px;\">\n      <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n      <button id=\"btn-clear-filter\" class=\"action-btn secondary\">クリア</button>\n    </div>\n  </div>\n\n  <!-- アクションボタンエリア -->\n  <div style=\"display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;\">\n    <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n    <button id=\"btn-import\" class=\"action-btn secondary\">一括インポート</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n\n  <!-- 売上実績一覧テーブル -->\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th style=\"color: var(--text);\">売上日</th>\n          <th style=\"color: var(--text);\">店舗名</th>\n          <th style=\"color: var(--text);\">商品名</th>\n          <th style=\"color: var(--text);\">販売数量</th>\n          <th style=\"color: var(--text);\">単価</th>\n          <th style=\"color: var(--text);\">売上金額</th>\n          <th style=\"color: var(--text);\">特売</th>\n          <th style=\"color: var(--text);\">操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"sales-table-body\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 新規登録・編集モーダル -->\n<div id=\"sales-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 600px; max-height: 90%; overflow-y: auto;\">\n    <h3 id=\"modal-title\" style=\"color: var(--text); margin-bottom: 20px;\">新規売上実績登録</h3>\n    \n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"modal-store\" class=\"input\" style=\"width: 100%;\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商品 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"modal-product\" class=\"input\" style=\"width: 100%;\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上日 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"date\" id=\"modal-date\" class=\"input\" style=\"width: 100%;\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">販売数量 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"modal-quantity\" class=\"input\" style=\"width: 100%;\" min=\"0\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">単価 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"modal-price\" class=\"input\" style=\"width: 100%;\" min=\"0\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上金額</label>\n        <input type=\"number\" id=\"modal-amount\" class=\"input\" style=\"width: 100%;\" readonly>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">特売フラグ</label>\n        <select id=\"modal-sale-flag\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"false\">通常販売</option>\n          <option value=\"true\">特売</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">割引率(%)</label>\n        <input type=\"number\" id=\"modal-discount\" class=\"input\" style=\"width: 100%;\" min=\"0\" max=\"100\" value=\"0\">\n      </div>\n    </div>\n\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-modal-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-modal-save\" class=\"action-btn\">保存</button>\n    </div>\n  </div>\n</div>\n\n<!-- インポートモーダル -->\n<div id=\"import-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 800px; max-height: 90%; overflow-y: auto;\">\n    <h3 style=\"color: var(--text); margin-bottom: 20px;\">売上実績データ一括インポート</h3>\n    \n    <div style=\"margin-bottom: 20px;\">\n      <button id=\"btn-download-template\" class=\"action-btn secondary\">テンプレートCSVダウンロード</button>\n    </div>\n\n    <div id=\"drop-zone\" style=\"border: 2px dashed var(--border); border-radius: 8px; padding: 40px; text-align: center; margin-bottom: 20px; background: var(--bg-main);\">\n      <p style=\"color: var(--text-muted); margin-bottom: 10px;\">CSVファイルをドラッグ＆ドロップするか、ボタンでファイルを選択してください</p>\n      <input type=\"file\" id=\"csv-file-input\" accept=\".csv\" style=\"display: none;\">\n      <button id=\"btn-select-file\" class=\"action-btn secondary\">ファイル選択</button>\n    </div>\n\n    <div id=\"preview-area\" class=\"hidden\" style=\"margin-bottom: 20px;\">\n      <h4 style=\"color: var(--text); margin-bottom: 10px;\">プレビュー</h4>\n      <div class=\"table-wrap\" style=\"max-height: 300px; overflow-y: auto;\">\n        <table>\n          <thead id=\"preview-header\"></thead>\n          <tbody id=\"preview-body\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-import-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-import-execute\" class=\"action-btn hidden\">インポート実行</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}