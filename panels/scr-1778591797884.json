{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2>売上実績データ管理</h2>\n  <p class=\"muted\">店舗の売上実績データを登録・編集・削除し、AI需要予測の基礎データとして活用するための管理画面</p>\n</div>\n\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h3>検索・絞り込み</h3>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>店舗選択</label>\n      <select id=\"filter-store\" class=\"input\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div>\n      <label>商品選択</label>\n      <select id=\"filter-product\" class=\"input\">\n        <option value=\"\">全商品</option>\n      </select>\n    </div>\n    <div>\n      <label>売上日（開始）</label>\n      <input type=\"date\" id=\"filter-date-start\" class=\"input\">\n    </div>\n  </div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>売上日（終了）</label>\n      <input type=\"date\" id=\"filter-date-end\" class=\"input\">\n    </div>\n    <div>\n      <label>売上金額（最小）</label>\n      <input type=\"number\" id=\"filter-amount-min\" class=\"input\" placeholder=\"0\">\n    </div>\n    <div>\n      <label>売上金額（最大）</label>\n      <input type=\"number\" id=\"filter-amount-max\" class=\"input\" placeholder=\"999999999\">\n    </div>\n  </div>\n  <div style=\"display: flex; gap: 10px;\">\n    <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n    <button id=\"btn-clear-filter\" class=\"action-btn secondary\">条件クリア</button>\n  </div>\n</div>\n\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h3>新規売上実績登録</h3>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>店舗 <span style=\"color: #ff6a00;\">*</span></label>\n      <select id=\"input-store-id\" class=\"input\" required>\n        <option value=\"\">店舗を選択</option>\n      </select>\n    </div>\n    <div>\n      <label>商品 <span style=\"color: #ff6a00;\">*</span></label>\n      <select id=\"input-product-id\" class=\"input\" required>\n        <option value=\"\">商品を選択</option>\n      </select>\n    </div>\n    <div>\n      <label>売上日 <span style=\"color: #ff6a00;\">*</span></label>\n      <input type=\"date\" id=\"input-sale-date\" class=\"input\" required>\n    </div>\n  </div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>販売数量 <span style=\"color: #ff6a00;\">*</span></label>\n      <input type=\"number\" id=\"input-quantity\" class=\"input\" min=\"0\" required>\n    </div>\n    <div>\n      <label>単価 <span style=\"color: #ff6a00;\">*</span></label>\n      <input type=\"number\" id=\"input-unit-price\" class=\"input\" min=\"0\" required>\n    </div>\n    <div>\n      <label>売上金額 <span style=\"color: #ff6a00;\">*</span></label>\n      <input type=\"number\" id=\"input-amount\" class=\"input\" min=\"0\" required readonly>\n    </div>\n  </div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>天候区分</label>\n      <select id=\"input-weather\" class=\"input\">\n        <option value=\"\">選択してください</option>\n        <option value=\"晴れ\">晴れ</option>\n        <option value=\"曇り\">曇り</option>\n        <option value=\"雨\">雨</option>\n        <option value=\"雪\">雪</option>\n      </select>\n    </div>\n    <div>\n      <label>気温（℃）</label>\n      <input type=\"number\" id=\"input-temperature\" class=\"input\">\n    </div>\n    <div>\n      <label>特売フラグ</label>\n      <select id=\"input-sale-flag\" class=\"input\">\n        <option value=\"false\">通常販売</option>\n        <option value=\"true\">特売対象</option>\n      </select>\n    </div>\n  </div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n    <div>\n      <label>割引率（%）</label>\n      <input type=\"number\" id=\"input-discount-rate\" class=\"input\" min=\"0\" max=\"100\" value=\"0\">\n    </div>\n    <div>\n      <label>在庫切れフラグ</label>\n      <select id=\"input-stockout-flag\" class=\"input\">\n        <option value=\"false\">在庫あり</option>\n        <option value=\"true\">在庫切れ発生</option>\n      </select>\n    </div>\n    <div></div>\n  </div>\n  <div style=\"display: flex; gap: 10px;\">\n    <button id=\"btn-save\" class=\"action-btn\">登録</button>\n    <button id=\"btn-clear-form\" class=\"action-btn secondary\">フォームクリア</button>\n  </div>\n</div>\n\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h3>データ操作</h3>\n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n    <button id=\"btn-import\" class=\"action-btn secondary\">一括インポート</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n    <button id=\"btn-download-template\" class=\"action-btn secondary\">テンプレートダウンロード</button>\n  </div>\n  \n  <div id=\"import-area\" class=\"hidden\" style=\"margin-top: 20px; padding: 20px; border: 2px dashed var(--border); background: var(--bg-main); text-align: center;\">\n    <p>CSVファイルをドラッグ＆ドロップするか、ファイルを選択してください</p>\n    <input type=\"file\" id=\"file-input\" accept=\".csv\" style=\"margin: 10px 0;\">\n    <div id=\"preview-area\" class=\"hidden\" style=\"margin-top: 20px;\">\n      <h4>プレビュー</h4>\n      <div id=\"preview-table\"></div>\n      <button id=\"btn-bulk-import\" class=\"action-btn\" style=\"margin-top: 10px;\">一括登録実行</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"card\">\n  <h3>売上実績一覧</h3>\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>売上日</th>\n          <th>店舗名</th>\n          <th>商品名</th>\n          <th>販売数量</th>\n          <th>単価</th>\n          <th>売上金額</th>\n          <th>天候</th>\n          <th>気温</th>\n          <th>特売</th>\n          <th>割引率</th>\n          <th>在庫切れ</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"sales-table-body\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 編集モーダル -->\n<div id=\"edit-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 600px; max-height: 80vh; overflow-y: auto;\">\n    <h3>売上実績編集</h3>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label>店舗</label>\n        <select id=\"edit-store-id\" class=\"input\">\n          <option value=\"\">店舗を選択</option>\n        </select>\n      </div>\n      <div>\n        <label>商品</label>\n        <select id=\"edit-product-id\" class=\"input\">\n          <option value=\"\">商品を選択</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label>売上日</label>\n        <input type=\"date\" id=\"edit-sale-date\" class=\"input\">\n      </div>\n      <div>\n        <label>販売数量</label>\n        <input type=\"number\" id=\"edit-quantity\" class=\"input\" min=\"0\">\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label>単価</label>\n        <input type=\"number\" id=\"edit-unit-price\" class=\"input\" min=\"0\">\n      </div>\n      <div>\n        <label>売上金額</label>\n        <input type=\"number\" id=\"edit-amount\" class=\"input\" min=\"0\" readonly>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label>天候区分</label>\n        <select id=\"edit-weather\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div>\n        <label>気温（℃）</label>\n        <input type=\"number\" id=\"edit-temperature\" class=\"input\">\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label>特売フラグ</label>\n        <select id=\"edit-sale-flag\" class=\"input\">\n          <option value=\"false\">通常販売</option>\n          <option value=\"true\">特売対象</option>\n        </select>\n      </div>\n      <div>\n        <label>割引率（%）</label>\n        <input type=\"number\" id=\"edit-discount-rate\" class=\"input\" min=\"0\" max=\"100\">\n      </div>\n    </div>\n    <div style=\"margin-bottom: 15px;\">\n      <label>在庫切れフラグ</label>\n      <select id=\"edit-stockout-flag\" class=\"input\">\n        <option value=\"false\">在庫あり</option>\n        <option value=\"true\">在庫切れ発生</option>\n      </select>\n    </div>\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-update\" class=\"action-btn\">更新</button>\n      <button id=\"btn-cancel-edit\" class=\"action-btn secondary\">キャンセル</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}