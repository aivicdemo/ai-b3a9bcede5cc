{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>売上実績データ管理</h2>\n    <p class=\"muted\">店舗の売上実績データを登録・編集・削除し、AI需要予測の基礎データとして活用</p>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div class=\"search-section\">\n    <div class=\"search-row\">\n      <div class=\"search-field\">\n        <label>店舗選択</label>\n        <select id=\"select-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"search-field\">\n        <label>商品選択</label>\n        <select id=\"select-product\" class=\"input\">\n          <option value=\"\">全商品</option>\n        </select>\n      </div>\n      <div class=\"search-field\">\n        <label>売上日（開始）</label>\n        <input type=\"date\" id=\"input-date-start\" class=\"input\">\n      </div>\n      <div class=\"search-field\">\n        <label>売上日（終了）</label>\n        <input type=\"date\" id=\"input-date-end\" class=\"input\">\n      </div>\n      <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n    </div>\n  </div>\n\n  <!-- アクションボタンエリア -->\n  <div class=\"action-section\">\n    <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n    <button id=\"btn-import\" class=\"action-btn secondary\">一括インポート</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n\n  <!-- 売上実績一覧テーブル -->\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>売上日</th>\n          <th>店舗名</th>\n          <th>商品名</th>\n          <th>販売数量</th>\n          <th>単価</th>\n          <th>売上金額</th>\n          <th>曜日</th>\n          <th>特売</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"sales-tbody\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 新規登録・編集モーダル -->\n<div id=\"modal-form\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3 id=\"modal-title\">売上実績登録</h3>\n      <button id=\"btn-modal-close\" class=\"close-btn\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-row\">\n        <div class=\"form-field\">\n          <label>店舗 <span class=\"required\">*</span></label>\n          <select id=\"input-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n          <div class=\"error-message\" id=\"error-store-id\"></div>\n        </div>\n        <div class=\"form-field\">\n          <label>商品 <span class=\"required\">*</span></label>\n          <select id=\"input-product-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n          <div class=\"error-message\" id=\"error-product-id\"></div>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-field\">\n          <label>売上日 <span class=\"required\">*</span></label>\n          <input type=\"date\" id=\"input-sales-date\" class=\"input\" required>\n          <div class=\"error-message\" id=\"error-sales-date\"></div>\n        </div>\n        <div class=\"form-field\">\n          <label>販売数量 <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"input-quantity\" class=\"input\" min=\"0\" required>\n          <div class=\"error-message\" id=\"error-quantity\"></div>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-field\">\n          <label>単価 <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"input-unit-price\" class=\"input\" min=\"0\" required>\n          <div class=\"error-message\" id=\"error-unit-price\"></div>\n        </div>\n        <div class=\"form-field\">\n          <label>売上金額 <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"input-sales-amount\" class=\"input\" min=\"0\" required readonly>\n          <div class=\"error-message\" id=\"error-sales-amount\"></div>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-field\">\n          <label>特売フラグ</label>\n          <input type=\"checkbox\" id=\"input-sale-flag\">\n        </div>\n        <div class=\"form-field\">\n          <label>割引率（%）</label>\n          <input type=\"number\" id=\"input-discount-rate\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button id=\"btn-save\" class=\"action-btn\">登録</button>\n      <button id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n    </div>\n  </div>\n</div>\n\n<!-- インポートモーダル -->\n<div id=\"modal-import\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>CSVファイル一括インポート</h3>\n      <button id=\"btn-import-close\" class=\"close-btn\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"import-section\">\n        <button id=\"btn-template\" class=\"action-btn secondary\">テンプレートCSVダウンロード</button>\n        <div id=\"drop-zone\" class=\"drop-zone\">\n          <p>CSVファイルをドラッグ&ドロップするか、クリックしてファイルを選択</p>\n          <input type=\"file\" id=\"file-input\" accept=\".csv\" class=\"hidden\">\n        </div>\n        <div id=\"preview-section\" class=\"hidden\">\n          <h4>プレビュー</h4>\n          <div class=\"table-wrap\">\n            <table id=\"preview-table\">\n              <thead id=\"preview-thead\"></thead>\n              <tbody id=\"preview-tbody\"></tbody>\n            </table>\n          </div>\n          <button id=\"btn-import-execute\" class=\"action-btn\">一括登録実行</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.search-section {\n  background: var(--bg-card);\n  padding: 1rem;\n  margin-bottom: 1rem;\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.search-row {\n  display: flex;\n  gap: 1rem;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.search-field {\n  display: flex;\n  flex-direction: column;\n  min-width: 150px;\n}\n\n.search-field label {\n  color: var(--text);\n  font-size: 0.9rem;\n  margin-bottom: 0.25rem;\n}\n\n.action-section {\n  display: flex;\n  gap: 0.5rem;\n  margin-bottom: 1rem;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0,0,0,0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  color: var(--text);\n  margin: 0;\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  font-size: 1.5rem;\n  color: var(--text-muted);\n  cursor: pointer;\n}\n\n.modal-body {\n  padding: 1rem;\n}\n\n.modal-footer {\n  display: flex;\n  gap: 0.5rem;\n  justify-content: flex-end;\n  padding: 1rem;\n  border-top: 1px solid var(--border);\n}\n\n.form-row {\n  display: flex;\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n\n.form-field {\n  flex: 1;\n}\n\n.form-field label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 0.25rem;\n  font-size: 0.9rem;\n}\n\n.required {\n  color: #ff6a6a;\n}\n\n.error-message {\n  color: #ff6a6a;\n  font-size: 0.8rem;\n  margin-top: 0.25rem;\n  min-height: 1rem;\n}\n\n.drop-zone {\n  border: 2px dashed var(--border);\n  border-radius: 8px;\n  padding: 2rem;\n  text-align: center;\n  cursor: pointer;\n  margin: 1rem 0;\n  background: var(--bg-main);\n}\n\n.drop-zone:hover {\n  border-color: var(--primary);\n}\n\n.drop-zone.dragover {\n  border-color: var(--primary);\n  background: rgba(0,123,255,0.1);\n}\n\n.import-section {\n  margin-bottom: 1rem;\n}\n\n#preview-table {\n  max-height: 300px;\n  overflow-y: auto;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}