{
  "screenId": "scr-1778591797884",
  "screenName": "売上実績データ管理",
  "html": "<div class=\"card\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n    <h2 style=\"color: var(--text); margin: 0;\">売上実績データ管理</h2>\n    <div style=\"display: flex; gap: 10px;\">\n      <button id=\"btn-bulk-import\" class=\"action-btn\">一括インポート</button>\n      <button id=\"btn-csv-export\" class=\"action-btn\">CSVエクスポート</button>\n    </div>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">検索・絞り込み</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗選択</label>\n        <select id=\"filter-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商品選択</label>\n        <select id=\"filter-product\" class=\"input\">\n          <option value=\"\">全商品</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">開始日</label>\n        <input type=\"date\" id=\"filter-start-date\" class=\"input\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">終了日</label>\n        <input type=\"date\" id=\"filter-end-date\" class=\"input\">\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 10px;\">\n      <button id=\"btn-search\" class=\"action-btn\">検索・絞り込み</button>\n      <button id=\"btn-clear-filter\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- 新規登録フォーム -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">新規売上実績登録</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"input-store-id\" class=\"input\" required>\n          <option value=\"\">店舗を選択</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商品 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"input-product-id\" class=\"input\" required>\n          <option value=\"\">商品を選択</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上日 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"date\" id=\"input-sales-date\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">販売数量 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"input-quantity\" class=\"input\" min=\"0\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">単価 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"input-unit-price\" class=\"input\" min=\"0\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上金額 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"input-sales-amount\" class=\"input\" min=\"0\" readonly>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">天候区分</label>\n        <select id=\"input-weather\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">気温（℃）</label>\n        <input type=\"number\" id=\"input-temperature\" class=\"input\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">特売フラグ</label>\n        <select id=\"input-sale-flag\" class=\"input\">\n          <option value=\"false\">通常販売</option>\n          <option value=\"true\">特売対象</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">割引率（%）</label>\n        <input type=\"number\" id=\"input-discount-rate\" class=\"input\" min=\"0\" max=\"100\" value=\"0\">\n      </div>\n    </div>\n    <button id=\"btn-register\" class=\"action-btn\">新規登録</button>\n  </div>\n\n  <!-- 売上実績一覧 -->\n  <div class=\"card\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">売上実績一覧</h3>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th style=\"color: var(--text);\">売上日</th>\n            <th style=\"color: var(--text);\">店舗名</th>\n            <th style=\"color: var(--text);\">商品名</th>\n            <th style=\"color: var(--text);\">販売数量</th>\n            <th style=\"color: var(--text);\">単価</th>\n            <th style=\"color: var(--text);\">売上金額</th>\n            <th style=\"color: var(--text);\">天候</th>\n            <th style=\"color: var(--text);\">特売</th>\n            <th style=\"color: var(--text);\">操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"sales-data-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<!-- 編集モーダル -->\n<div id=\"edit-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;\">\n    <h3 style=\"color: var(--text); margin: 0 0 20px 0;\">売上実績編集</h3>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗</label>\n        <select id=\"edit-store-id\" class=\"input\">\n          <option value=\"\">店舗を選択</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商品</label>\n        <select id=\"edit-product-id\" class=\"input\">\n          <option value=\"\">商品を選択</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上日</label>\n        <input type=\"date\" id=\"edit-sales-date\" class=\"input\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">販売数量</label>\n        <input type=\"number\" id=\"edit-quantity\" class=\"input\" min=\"0\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">単価</label>\n        <input type=\"number\" id=\"edit-unit-price\" class=\"input\" min=\"0\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">売上金額</label>\n        <input type=\"number\" id=\"edit-sales-amount\" class=\"input\" min=\"0\" readonly>\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-cancel-edit\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-save-edit\" class=\"action-btn\">保存</button>\n    </div>\n  </div>\n</div>\n\n<!-- インポートモーダル -->\n<div id=\"import-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto;\">\n    <h3 style=\"color: var(--text); margin: 0 0 20px 0;\">CSVファイル一括インポート</h3>\n    \n    <div style=\"margin-bottom: 20px;\">\n      <button id=\"btn-download-template\" class=\"action-btn secondary\">テンプレートCSVダウンロード</button>\n    </div>\n\n    <div id=\"drop-zone\" style=\"border: 2px dashed var(--border); padding: 40px; text-align: center; margin-bottom: 20px; background: var(--bg-main);\">\n      <p style=\"color: var(--text-muted); margin: 0 0 10px 0;\">CSVファイルをここにドラッグ＆ドロップ</p>\n      <p style=\"color: var(--text-muted); margin: 0 0 15px 0;\">または</p>\n      <input type=\"file\" id=\"file-input\" accept=\".csv\" style=\"display: none;\">\n      <button id=\"btn-select-file\" class=\"action-btn secondary\">ファイルを選択</button>\n    </div>\n\n    <div id=\"preview-area\" class=\"hidden\" style=\"margin-bottom: 20px;\">\n      <h4 style=\"color: var(--text); margin: 0 0 10px 0;\">プレビュー</h4>\n      <div class=\"table-wrap\" style=\"max-height: 300px; overflow-y: auto;\">\n        <table id=\"preview-table\">\n          <thead id=\"preview-thead\"></thead>\n          <tbody id=\"preview-tbody\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-cancel-import\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-execute-import\" class=\"action-btn hidden\">一括登録実行</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}