{
  "screenId": "scr-1778591838939",
  "screenName": "需要予測管理",
  "html": "<div class=\"demand-forecast-management\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>需要予測管理</h1>\n    <p class=\"page-description\">AI技術を活用した商品需要予測と発注量決定支援</p>\n  </div>\n\n  <!-- 予測条件設定エリア -->\n  <div class=\"card forecast-settings\">\n    <h2>予測条件設定</h2>\n    <div class=\"settings-grid\">\n      <div class=\"setting-group\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      \n      <div class=\"setting-group\">\n        <label for=\"category-select\">商品カテゴリ</label>\n        <select id=\"category-select\" class=\"input\">\n          <option value=\"\">カテゴリを選択してください</option>\n        </select>\n      </div>\n      \n      <div class=\"setting-group\">\n        <label for=\"start-date\">予測期間（開始日）</label>\n        <input type=\"date\" id=\"start-date\" class=\"input\">\n      </div>\n      \n      <div class=\"setting-group\">\n        <label for=\"end-date\">予測期間（終了日）</label>\n        <input type=\"date\" id=\"end-date\" class=\"input\">\n      </div>\n      \n      <div class=\"setting-group\">\n        <label for=\"model-select\">予測モデル</label>\n        <select id=\"model-select\" class=\"input\">\n          <option value=\"\">予測モデルを選択してください</option>\n          <option value=\"standard\">標準予測モデル</option>\n          <option value=\"seasonal\">季節性考慮モデル</option>\n          <option value=\"event\">イベント考慮モデル</option>\n          <option value=\"weather\">天候考慮モデル</option>\n        </select>\n      </div>\n    </div>\n    \n    <div class=\"model-options\">\n      <h3>予測オプション</h3>\n      <div class=\"checkbox-group\">\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"seasonal-check\">\n          <span>季節性考慮</span>\n        </label>\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"event-check\">\n          <span>イベント考慮</span>\n        </label>\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"weather-check\">\n          <span>天候考慮</span>\n        </label>\n      </div>\n    </div>\n    \n    <div class=\"action-buttons\">\n      <button id=\"btn-execute-forecast\" class=\"action-btn\">AI予測実行</button>\n      <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n    </div>\n  </div>\n\n  <!-- 予測結果表示エリア -->\n  <div class=\"card forecast-results hidden\" id=\"forecast-results\">\n    <div class=\"results-header\">\n      <h2>予測結果</h2>\n      <div class=\"result-actions\">\n        <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSVエクスポート</button>\n        <button id=\"btn-export-excel\" class=\"action-btn secondary\">Excelエクスポート</button>\n      </div>\n    </div>\n    \n    <!-- 予測グラフエリア -->\n    <div class=\"chart-container\">\n      <h3>需要予測グラフ</h3>\n      <canvas id=\"forecast-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n    \n    <!-- 売上実績vs予測値比較 -->\n    <div class=\"comparison-chart-container\">\n      <h3>売上実績 vs 予測値比較</h3>\n      <canvas id=\"comparison-chart\" width=\"800\" height=\"300\"></canvas>\n    </div>\n    \n    <!-- 予測精度指標 -->\n    <div class=\"accuracy-metrics\">\n      <h3>予測精度指標</h3>\n      <div class=\"metrics-grid\">\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">予測精度</span>\n          <span class=\"metric-value\" id=\"accuracy-rate\">-</span>\n        </div>\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">平均絶対誤差</span>\n          <span class=\"metric-value\" id=\"mae-value\">-</span>\n        </div>\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">決定係数</span>\n          <span class=\"metric-value\" id=\"r2-value\">-</span>\n        </div>\n      </div>\n    </div>\n    \n    <!-- 影響要因分析 -->\n    <div class=\"factor-analysis\">\n      <h3>影響要因分析結果</h3>\n      <div class=\"factor-list\" id=\"factor-list\">\n        <!-- 動的に生成 -->\n      </div>\n    </div>\n    \n    <!-- 天候・イベント情報 -->\n    <div class=\"external-factors\">\n      <div class=\"weather-info\">\n        <h4>天候情報</h4>\n        <div id=\"weather-data\" class=\"info-content\">\n          <!-- 動的に生成 -->\n        </div>\n      </div>\n      <div class=\"event-info\">\n        <h4>イベント情報</h4>\n        <div id=\"event-data\" class=\"info-content\">\n          <!-- 動的に生成 -->\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 商品別予測一覧 -->\n  <div class=\"card product-forecast-list\">\n    <div class=\"list-header\">\n      <h2>商品別予測一覧</h2>\n      <div class=\"list-actions\">\n        <input type=\"text\" id=\"product-search\" class=\"input\" placeholder=\"商品名・商品コードで検索\">\n        <button id=\"btn-search-products\" class=\"action-btn secondary\">検索</button>\n      </div>\n    </div>\n    \n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>商品コード</th>\n            <th>商品名</th>\n            <th>予測期間</th>\n            <th>予測数量</th>\n            <th>予測精度</th>\n            <th>推奨発注数量</th>\n            <th>ステータス</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"product-forecast-tbody\">\n          <!-- 動的に生成 -->\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- ローディング表示 -->\n  <div class=\"loading-overlay hidden\" id=\"loading-overlay\">\n    <div class=\"loading-content\">\n      <div class=\"loading-spinner\"></div>\n      <p>AI予測処理中...</p>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div class=\"error-message hidden\" id=\"error-message\">\n    <span class=\"error-text\"></span>\n    <button class=\"error-close\">&times;</button>\n  </div>\n</div>\n\n<style>\n.demand-forecast-management {\n  padding: 20px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.page-header {\n  margin-bottom: 30px;\n}\n\n.page-header h1 {\n  color: var(--text);\n  margin: 0 0 8px 0;\n  font-size: 28px;\n}\n\n.page-description {\n  color: var(--text-muted);\n  margin: 0;\n  font-size: 14px;\n}\n\n.forecast-settings {\n  margin-bottom: 30px;\n}\n\n.forecast-settings h2 {\n  color: var(--text);\n  margin: 0 0 20px 0;\n  font-size: 20px;\n}\n\n.settings-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 25px;\n}\n\n.setting-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.setting-group label {\n  color: var(--text);\n  margin-bottom: 5px;\n  font-weight: 500;\n}\n\n.model-options h3 {\n  color: var(--text);\n  margin: 0 0 15px 0;\n  font-size: 16px;\n}\n\n.checkbox-group {\n  display: flex;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.checkbox-label input[type=\"checkbox\"] {\n  margin-right: 8px;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 15px;\n  margin-top: 25px;\n}\n\n.forecast-results {\n  margin-bottom: 30px;\n}\n\n.results-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 25px;\n}\n\n.results-header h2 {\n  color: var(--text);\n  margin: 0;\n  font-size: 20px;\n}\n\n.result-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.chart-container, .comparison-chart-container {\n  margin-bottom: 30px;\n}\n\n.chart-container h3, .comparison-chart-container h3 {\n  color: var(--text);\n  margin: 0 0 15px 0;\n  font-size: 16px;\n}\n\n.chart-container canvas, .comparison-chart-container canvas {\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  width: 100%;\n  height: auto;\n}\n\n.accuracy-metrics {\n  margin-bottom: 30px;\n}\n\n.accuracy-metrics h3 {\n  color: var(--text);\n  margin: 0 0 15px 0;\n  font-size: 16px;\n}\n\n.metrics-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n}\n\n.metric-item {\n  background: var(--bg-main);\n  padding: 15px;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  text-align: center;\n}\n\n.metric-label {\n  display: block;\n  color: var(--text-muted);\n  font-size: 12px;\n  margin-bottom: 5px;\n}\n\n.metric-value {\n  display: block;\n  color: var(--text);\n  font-size: 20px;\n  font-weight: bold;\n}\n\n.factor-analysis {\n  margin-bottom: 30px;\n}\n\n.factor-analysis h3 {\n  color: var(--text);\n  margin: 0 0 15px 0;\n  font-size: 16px;\n}\n\n.factor-list {\n  background: var(--bg-main);\n  padding: 15px;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n}\n\n.external-factors {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n\n.weather-info, .event-info {\n  background: var(--bg-main);\n  padding: 15px;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n}\n\n.weather-info h4, .event-info h4 {\n  color: var(--text);\n  margin: 0 0 10px 0;\n  font-size: 14px;\n}\n\n.info-content {\n  color: var(--text-muted);\n  font-size: 13px;\n}\n\n.product-forecast-list {\n  margin-bottom: 30px;\n}\n\n.list-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.list-header h2 {\n  color: var(--text);\n  margin: 0;\n  font-size: 20px;\n}\n\n.list-actions {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.list-actions input {\n  width: 250px;\n}\n\n.loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.7);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.loading-content {\n  background: var(--bg-card);\n  padding: 30px;\n  border-radius: 8px;\n  text-align: center;\n  color: var(--text);\n}\n\n.loading-spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 15px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.error-message {\n  position: fixed;\n  top: 20px;\n  right: 20px;\n  background: #dc3545;\n  color: white;\n  padding: 15px 20px;\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  z-index: 1001;\n  max-width: 400px;\n}\n\n.error-close {\n  background: none;\n  border: none;\n  color: white;\n  font-size: 18px;\n  cursor: pointer;\n  padding: 0;\n  width: 20px;\n  height: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n@media (max-width: 768px) {\n  .settings-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .external-factors {\n    grid-template-columns: 1fr;\n  }\n  \n  .results-header {\n    flex-direction: column;\n    gap: 15px;\n    align-items: flex-start;\n  }\n  \n  .list-header {\n    flex-direction: column;\n    gap: 15px;\n    align-items: flex-start;\n  }\n  \n  .list-actions input {\n    width: 100%;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}