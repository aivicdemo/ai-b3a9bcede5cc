{
  "screenId": "scr-1778591838939",
  "screenName": "需要予測管理",
  "html": "<div class=\"demand-forecast-management\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>需要予測管理</h1>\n    <p class=\"muted\">AI技術を活用した商品需要予測と発注量決定支援</p>\n  </div>\n\n  <!-- 予測条件設定 -->\n  <div class=\"card\">\n    <h2>予測条件設定</h2>\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"category-select\">商品カテゴリ</label>\n        <select id=\"category-select\" class=\"input\">\n          <option value=\"\">カテゴリを選択してください</option>\n          <option value=\"food\">食品</option>\n          <option value=\"beverage\">飲料</option>\n          <option value=\"daily\">日用品</option>\n          <option value=\"frozen\">冷凍食品</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"product-code\">商品コード</label>\n        <input type=\"text\" id=\"product-code\" class=\"input\" placeholder=\"商品コードを入力\">\n      </div>\n      <div class=\"form-group\">\n        <label for=\"start-date\">予測期間（開始日）</label>\n        <input type=\"date\" id=\"start-date\" class=\"input\">\n      </div>\n      <div class=\"form-group\">\n        <label for=\"end-date\">予測期間（終了日）</label>\n        <input type=\"date\" id=\"end-date\" class=\"input\">\n      </div>\n      <div class=\"form-group\">\n        <label for=\"model-select\">予測モデル</label>\n        <select id=\"model-select\" class=\"input\">\n          <option value=\"\">予測モデルを選択してください</option>\n          <option value=\"standard\">標準予測モデル</option>\n          <option value=\"seasonal\">季節性考慮モデル</option>\n          <option value=\"event\">イベント考慮モデル</option>\n          <option value=\"weather\">天候考慮モデル</option>\n        </select>\n      </div>\n    </div>\n    \n    <div class=\"model-options\">\n      <h3>予測オプション</h3>\n      <div class=\"checkbox-group\">\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"seasonal-factor\">\n          <span>季節性考慮</span>\n        </label>\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"event-factor\">\n          <span>イベント考慮</span>\n        </label>\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"weather-factor\">\n          <span>天候データ</span>\n        </label>\n      </div>\n    </div>\n\n    <div class=\"form-actions\">\n      <button id=\"btn-predict\" class=\"action-btn\">AI予測実行</button>\n      <button id=\"btn-clear\" class=\"action-btn secondary\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div id=\"error-message\" class=\"error-message hidden\"></div>\n\n  <!-- ローディング表示 -->\n  <div id=\"loading-indicator\" class=\"loading-indicator hidden\">\n    <div class=\"spinner\"></div>\n    <p>AI予測処理を実行中です...</p>\n  </div>\n\n  <!-- 予測結果表示エリア -->\n  <div id=\"prediction-results\" class=\"prediction-results hidden\">\n    <!-- 予測結果グラフ -->\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h2>予測結果グラフ</h2>\n        <div class=\"chart-controls\">\n          <button id=\"btn-chart-line\" class=\"action-btn secondary active\">線グラフ</button>\n          <button id=\"btn-chart-bar\" class=\"action-btn secondary\">棒グラフ</button>\n        </div>\n      </div>\n      <div class=\"chart-container\">\n        <canvas id=\"prediction-chart\" width=\"800\" height=\"400\"></canvas>\n      </div>\n    </div>\n\n    <!-- 売上実績vs予測値比較 -->\n    <div class=\"card\">\n      <h2>売上実績 vs 予測値比較</h2>\n      <div class=\"comparison-chart\">\n        <canvas id=\"comparison-chart\" width=\"800\" height=\"300\"></canvas>\n      </div>\n    </div>\n\n    <!-- 予測精度指標 -->\n    <div class=\"card\">\n      <h2>予測精度指標</h2>\n      <div class=\"accuracy-metrics\">\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">予測精度</span>\n          <span id=\"accuracy-rate\" class=\"metric-value\">--</span>\n        </div>\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">信頼区間</span>\n          <span id=\"confidence-interval\" class=\"metric-value\">--</span>\n        </div>\n        <div class=\"metric-item\">\n          <span class=\"metric-label\">MAPE</span>\n          <span id=\"mape-value\" class=\"metric-value\">--</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 影響要因分析 -->\n    <div class=\"card\">\n      <h2>影響要因分析結果</h2>\n      <div class=\"factor-analysis\">\n        <div class=\"factor-item\">\n          <span class=\"factor-name\">季節性</span>\n          <div class=\"factor-impact\">\n            <div class=\"impact-bar\" style=\"width: 75%; background: var(--primary);\"></div>\n            <span class=\"impact-value\">75%</span>\n          </div>\n        </div>\n        <div class=\"factor-item\">\n          <span class=\"factor-name\">天候</span>\n          <div class=\"factor-impact\">\n            <div class=\"impact-bar\" style=\"width: 45%; background: #ff6a00;\"></div>\n            <span class=\"impact-value\">45%</span>\n          </div>\n        </div>\n        <div class=\"factor-item\">\n          <span class=\"factor-name\">イベント</span>\n          <div class=\"factor-impact\">\n            <div class=\"impact-bar\" style=\"width: 30%; background: #00c851;\"></div>\n            <span class=\"impact-value\">30%</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 天候・イベント情報パネル -->\n    <div class=\"info-panels\">\n      <div class=\"card\">\n        <h3>天候情報</h3>\n        <div id=\"weather-info\" class=\"info-content\">\n          <div class=\"weather-item\">\n            <span class=\"date\">2024-01-15</span>\n            <span class=\"weather\">晴れ</span>\n            <span class=\"temp\">15°C</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>イベント情報</h3>\n        <div id=\"event-info\" class=\"info-content\">\n          <div class=\"event-item\">\n            <span class=\"date\">2024-01-20</span>\n            <span class=\"event\">地域祭り</span>\n            <span class=\"impact\">影響度: 大</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 商品別予測一覧 -->\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h2>商品別予測一覧</h2>\n      <div class=\"header-actions\">\n        <button id=\"btn-export\" class=\"action-btn secondary\">予測結果エクスポート</button>\n        <button id=\"btn-refresh\" class=\"action-btn secondary\">更新</button>\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>商品コード</th>\n            <th>商品名</th>\n            <th>予測期間</th>\n            <th>予測数量</th>\n            <th>予測精度</th>\n            <th>推奨発注数量</th>\n            <th>ステータス</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"prediction-table-body\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<style>\n.demand-forecast-management {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 30px;\n}\n\n.page-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.form-group label {\n  color: var(--text);\n  margin-bottom: 5px;\n  font-weight: 500;\n}\n\n.model-options {\n  margin: 20px 0;\n}\n\n.model-options h3 {\n  color: var(--text);\n  margin-bottom: 10px;\n}\n\n.checkbox-group {\n  display: flex;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.checkbox-label input[type=\"checkbox\"] {\n  margin: 0;\n}\n\n.form-actions {\n  display: flex;\n  gap: 10px;\n  margin-top: 20px;\n}\n\n.error-message {\n  background: rgba(255, 106, 0, 0.1);\n  border: 1px solid #ff6a00;\n  border-radius: 4px;\n  padding: 12px;\n  margin: 20px 0;\n  color: var(--text);\n}\n\n.loading-indicator {\n  text-align: center;\n  padding: 40px;\n  background: var(--bg-card);\n  border-radius: 8px;\n  margin: 20px 0;\n}\n\n.spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 20px;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.prediction-results {\n  margin-top: 30px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.chart-controls {\n  display: flex;\n  gap: 10px;\n}\n\n.chart-controls .action-btn.active {\n  background: var(--primary);\n  color: white;\n}\n\n.chart-container {\n  background: var(--bg-main);\n  border-radius: 8px;\n  padding: 20px;\n  overflow-x: auto;\n}\n\n.comparison-chart {\n  background: var(--bg-main);\n  border-radius: 8px;\n  padding: 20px;\n  overflow-x: auto;\n}\n\n.accuracy-metrics {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n}\n\n.metric-item {\n  background: var(--bg-main);\n  padding: 20px;\n  border-radius: 8px;\n  text-align: center;\n}\n\n.metric-label {\n  display: block;\n  color: var(--text-muted);\n  font-size: 14px;\n  margin-bottom: 8px;\n}\n\n.metric-value {\n  display: block;\n  color: var(--text);\n  font-size: 24px;\n  font-weight: bold;\n}\n\n.factor-analysis {\n  display: flex;\n  flex-direction: column;\n  gap: 15px;\n}\n\n.factor-item {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.factor-name {\n  min-width: 100px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.factor-impact {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.impact-bar {\n  height: 20px;\n  border-radius: 10px;\n  transition: width 0.3s ease;\n}\n\n.impact-value {\n  color: var(--text);\n  font-weight: bold;\n  min-width: 40px;\n}\n\n.info-panels {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin: 20px 0;\n}\n\n.info-content {\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.weather-item, .event-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--border);\n  color: var(--text);\n}\n\n.weather-item:last-child, .event-item:last-child {\n  border-bottom: none;\n}\n\n.date {\n  font-weight: 500;\n}\n\n.weather, .event {\n  color: var(--text-muted);\n}\n\n.temp, .impact {\n  font-weight: bold;\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.hidden {\n  display: none;\n}\n\n@media (max-width: 768px) {\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .info-panels {\n    grid-template-columns: 1fr;\n  }\n  \n  .checkbox-group {\n    flex-direction: column;\n  }\n  \n  .card-header {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 10px;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}