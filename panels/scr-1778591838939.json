{
  "screenId": "scr-1778591838939",
  "screenName": "需要予測管理",
  "html": "<div class=\"demand-forecast-management\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>需要予測管理</h1>\n    <p class=\"muted\">AI技術を活用した商品需要予測と発注量決定支援</p>\n  </div>\n\n  <!-- 予測条件設定エリア -->\n  <div class=\"card\">\n    <h2>予測条件設定</h2>\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"category-select\">商品カテゴリ</label>\n        <select id=\"category-select\" class=\"input\">\n          <option value=\"\">カテゴリを選択してください</option>\n          <option value=\"food\">食品</option>\n          <option value=\"beverage\">飲料</option>\n          <option value=\"daily\">日用品</option>\n          <option value=\"frozen\">冷凍食品</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"start-date\">予測期間（開始日）</label>\n        <input type=\"date\" id=\"start-date\" class=\"input\">\n      </div>\n      <div class=\"form-group\">\n        <label for=\"end-date\">予測期間（終了日）</label>\n        <input type=\"date\" id=\"end-date\" class=\"input\">\n      </div>\n      <div class=\"form-group\">\n        <label for=\"model-select\">予測モデル</label>\n        <select id=\"model-select\" class=\"input\">\n          <option value=\"\">モデルを選択してください</option>\n          <option value=\"basic\">基本モデル</option>\n          <option value=\"seasonal\">季節性考慮モデル</option>\n          <option value=\"event\">イベント考慮モデル</option>\n          <option value=\"weather\">天候考慮モデル</option>\n          <option value=\"comprehensive\">総合モデル</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>\n          <input type=\"checkbox\" id=\"seasonal-check\"> 季節性考慮\n        </label>\n      </div>\n      <div class=\"form-group\">\n        <label>\n          <input type=\"checkbox\" id=\"event-check\"> イベント考慮\n        </label>\n      </div>\n      <div class=\"form-group\">\n        <label>\n          <input type=\"checkbox\" id=\"weather-check\"> 天候考慮\n        </label>\n      </div>\n    </div>\n    <div class=\"form-actions\">\n      <button id=\"btn-predict\" class=\"action-btn\">AI予測実行</button>\n      <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n    </div>\n  </div>\n\n  <!-- 予測結果表示エリア -->\n  <div id=\"prediction-results\" class=\"card hidden\">\n    <h2>予測結果</h2>\n    \n    <!-- 予測精度指標 -->\n    <div class=\"accuracy-metrics\">\n      <div class=\"metric-item\">\n        <span class=\"metric-label\">予測精度</span>\n        <span id=\"accuracy-score\" class=\"metric-value\">-</span>\n      </div>\n      <div class=\"metric-item\">\n        <span class=\"metric-label\">信頼度</span>\n        <span id=\"confidence-score\" class=\"metric-value\">-</span>\n      </div>\n      <div class=\"metric-item\">\n        <span class=\"metric-label\">予測期間</span>\n        <span id=\"prediction-period\" class=\"metric-value\">-</span>\n      </div>\n    </div>\n\n    <!-- グラフ表示エリア -->\n    <div class=\"chart-container\">\n      <h3>需要予測グラフ</h3>\n      <canvas id=\"prediction-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n\n    <!-- 売上実績vs予測値比較チャート -->\n    <div class=\"chart-container\">\n      <h3>実績vs予測値比較</h3>\n      <canvas id=\"comparison-chart\" width=\"800\" height=\"300\"></canvas>\n    </div>\n  </div>\n\n  <!-- 影響要因分析結果 -->\n  <div id=\"factor-analysis\" class=\"card hidden\">\n    <h2>影響要因分析結果</h2>\n    <div class=\"factor-grid\">\n      <div class=\"factor-item\">\n        <h4>天候要因</h4>\n        <div id=\"weather-factors\" class=\"factor-content\">\n          <p class=\"muted\">分析中...</p>\n        </div>\n      </div>\n      <div class=\"factor-item\">\n        <h4>イベント要因</h4>\n        <div id=\"event-factors\" class=\"factor-content\">\n          <p class=\"muted\">分析中...</p>\n        </div>\n      </div>\n      <div class=\"factor-item\">\n        <h4>季節要因</h4>\n        <div id=\"seasonal-factors\" class=\"factor-content\">\n          <p class=\"muted\">分析中...</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 天候・イベント情報パネル -->\n  <div class=\"card\">\n    <h2>外部要因情報</h2>\n    <div class=\"info-panels\">\n      <div class=\"info-panel\">\n        <h4>天候情報</h4>\n        <div id=\"weather-info\">\n          <p class=\"muted\">データを読み込み中...</p>\n        </div>\n      </div>\n      <div class=\"info-panel\">\n        <h4>イベント情報</h4>\n        <div id=\"event-info\">\n          <p class=\"muted\">データを読み込み中...</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 商品別予測一覧 -->\n  <div class=\"card\">\n    <div class=\"table-header\">\n      <h2>商品別予測一覧</h2>\n      <div class=\"table-actions\">\n        <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"商品名で検索...\">\n        <button id=\"btn-search\" class=\"action-btn secondary\">検索</button>\n        <button id=\"btn-export\" class=\"action-btn secondary\">予測結果エクスポート</button>\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>商品コード</th>\n            <th>商品名</th>\n            <th>カテゴリ</th>\n            <th>予測数量</th>\n            <th>予測精度</th>\n            <th>推奨発注数量</th>\n            <th>予測日</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"prediction-table-body\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 処理中表示 -->\n  <div id=\"processing-overlay\" class=\"processing-overlay hidden\">\n    <div class=\"processing-content\">\n      <div class=\"spinner\"></div>\n      <p>AI予測処理を実行中...</p>\n      <p class=\"muted\">しばらくお待ちください</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.demand-forecast-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.page-header {\n  margin-bottom: 30px;\n}\n\n.page-header h1 {\n  margin: 0 0 10px 0;\n  color: var(--text);\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.form-group label {\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.form-actions {\n  display: flex;\n  gap: 10px;\n  justify-content: flex-start;\n}\n\n.accuracy-metrics {\n  display: flex;\n  gap: 30px;\n  margin-bottom: 20px;\n  padding: 15px;\n  background: var(--bg-main);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.metric-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.metric-label {\n  font-size: 0.9em;\n  color: var(--text-muted);\n  margin-bottom: 5px;\n}\n\n.metric-value {\n  font-size: 1.2em;\n  font-weight: bold;\n  color: var(--primary);\n}\n\n.chart-container {\n  margin-bottom: 30px;\n}\n\n.chart-container h3 {\n  margin-bottom: 15px;\n  color: var(--text);\n}\n\n.chart-container canvas {\n  width: 100%;\n  max-width: 800px;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: var(--bg-card);\n}\n\n.factor-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n}\n\n.factor-item {\n  padding: 15px;\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.factor-item h4 {\n  margin: 0 0 10px 0;\n  color: var(--text);\n}\n\n.factor-content {\n  color: var(--text-muted);\n}\n\n.info-panels {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n\n.info-panel {\n  padding: 15px;\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.info-panel h4 {\n  margin: 0 0 10px 0;\n  color: var(--text);\n}\n\n.table-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.table-actions {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.processing-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.processing-content {\n  background: var(--bg-card);\n  padding: 40px;\n  border-radius: 8px;\n  text-align: center;\n  color: var(--text);\n}\n\n.spinner {\n  width: 40px;\n  height: 40px;\n  border: 4px solid var(--border);\n  border-top: 4px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n  margin: 0 auto 20px auto;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.error-message {\n  color: #ff6b6b;\n  font-size: 0.9em;\n  margin-top: 5px;\n}\n\n.success-message {\n  color: #51cf66;\n  font-size: 0.9em;\n  margin-top: 5px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}