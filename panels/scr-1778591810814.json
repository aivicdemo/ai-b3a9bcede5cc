{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div style=\"padding: 20px; background: var(--bg-main); min-height: 100vh;\">\n  <!-- ヘッダー -->\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;\">\n    <h1 style=\"color: var(--text); margin: 0; font-size: 24px; font-weight: 600;\">外部要因データ管理</h1>\n    <div style=\"display: flex; gap: 12px;\">\n      <button id=\"btn-correlation-analysis\" class=\"action-btn\">相関分析実行</button>\n      <button id=\"btn-export\" class=\"action-btn secondary\">データエクスポート</button>\n      <button id=\"btn-dashboard\" class=\"action-btn secondary\" onclick=\"window.showScreen('scr-1778591780173')\">ダッシュボード</button>\n    </div>\n  </div>\n\n  <!-- データ種別タブ -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <div style=\"display: flex; border-bottom: 1px solid var(--border);\">\n      <button id=\"tab-weather\" class=\"tab-btn active\" data-tab=\"weather\" style=\"padding: 12px 24px; background: none; border: none; color: var(--text); cursor: pointer; border-bottom: 2px solid var(--primary);\">天候</button>\n      <button id=\"tab-event\" class=\"tab-btn\" data-tab=\"event\" style=\"padding: 12px 24px; background: none; border: none; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent;\">イベント</button>\n      <button id=\"tab-season\" class=\"tab-btn\" data-tab=\"season\" style=\"padding: 12px 24px; background: none; border: none; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent;\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">検索・絞り込み</h3>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 12px; align-items: end;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">開始日</label>\n        <input type=\"date\" id=\"input-start-date\" class=\"input\" style=\"width: 100%;\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">終了日</label>\n        <input type=\"date\" id=\"input-end-date\" class=\"input\" style=\"width: 100%;\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">店舗</label>\n        <select id=\"select-store\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div id=\"data-type-filter\" style=\"display: none;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">データ種別</label>\n        <select id=\"select-data-type\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">全て</option>\n        </select>\n      </div>\n      <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    </div>\n  </div>\n\n  <!-- データ入力フォーム -->\n  <div id=\"form-weather\" class=\"card data-form\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">天候データ手動入力</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr) auto; gap: 12px; align-items: end;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">観測日 *</label>\n        <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">天気 *</label>\n        <select id=\"weather-condition\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">最高気温(℃)</label>\n        <input type=\"number\" id=\"weather-max-temp\" class=\"input\" placeholder=\"例: 25\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">最低気温(℃)</label>\n        <input type=\"number\" id=\"weather-min-temp\" class=\"input\" placeholder=\"例: 15\">\n      </div>\n      <button id=\"btn-save-weather\" class=\"action-btn\">登録</button>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 12px;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">降水量(mm)</label>\n        <input type=\"number\" id=\"weather-rainfall\" class=\"input\" placeholder=\"例: 10\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">湿度(%)</label>\n        <input type=\"number\" id=\"weather-humidity\" class=\"input\" placeholder=\"例: 60\" min=\"0\" max=\"100\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">風速(m/s)</label>\n        <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" placeholder=\"例: 3\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">店舗 *</label>\n        <select id=\"weather-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"form-event\" class=\"card data-form hidden\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">イベントデータ登録</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(3, 1fr) auto; gap: 12px; align-items: end;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">イベント名 *</label>\n        <input type=\"text\" id=\"event-name\" class=\"input\" required placeholder=\"例: 春祭り\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">開始日時 *</label>\n        <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">終了日時 *</label>\n        <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n      </div>\n      <button id=\"btn-save-event\" class=\"action-btn\">登録</button>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 12px;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">イベント種別 *</label>\n        <select id=\"event-type\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"祭り\">祭り</option>\n          <option value=\"コンサート\">コンサート</option>\n          <option value=\"スポーツ\">スポーツ</option>\n          <option value=\"セール\">セール</option>\n          <option value=\"地域イベント\">地域イベント</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">影響度 *</label>\n        <select id=\"event-impact\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"大\">大</option>\n          <option value=\"中\">中</option>\n          <option value=\"小\">小</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">予想来場者数</label>\n        <input type=\"number\" id=\"event-visitors\" class=\"input\" placeholder=\"例: 10000\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">店舗 *</label>\n        <select id=\"event-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"form-season\" class=\"card data-form hidden\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">季節情報設定</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr) auto; gap: 12px; align-items: end;\">\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">年 *</label>\n        <input type=\"number\" id=\"season-year\" class=\"input\" required placeholder=\"例: 2024\" min=\"2020\" max=\"2030\">\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">月 *</label>\n        <select id=\"season-month\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"1\">1月</option>\n          <option value=\"2\">2月</option>\n          <option value=\"3\">3月</option>\n          <option value=\"4\">4月</option>\n          <option value=\"5\">5月</option>\n          <option value=\"6\">6月</option>\n          <option value=\"7\">7月</option>\n          <option value=\"8\">8月</option>\n          <option value=\"9\">9月</option>\n          <option value=\"10\">10月</option>\n          <option value=\"11\">11月</option>\n          <option value=\"12\">12月</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">季節区分 *</label>\n        <select id=\"season-category\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"春\">春</option>\n          <option value=\"夏\">夏</option>\n          <option value=\"秋\">秋</option>\n          <option value=\"冬\">冬</option>\n          <option value=\"梅雨\">梅雨</option>\n          <option value=\"年末年始\">年末年始</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">季節係数 *</label>\n        <input type=\"number\" id=\"season-coefficient\" class=\"input\" required placeholder=\"例: 120\" min=\"0\" max=\"500\">\n      </div>\n      <button id=\"btn-save-season\" class=\"action-btn\">登録</button>\n    </div>\n  </div>\n\n  <!-- 外部API連携・スケジュール設定 -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">外部API連携・自動取得設定</h3>\n    <div style=\"display: flex; gap: 12px;\">\n      <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n      <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">データ自動取得スケジュール設定</button>\n      <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック実行</button>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\">\n      <h3 id=\"data-list-title\" style=\"color: var(--text); margin: 0; font-size: 16px;\">天候データ一覧</h3>\n      <div style=\"color: var(--text-muted); font-size: 14px;\">\n        <span id=\"data-count\">0</span> 件\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead id=\"table-header\">\n          <tr>\n            <th style=\"color: var(--text);\">観測日</th>\n            <th style=\"color: var(--text);\">店舗</th>\n            <th style=\"color: var(--text);\">天気</th>\n            <th style=\"color: var(--text);\">最高気温</th>\n            <th style=\"color: var(--text);\">最低気温</th>\n            <th style=\"color: var(--text);\">降水量</th>\n            <th style=\"color: var(--text);\">湿度</th>\n            <th style=\"color: var(--text);\">風速</th>\n            <th style=\"color: var(--text);\">操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"data-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- モーダル: API設定 -->\n  <div id=\"modal-api\" class=\"modal hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n    <div class=\"card\" style=\"width: 500px; max-height: 80vh; overflow-y: auto;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0;\">外部API連携設定</h3>\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">API名称 *</label>\n        <input type=\"text\" id=\"api-name\" class=\"input\" placeholder=\"例: 気象庁API\">\n      </div>\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">エンドポイントURL *</label>\n        <input type=\"url\" id=\"api-url\" class=\"input\" placeholder=\"https://api.example.com/weather\">\n      </div>\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">APIキー *</label>\n        <input type=\"text\" id=\"api-key\" class=\"input\" placeholder=\"APIキーを入力\">\n      </div>\n      <div style=\"margin-bottom: 16px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">取得頻度</label>\n        <select id=\"api-frequency\" class=\"input\">\n          <option value=\"毎日\">毎日</option>\n          <option value=\"毎時\">毎時</option>\n          <option value=\"週1回\">週1回</option>\n        </select>\n      </div>\n      <div style=\"display: flex; gap: 12px; justify-content: flex-end;\">\n        <button id=\"btn-api-test\" class=\"action-btn secondary\">接続テスト</button>\n        <button id=\"btn-api-save\" class=\"action-btn\">保存</button>\n        <button id=\"btn-api-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- モーダル: スケジュール設定 -->\n  <div id=\"modal-schedule\" class=\"modal hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n    <div class=\"card\" style=\"width: 500px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0;\">データ自動取得スケジュール設定</h3>\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">スケジュール名 *</label>\n        <input type=\"text\" id=\"schedule-name\" class=\"input\" placeholder=\"例: 天気データ取得\">\n      </div>\n      <div style=\"margin-bottom: 12px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">取得頻度 *</label>\n        <select id=\"schedule-frequency\" class=\"input\">\n          <option value=\"毎日\">毎日</option>\n          <option value=\"毎時\">毎時</option>\n          <option value=\"週1回\">週1回</option>\n        </select>\n      </div>\n      <div style=\"margin-bottom: 16px;\">\n        <label style=\"display: block; color: var(--text-muted); font-size: 12px; margin-bottom: 4px;\">取得時刻 *</label>\n        <input type=\"time\" id=\"schedule-time\" class=\"input\" value=\"06:00\">\n      </div>\n      <div style=\"display: flex; gap: 12px; justify-content: flex-end;\">\n        <button id=\"btn-schedule-save\" class=\"action-btn\">保存</button>\n        <button id=\"btn-schedule-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}