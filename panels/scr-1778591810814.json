{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2>外部要因データ管理</h2>\n  <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します。</p>\n</div>\n\n<!-- データ種別タブ -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div style=\"display: flex; border-bottom: 1px solid var(--border); margin-bottom: 20px;\">\n    <button id=\"tab-weather\" class=\"tab-btn active\" style=\"padding: 12px 24px; border: none; background: none; color: var(--text); border-bottom: 2px solid var(--primary); cursor: pointer;\">天候</button>\n    <button id=\"tab-event\" class=\"tab-btn\" style=\"padding: 12px 24px; border: none; background: none; color: var(--text-muted); border-bottom: 2px solid transparent; cursor: pointer;\">イベント</button>\n    <button id=\"tab-season\" class=\"tab-btn\" style=\"padding: 12px 24px; border: none; background: none; color: var(--text-muted); border-bottom: 2px solid transparent; cursor: pointer;\">季節</button>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div style=\"display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; align-items: end;\">\n    <div>\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">期間指定</label>\n      <div style=\"display: flex; gap: 10px; align-items: center;\">\n        <input type=\"date\" id=\"search-start-date\" class=\"input\" style=\"width: 150px;\">\n        <span style=\"color: var(--text-muted);\">〜</span>\n        <input type=\"date\" id=\"search-end-date\" class=\"input\" style=\"width: 150px;\">\n      </div>\n    </div>\n    <div>\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗</label>\n      <select id=\"search-store\" class=\"input\" style=\"width: 200px;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div id=\"weather-data-type\" style=\"display: block;\">\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データ種別</label>\n      <select id=\"weather-type-select\" class=\"input\" style=\"width: 150px;\">\n        <option value=\"\">全て</option>\n        <option value=\"気温\">気温</option>\n        <option value=\"降水量\">降水量</option>\n        <option value=\"湿度\">湿度</option>\n        <option value=\"風速\">風速</option>\n      </select>\n    </div>\n    <div id=\"event-data-type\" style=\"display: none;\">\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データ種別</label>\n      <select id=\"event-type-select\" class=\"input\" style=\"width: 150px;\">\n        <option value=\"\">全て</option>\n        <option value=\"祝日\">祝日</option>\n        <option value=\"スポーツイベント\">スポーツイベント</option>\n        <option value=\"地域イベント\">地域イベント</option>\n        <option value=\"セール\">セール</option>\n      </select>\n    </div>\n    <div id=\"season-data-type\" style=\"display: none;\">\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データ種別</label>\n      <select id=\"season-type-select\" class=\"input\" style=\"width: 150px;\">\n        <option value=\"\">全て</option>\n        <option value=\"気温\">気温</option>\n        <option value=\"湿度\">湿度</option>\n        <option value=\"降水量\">降水量</option>\n        <option value=\"日照時間\">日照時間</option>\n      </select>\n    </div>\n    <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n</div>\n\n<!-- データ一覧 -->\n<div class=\"card\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n    <h3 id=\"data-title\">天候データ一覧</h3>\n    <div>\n      <button id=\"btn-add-data\" class=\"action-btn\">新規登録</button>\n      <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n      <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">自動取得スケジュール設定</button>\n      <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n      <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n    </div>\n  </div>\n\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr id=\"table-header\">\n          <th>観測日</th>\n          <th>店舗</th>\n          <th>天気</th>\n          <th>最高気温</th>\n          <th>最低気温</th>\n          <th>降水量</th>\n          <th>湿度</th>\n          <th>データソース</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"data-tbody\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- データ登録モーダル -->\n<div id=\"data-modal\" class=\"modal\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;\">\n  <div class=\"modal-content\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); padding: 30px; border-radius: 8px; width: 90%; max-width: 600px; max-height: 90%; overflow-y: auto;\">\n    <h3 id=\"modal-title\">天候データ登録</h3>\n    \n    <!-- 天候データフォーム -->\n    <div id=\"weather-form\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;\">\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">観測日 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">天気 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-condition\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n            <option value=\"霧\">霧</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">最高気温 (℃)</label>\n          <input type=\"number\" id=\"weather-max-temp\" class=\"input\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">最低気温 (℃)</label>\n          <input type=\"number\" id=\"weather-min-temp\" class=\"input\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">平均気温 (℃)</label>\n          <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">降水量 (mm)</label>\n          <input type=\"number\" id=\"weather-rainfall\" class=\"input\" step=\"0.1\" min=\"0\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">湿度 (%)</label>\n          <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">風速 (m/s)</label>\n          <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" step=\"0.1\" min=\"0\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データ種別 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-data-type-input\" class=\"input\" required>\n            <option value=\"実績値\">実績値</option>\n            <option value=\"予報値\">予報値</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データソース <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"weather-data-source\" class=\"input\" placeholder=\"例: 気象庁API\" required>\n        </div>\n      </div>\n    </div>\n\n    <!-- イベントデータフォーム -->\n    <div id=\"event-form\" style=\"display: none;\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;\">\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">イベント名 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"event-name\" class=\"input\" required maxlength=\"100\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">イベント種別 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"祝日\">祝日</option>\n            <option value=\"スポーツイベント\">スポーツイベント</option>\n            <option value=\"地域イベント\">地域イベント</option>\n            <option value=\"セール\">セール</option>\n            <option value=\"コンサート\">コンサート</option>\n            <option value=\"祭り\">祭り</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">開始日時 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-start-date\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">終了日時 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-end-date\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">予想来場者数</label>\n          <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">影響度 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-impact\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"大\">大</option>\n            <option value=\"中\">中</option>\n            <option value=\"小\">小</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">場所 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"event-location\" class=\"input\" required maxlength=\"100\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗からの距離 (m)</label>\n          <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n        </div>\n      </div>\n      <div style=\"margin-bottom: 20px;\">\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">備考</label>\n        <textarea id=\"event-memo\" class=\"input\" rows=\"3\" maxlength=\"500\"></textarea>\n      </div>\n    </div>\n\n    <!-- 季節情報フォーム -->\n    <div id=\"season-form\" style=\"display: none;\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;\">\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">年 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"season-year\" class=\"input\" required min=\"2020\" max=\"2030\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">月 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"season-month\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"1\">1月</option>\n            <option value=\"2\">2月</option>\n            <option value=\"3\">3月</option>\n            <option value=\"4\">4月</option>\n            <option value=\"5\">5月</option>\n            <option value=\"6\">6月</option>\n            <option value=\"7\">7月</option>\n            <option value=\"8\">8月</option>\n            <option value=\"9\">9月</option>\n            <option value=\"10\">10月</option>\n            <option value=\"11\">11月</option>\n            <option value=\"12\">12月</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">日</label>\n          <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">季節区分 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"season-category\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"春\">春</option>\n            <option value=\"夏\">夏</option>\n            <option value=\"秋\">秋</option>\n            <option value=\"冬\">冬</option>\n            <option value=\"梅雨\">梅雨</option>\n            <option value=\"年末年始\">年末年始</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">季節係数 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"season-coefficient\" class=\"input\" required step=\"0.01\" min=\"0\">\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">温度帯区分</label>\n          <select id=\"season-temp-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"高温期\">高温期</option>\n            <option value=\"低温期\">低温期</option>\n            <option value=\"適温期\">適温期</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">学校暦区分</label>\n          <select id=\"season-school-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"新学期\">新学期</option>\n            <option value=\"夏休み\">夏休み</option>\n            <option value=\"冬休み\">冬休み</option>\n            <option value=\"春休み\">春休み</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">商戦期区分</label>\n          <select id=\"season-business-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"クリスマス商戦\">クリスマス商戦</option>\n            <option value=\"お中元\">お中元</option>\n            <option value=\"お歳暮\">お歳暮</option>\n            <option value=\"バレンタイン\">バレンタイン</option>\n          </select>\n        </div>\n      </div>\n      <div style=\"margin-bottom: 20px;\">\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">備考</label>\n        <textarea id=\"season-memo\" class=\"input\" rows=\"3\" maxlength=\"500\"></textarea>\n      </div>\n    </div>\n\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-modal-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-modal-save\" class=\"action-btn\">保存</button>\n    </div>\n  </div>\n</div>\n\n<!-- 品質チェック結果モーダル -->\n<div id=\"quality-modal\" class=\"modal\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;\">\n  <div class=\"modal-content\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); padding: 30px; border-radius: 8px; width: 90%; max-width: 800px; max-height: 90%; overflow-y: auto;\">\n    <h3>データ品質チェック結果</h3>\n    <div id=\"quality-results\" style=\"margin: 20px 0;\">\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px;\">\n        <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; text-align: center;\">\n          <div style=\"font-size: 24px; font-weight: bold; color: var(--primary);\" id=\"total-records\">0</div>\n          <div style=\"color: var(--text-muted);\">総レコード数</div>\n        </div>\n        <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; text-align: center;\">\n          <div style=\"font-size: 24px; font-weight: bold; color: #28a745;\" id=\"valid-records\">0</div>\n          <div style=\"color: var(--text-muted);\">正常レコード</div>\n        </div>\n        <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; text-align: center;\">\n          <div style=\"font-size: 24px; font-weight: bold; color: #ffc107;\" id=\"warning-records\">0</div>\n          <div style=\"color: var(--text-muted);\">警告レコード</div>\n        </div>\n        <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; text-align: center;\">\n          <div style=\"font-size: 24px; font-weight: bold; color: #dc3545;\" id=\"error-records\">0</div>\n          <div style=\"color: var(--text-muted);\">エラーレコード</div>\n        </div>\n      </div>\n      <div id=\"quality-details\"></div>\n    </div>\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-quality-close\" class=\"action-btn\">閉じる</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}