{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します</p>\n  </div>\n\n  <!-- データ種別タブ -->\n  <div class=\"tab-container\">\n    <div class=\"tab-buttons\">\n      <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n      <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n      <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card filter-section\">\n    <h3>検索・絞り込み</h3>\n    <div class=\"filter-grid\">\n      <div class=\"filter-item\">\n        <label>期間指定</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"filter-start-date\" class=\"input\" placeholder=\"開始日\">\n          <span>～</span>\n          <input type=\"date\" id=\"filter-end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n      <div class=\"filter-item\">\n        <label>店舗</label>\n        <select id=\"filter-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"filter-item\">\n        <label>キーワード</label>\n        <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"検索キーワード\">\n      </div>\n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索</button>\n        <button class=\"action-btn secondary\" id=\"btn-reset\">リセット</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 天候データタブ -->\n  <div class=\"tab-content active\" id=\"content-weather\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>天候データ管理</h3>\n        <div class=\"header-actions\">\n          <button class=\"action-btn\" id=\"btn-weather-register\">新規登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-weather-export\">CSVエクスポート</button>\n          <button class=\"action-btn secondary\" id=\"btn-api-settings\">外部API連携設定</button>\n        </div>\n      </div>\n      \n      <!-- 天候データ登録フォーム -->\n      <div class=\"form-section hidden\" id=\"weather-form\">\n        <h4>天候データ登録</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-item\">\n            <label>観測日 <span class=\"required\">*</span></label>\n            <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>店舗 <span class=\"required\">*</span></label>\n            <select id=\"weather-store\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>天気 <span class=\"required\">*</span></label>\n            <select id=\"weather-condition\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"晴れ\">晴れ</option>\n              <option value=\"曇り\">曇り</option>\n              <option value=\"雨\">雨</option>\n              <option value=\"雪\">雪</option>\n              <option value=\"台風\">台風</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>最高気温 (℃)</label>\n            <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-item\">\n            <label>最低気温 (℃)</label>\n            <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-item\">\n            <label>平均気温 (℃)</label>\n            <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-item\">\n            <label>降水量 (mm)</label>\n            <input type=\"number\" id=\"weather-precipitation\" class=\"input\" min=\"0\" max=\"999.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-item\">\n            <label>湿度 (%)</label>\n            <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n          </div>\n          <div class=\"form-item\">\n            <label>風速 (m/s)</label>\n            <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" min=\"0\" max=\"99.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-item\">\n            <label>データ種別 <span class=\"required\">*</span></label>\n            <select id=\"weather-data-type\" class=\"input\" required>\n              <option value=\"実績値\">実績値</option>\n              <option value=\"予報値\">予報値</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button class=\"action-btn\" id=\"btn-weather-save\">登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-weather-cancel\">キャンセル</button>\n        </div>\n      </div>\n\n      <!-- 天候データ一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"weather-table\">\n          <thead>\n            <tr>\n              <th>観測日</th>\n              <th>店舗名</th>\n              <th>天気</th>\n              <th>最高気温</th>\n              <th>最低気温</th>\n              <th>平均気温</th>\n              <th>降水量</th>\n              <th>湿度</th>\n              <th>風速</th>\n              <th>データ種別</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"weather-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベントデータタブ -->\n  <div class=\"tab-content\" id=\"content-event\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>イベントデータ管理</h3>\n        <div class=\"header-actions\">\n          <button class=\"action-btn\" id=\"btn-event-register\">新規登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-event-export\">CSVエクスポート</button>\n        </div>\n      </div>\n\n      <!-- イベントデータ登録フォーム -->\n      <div class=\"form-section hidden\" id=\"event-form\">\n        <h4>イベントデータ登録</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-item\">\n            <label>店舗 <span class=\"required\">*</span></label>\n            <select id=\"event-store\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>イベント名 <span class=\"required\">*</span></label>\n            <input type=\"text\" id=\"event-name\" class=\"input\" maxlength=\"255\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>イベント種別 <span class=\"required\">*</span></label>\n            <select id=\"event-type\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"祭り\">祭り</option>\n              <option value=\"コンサート\">コンサート</option>\n              <option value=\"スポーツ\">スポーツ</option>\n              <option value=\"セール\">セール</option>\n              <option value=\"展示会\">展示会</option>\n              <option value=\"その他\">その他</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>開始日時 <span class=\"required\">*</span></label>\n            <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>終了日時 <span class=\"required\">*</span></label>\n            <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>予想来場者数</label>\n            <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n          </div>\n          <div class=\"form-item\">\n            <label>影響度 <span class=\"required\">*</span></label>\n            <select id=\"event-impact\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"大\">大</option>\n              <option value=\"中\">中</option>\n              <option value=\"小\">小</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>場所 <span class=\"required\">*</span></label>\n            <input type=\"text\" id=\"event-location\" class=\"input\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>店舗からの距離 (m)</label>\n            <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n          </div>\n          <div class=\"form-item full-width\">\n            <label>備考</label>\n            <textarea id=\"event-notes\" class=\"input\" rows=\"3\"></textarea>\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button class=\"action-btn\" id=\"btn-event-save\">登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-event-cancel\">キャンセル</button>\n        </div>\n      </div>\n\n      <!-- イベントデータ一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"event-table\">\n          <thead>\n            <tr>\n              <th>店舗名</th>\n              <th>イベント名</th>\n              <th>種別</th>\n              <th>開始日時</th>\n              <th>終了日時</th>\n              <th>影響度</th>\n              <th>場所</th>\n              <th>距離</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"event-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- 季節情報タブ -->\n  <div class=\"tab-content\" id=\"content-season\">\n    <div class=\"card\">\n      <div class=\"card-header\">\n        <h3>季節情報管理</h3>\n        <div class=\"header-actions\">\n          <button class=\"action-btn\" id=\"btn-season-register\">新規登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-season-export\">CSVエクスポート</button>\n        </div>\n      </div>\n\n      <!-- 季節情報登録フォーム -->\n      <div class=\"form-section hidden\" id=\"season-form\">\n        <h4>季節情報登録</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-item\">\n            <label>年 <span class=\"required\">*</span></label>\n            <input type=\"number\" id=\"season-year\" class=\"input\" min=\"2020\" max=\"2030\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>月 <span class=\"required\">*</span></label>\n            <select id=\"season-month\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"1\">1月</option>\n              <option value=\"2\">2月</option>\n              <option value=\"3\">3月</option>\n              <option value=\"4\">4月</option>\n              <option value=\"5\">5月</option>\n              <option value=\"6\">6月</option>\n              <option value=\"7\">7月</option>\n              <option value=\"8\">8月</option>\n              <option value=\"9\">9月</option>\n              <option value=\"10\">10月</option>\n              <option value=\"11\">11月</option>\n              <option value=\"12\">12月</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>日</label>\n            <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n          </div>\n          <div class=\"form-item\">\n            <label>季節区分 <span class=\"required\">*</span></label>\n            <select id=\"season-category\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"春\">春</option>\n              <option value=\"夏\">夏</option>\n              <option value=\"秋\">秋</option>\n              <option value=\"冬\">冬</option>\n              <option value=\"梅雨\">梅雨</option>\n              <option value=\"年末年始\">年末年始</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>季節係数 (%) <span class=\"required\">*</span></label>\n            <input type=\"number\" id=\"season-coefficient\" class=\"input\" min=\"0\" max=\"1000\" required>\n          </div>\n          <div class=\"form-item\">\n            <label>温度帯区分</label>\n            <select id=\"season-temp-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"高温期\">高温期</option>\n              <option value=\"低温期\">低温期</option>\n              <option value=\"適温期\">適温期</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>学校暦区分</label>\n            <select id=\"season-school-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"新学期\">新学期</option>\n              <option value=\"夏休み\">夏休み</option>\n              <option value=\"冬休み\">冬休み</option>\n              <option value=\"春休み\">春休み</option>\n            </select>\n          </div>\n          <div class=\"form-item\">\n            <label>商戦期区分</label>\n            <select id=\"season-business-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"クリスマス商戦\">クリスマス商戦</option>\n              <option value=\"お中元\">お中元</option>\n              <option value=\"お歳暮\">お歳暮</option>\n              <option value=\"バレンタイン\">バレンタイン</option>\n            </select>\n          </div>\n          <div class=\"form-item full-width\">\n            <label>備考</label>\n            <textarea id=\"season-notes\" class=\"input\" rows=\"3\"></textarea>\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button class=\"action-btn\" id=\"btn-season-save\">登録</button>\n          <button class=\"action-btn secondary\" id=\"btn-season-cancel\">キャンセル</button>\n        </div>\n      </div>\n\n      <!-- 季節情報一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"season-table\">\n          <thead>\n            <tr>\n              <th>年</th>\n              <th>月</th>\n              <th>日</th>\n              <th>季節区分</th>\n              <th>季節係数</th>\n              <th>温度帯区分</th>\n              <th>学校暦区分</th>\n              <th>商戦期区分</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"season-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- 分析・設定セクション -->\n  <div class=\"card analysis-section\">\n    <h3>分析・設定</h3>\n    <div class=\"analysis-grid\">\n      <div class=\"analysis-item\">\n        <h4>データ自動取得設定</h4>\n        <p class=\"muted\">外部APIからのデータ自動取得スケジュールを設定</p>\n        <button class=\"action-btn secondary\" id=\"btn-schedule-settings\">スケジュール設定</button>\n      </div>\n      <div class=\"analysis-item\">\n        <h4>データ品質チェック</h4>\n        <p class=\"muted\">登録済みデータの品質をチェック</p>\n        <button class=\"action-btn secondary\" id=\"btn-quality-check\">品質チェック実行</button>\n      </div>\n      <div class=\"analysis-item\">\n        <h4>相関分析</h4>\n        <p class=\"muted\">外部要因と売上の相関関係を分析</p>\n        <button class=\"action-btn secondary\" id=\"btn-correlation-analysis\">相関分析実行</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ品質チェック結果 -->\n  <div class=\"card quality-results hidden\" id=\"quality-results\">\n    <h3>データ品質チェック結果</h3>\n    <div id=\"quality-content\"></div>\n  </div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 24px;\n}\n\n.page-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.tab-container {\n  margin-bottom: 24px;\n}\n\n.tab-buttons {\n  display: flex;\n  gap: 4px;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: var(--bg-card);\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-radius: 8px 8px 0 0;\n  transition: all 0.2s;\n}\n\n.tab-btn.active {\n  background: var(--primary);\n  color: white;\n}\n\n.tab-btn:hover:not(.active) {\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.tab-content {\n  display: none;\n}\n\n.tab-content.active {\n  display: block;\n}\n\n.filter-section {\n  margin-bottom: 24px;\n}\n\n.filter-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  align-items: end;\n}\n\n.filter-item label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 4px;\n  font-size: 14px;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.filter-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: between;\n  align-items: center;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.form-section {\n  background: var(--bg-main);\n  padding: 20px;\n  border-radius: 8px;\n  margin-bottom: 24px;\n  border: 1px solid var(--border);\n}\n\n.form-section h4 {\n  color: var(--text);\n  margin-bottom: 16px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 16px;\n  margin-bottom: 20px;\n}\n\n.form-item label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 4px;\n  font-size: 14px;\n}\n\n.form-item.full-width {\n  grid-column: 1 / -1;\n}\n\n.required {\n  color: #ff6a6a;\n}\n\n.form-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n}\n\n.analysis-section {\n  margin-top: 32px;\n}\n\n.analysis-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n}\n\n.analysis-item {\n  padding: 20px;\n  background: var(--bg-main);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.analysis-item h4 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.analysis-item p {\n  margin-bottom: 16px;\n}\n\n.quality-results {\n  margin-top: 24px;\n}\n\n#quality-content {\n  padding: 16px;\n  background: var(--bg-main);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.error-message {\n  color: #ff6a6a;\n  font-size: 14px;\n  margin-top: 4px;\n}\n\n.success-message {\n  color: #4caf50;\n  font-size: 14px;\n  margin-top: 4px;\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: bold;\n}\n\n.status-high {\n  background: rgba(255, 106, 106, 0.2);\n  color: #ff6a6a;\n}\n\n.status-medium {\n  background: rgba(255, 193, 7, 0.2);\n  color: #ffc107;\n}\n\n.status-low {\n  background: rgba(76, 175, 80, 0.2);\n  color: #4caf50;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}