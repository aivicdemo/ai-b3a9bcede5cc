{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します</p>\n  </div>\n\n  <!-- データ種別タブ -->\n  <div class=\"tab-container\">\n    <div class=\"tab-buttons\">\n      <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n      <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n      <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card\">\n    <div class=\"filter-section\">\n      <div class=\"filter-row\">\n        <div class=\"filter-item\">\n          <label>期間指定</label>\n          <div class=\"date-range\">\n            <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n            <span>～</span>\n            <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n          </div>\n        </div>\n        <div class=\"filter-item\">\n          <label>店舗</label>\n          <select id=\"store-filter\" class=\"input\">\n            <option value=\"\">全店舗</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <button id=\"btn-search\" class=\"action-btn\">検索</button>\n          <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3 id=\"data-title\">天候データ一覧</h3>\n      <div class=\"header-actions\">\n        <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n        <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n        <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n        <button id=\"btn-schedule\" class=\"action-btn secondary\">自動取得スケジュール</button>\n        <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n        <button id=\"btn-correlation\" class=\"action-btn secondary\">相関分析実行</button>\n      </div>\n    </div>\n    \n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr id=\"table-header\">\n            <th>観測日</th>\n            <th>天気</th>\n            <th>最高気温</th>\n            <th>最低気温</th>\n            <th>降水量</th>\n            <th>湿度</th>\n            <th>データ種別</th>\n            <th>更新日時</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"data-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 新規登録・編集フォーム -->\n  <div id=\"form-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3 id=\"form-title\">天候データ登録</h3>\n        <button id=\"btn-close-modal\" class=\"close-btn\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <!-- 天候データフォーム -->\n        <div id=\"weather-form\" class=\"form-content\">\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>店舗 <span class=\"required\">*</span></label>\n              <select id=\"weather-store\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n              </select>\n            </div>\n            <div class=\"form-item\">\n              <label>観測日 <span class=\"required\">*</span></label>\n              <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>天気 <span class=\"required\">*</span></label>\n              <select id=\"weather-condition\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"晴れ\">晴れ</option>\n                <option value=\"曇り\">曇り</option>\n                <option value=\"雨\">雨</option>\n                <option value=\"雪\">雪</option>\n                <option value=\"台風\">台風</option>\n              </select>\n            </div>\n            <div class=\"form-item\">\n              <label>データ種別 <span class=\"required\">*</span></label>\n              <select id=\"weather-type\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"実績値\">実績値</option>\n                <option value=\"予報値\">予報値</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>最高気温 (℃)</label>\n              <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n            </div>\n            <div class=\"form-item\">\n              <label>最低気温 (℃)</label>\n              <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>降水量 (mm)</label>\n              <input type=\"number\" id=\"weather-rainfall\" class=\"input\" min=\"0\" max=\"999.9\" step=\"0.1\">\n            </div>\n            <div class=\"form-item\">\n              <label>湿度 (%)</label>\n              <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>風速 (m/s)</label>\n              <input type=\"number\" id=\"weather-wind\" class=\"input\" min=\"0\" max=\"99.9\" step=\"0.1\">\n            </div>\n            <div class=\"form-item\">\n              <label>データソース <span class=\"required\">*</span></label>\n              <input type=\"text\" id=\"weather-source\" class=\"input\" required placeholder=\"例：気象庁API\">\n            </div>\n          </div>\n        </div>\n\n        <!-- イベントデータフォーム -->\n        <div id=\"event-form\" class=\"form-content hidden\">\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>店舗 <span class=\"required\">*</span></label>\n              <select id=\"event-store\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n              </select>\n            </div>\n            <div class=\"form-item\">\n              <label>イベント名 <span class=\"required\">*</span></label>\n              <input type=\"text\" id=\"event-name\" class=\"input\" required maxlength=\"255\">\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>イベント種別 <span class=\"required\">*</span></label>\n              <select id=\"event-type\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"祭り\">祭り</option>\n                <option value=\"コンサート\">コンサート</option>\n                <option value=\"スポーツ\">スポーツ</option>\n                <option value=\"セール\">セール</option>\n                <option value=\"その他\">その他</option>\n              </select>\n            </div>\n            <div class=\"form-item\">\n              <label>影響度 <span class=\"required\">*</span></label>\n              <select id=\"event-impact\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"大\">大</option>\n                <option value=\"中\">中</option>\n                <option value=\"小\">小</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>開始日時 <span class=\"required\">*</span></label>\n              <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n            </div>\n            <div class=\"form-item\">\n              <label>終了日時 <span class=\"required\">*</span></label>\n              <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>場所 <span class=\"required\">*</span></label>\n              <input type=\"text\" id=\"event-location\" class=\"input\" required>\n            </div>\n            <div class=\"form-item\">\n              <label>予想来場者数</label>\n              <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>店舗からの距離 (m)</label>\n              <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item full-width\">\n              <label>備考</label>\n              <textarea id=\"event-memo\" class=\"input\" rows=\"3\"></textarea>\n            </div>\n          </div>\n        </div>\n\n        <!-- 季節情報フォーム -->\n        <div id=\"season-form\" class=\"form-content hidden\">\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>年 <span class=\"required\">*</span></label>\n              <input type=\"number\" id=\"season-year\" class=\"input\" required min=\"2020\" max=\"2030\">\n            </div>\n            <div class=\"form-item\">\n              <label>月 <span class=\"required\">*</span></label>\n              <select id=\"season-month\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"1\">1月</option>\n                <option value=\"2\">2月</option>\n                <option value=\"3\">3月</option>\n                <option value=\"4\">4月</option>\n                <option value=\"5\">5月</option>\n                <option value=\"6\">6月</option>\n                <option value=\"7\">7月</option>\n                <option value=\"8\">8月</option>\n                <option value=\"9\">9月</option>\n                <option value=\"10\">10月</option>\n                <option value=\"11\">11月</option>\n                <option value=\"12\">12月</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>日</label>\n              <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n            </div>\n            <div class=\"form-item\">\n              <label>季節区分 <span class=\"required\">*</span></label>\n              <select id=\"season-category\" class=\"input\" required>\n                <option value=\"\">選択してください</option>\n                <option value=\"春\">春</option>\n                <option value=\"夏\">夏</option>\n                <option value=\"秋\">秋</option>\n                <option value=\"冬\">冬</option>\n                <option value=\"梅雨\">梅雨</option>\n                <option value=\"年末年始\">年末年始</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>季節係数 <span class=\"required\">*</span></label>\n              <input type=\"number\" id=\"season-coefficient\" class=\"input\" required min=\"0\" max=\"500\" placeholder=\"100が基準値\">\n            </div>\n            <div class=\"form-item\">\n              <label>温度帯区分</label>\n              <select id=\"season-temp-category\" class=\"input\">\n                <option value=\"\">選択してください</option>\n                <option value=\"高温期\">高温期</option>\n                <option value=\"低温期\">低温期</option>\n                <option value=\"適温期\">適温期</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item\">\n              <label>学校暦区分</label>\n              <select id=\"season-school\" class=\"input\">\n                <option value=\"\">選択してください</option>\n                <option value=\"新学期\">新学期</option>\n                <option value=\"夏休み\">夏休み</option>\n                <option value=\"冬休み\">冬休み</option>\n                <option value=\"春休み\">春休み</option>\n              </select>\n            </div>\n            <div class=\"form-item\">\n              <label>商戦期区分</label>\n              <select id=\"season-business\" class=\"input\">\n                <option value=\"\">選択してください</option>\n                <option value=\"クリスマス商戦\">クリスマス商戦</option>\n                <option value=\"お中元\">お中元</option>\n                <option value=\"お歳暮\">お歳暮</option>\n                <option value=\"バレンタイン\">バレンタイン</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-item full-width\">\n              <label>備考</label>\n              <textarea id=\"season-memo\" class=\"input\" rows=\"3\"></textarea>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button id=\"btn-save\" class=\"action-btn\">保存</button>\n        <button id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ -->\n  <div id=\"error-message\" class=\"error-message hidden\"></div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.page-header {\n  margin-bottom: 24px;\n}\n\n.page-header h1 {\n  margin: 0 0 8px 0;\n  color: var(--text);\n}\n\n.tab-container {\n  margin-bottom: 20px;\n}\n\n.tab-buttons {\n  display: flex;\n  gap: 2px;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: var(--bg-card);\n  border: none;\n  border-top: 2px solid transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.tab-btn.active {\n  background: var(--bg-main);\n  color: var(--text);\n  border-top-color: var(--primary);\n}\n\n.tab-btn:hover:not(.active) {\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.filter-section {\n  padding: 16px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 16px;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.filter-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.filter-item label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.card-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.header-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.close-btn:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.form-row {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.form-item {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.form-item.full-width {\n  flex: 1 1 100%;\n}\n\n.form-item label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6b6b;\n}\n\n.modal-footer {\n  padding: 16px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\n\n.error-message {\n  position: fixed;\n  top: 20px;\n  right: 20px;\n  background: #ff6b6b;\n  color: white;\n  padding: 12px 16px;\n  border-radius: 4px;\n  z-index: 1001;\n}\n\n@media (max-width: 768px) {\n  .filter-row {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .header-actions {\n    flex-direction: column;\n  }\n  \n  .form-row {\n    flex-direction: column;\n  }\n  \n  .modal-content {\n    width: 95%;\n    margin: 10px;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}