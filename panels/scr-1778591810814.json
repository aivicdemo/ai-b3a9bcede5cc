{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"screen-header\">\n  <h1>外部要因データ管理</h1>\n  <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します</p>\n</div>\n\n<!-- データ種別タブ -->\n<div class=\"tab-container\" style=\"margin-bottom: 20px;\">\n  <div class=\"tab-buttons\">\n    <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n    <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n    <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n  </div>\n</div>\n\n<!-- 検索・フィルター -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div class=\"search-filters\" style=\"display: flex; gap: 15px; align-items: end; flex-wrap: wrap;\">\n    <div>\n      <label>期間指定</label>\n      <div style=\"display: flex; gap: 8px; align-items: center;\">\n        <input type=\"date\" id=\"filter-start-date\" class=\"input\" style=\"width: 140px;\">\n        <span style=\"color: var(--text-muted);\">〜</span>\n        <input type=\"date\" id=\"filter-end-date\" class=\"input\" style=\"width: 140px;\">\n      </div>\n    </div>\n    <div>\n      <label>店舗</label>\n      <select id=\"filter-store\" class=\"input\" style=\"width: 200px;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div>\n      <label>キーワード</label>\n      <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"検索...\" style=\"width: 200px;\">\n    </div>\n    <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n  </div>\n</div>\n\n<!-- 操作ボタン -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n    <button id=\"btn-add\" class=\"action-btn\">新規登録</button>\n    <button id=\"btn-api-setting\" class=\"action-btn secondary\">外部API連携設定</button>\n    <button id=\"btn-schedule\" class=\"action-btn secondary\">自動取得スケジュール</button>\n    <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n    <button id=\"btn-correlation\" class=\"action-btn secondary\">相関分析実行</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">データエクスポート</button>\n  </div>\n</div>\n\n<!-- データ一覧 -->\n<div class=\"card\">\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr id=\"table-header\">\n          <!-- タブ切り替えで動的に変更 -->\n        </tr>\n      </thead>\n      <tbody id=\"data-tbody\">\n        <!-- データ行 -->\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 登録・編集モーダル -->\n<div id=\"modal-form\" class=\"modal\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;\">\n  <div class=\"modal-content\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); border-radius: 8px; padding: 24px; width: 90%; max-width: 600px; max-height: 80vh; overflow-y: auto;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h3 id=\"modal-title\">新規登録</h3>\n      <button id=\"btn-modal-close\" class=\"action-btn secondary\" style=\"padding: 4px 8px;\">×</button>\n    </div>\n    <form id=\"form-data\">\n      <div id=\"form-fields\">\n        <!-- タブに応じて動的に生成 -->\n      </div>\n      <div style=\"display: flex; gap: 10px; justify-content: end; margin-top: 20px;\">\n        <button type=\"button\" id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button type=\"submit\" id=\"btn-save\" class=\"action-btn\">保存</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<!-- API設定モーダル -->\n<div id=\"modal-api\" class=\"modal\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;\">\n  <div class=\"modal-content\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); border-radius: 8px; padding: 24px; width: 90%; max-width: 500px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h3>外部API連携設定</h3>\n      <button id=\"btn-api-close\" class=\"action-btn secondary\" style=\"padding: 4px 8px;\">×</button>\n    </div>\n    <div style=\"display: flex; flex-direction: column; gap: 15px;\">\n      <div>\n        <label>API URL</label>\n        <input type=\"url\" id=\"api-url\" class=\"input\" placeholder=\"https://api.example.com/weather\">\n      </div>\n      <div>\n        <label>認証キー</label>\n        <input type=\"text\" id=\"api-key\" class=\"input\" placeholder=\"API Key\">\n      </div>\n      <div>\n        <label>取得間隔（分）</label>\n        <input type=\"number\" id=\"api-interval\" class=\"input\" value=\"60\" min=\"1\">\n      </div>\n      <div style=\"display: flex; gap: 10px;\">\n        <button id=\"btn-api-test\" class=\"action-btn secondary\">接続テスト</button>\n        <button id=\"btn-api-save\" class=\"action-btn\">設定保存</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- スケジュール設定モーダル -->\n<div id=\"modal-schedule\" class=\"modal\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;\">\n  <div class=\"modal-content\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); border-radius: 8px; padding: 24px; width: 90%; max-width: 500px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h3>自動取得スケジュール設定</h3>\n      <button id=\"btn-schedule-close\" class=\"action-btn secondary\" style=\"padding: 4px 8px;\">×</button>\n    </div>\n    <div style=\"display: flex; flex-direction: column; gap: 15px;\">\n      <div>\n        <label>データ種別</label>\n        <select id=\"schedule-type\" class=\"input\">\n          <option value=\"weather\">天候データ</option>\n          <option value=\"event\">イベントデータ</option>\n        </select>\n      </div>\n      <div>\n        <label>実行頻度</label>\n        <select id=\"schedule-frequency\" class=\"input\">\n          <option value=\"daily\">毎日</option>\n          <option value=\"hourly\">毎時</option>\n          <option value=\"weekly\">毎週</option>\n        </select>\n      </div>\n      <div>\n        <label>実行時刻</label>\n        <input type=\"time\" id=\"schedule-time\" class=\"input\" value=\"08:00\">\n      </div>\n      <div style=\"display: flex; gap: 10px; justify-content: end;\">\n        <button id=\"btn-schedule-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button id=\"btn-schedule-save\" class=\"action-btn\">設定保存</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.tab-container {\n  border-bottom: 1px solid var(--border);\n}\n\n.tab-buttons {\n  display: flex;\n  gap: 0;\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: transparent;\n  border: none;\n  border-bottom: 2px solid transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  font-size: 14px;\n  transition: all 0.2s;\n}\n\n.tab-btn:hover {\n  color: var(--text);\n  background: var(--bg-card);\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n  background: var(--bg-card);\n}\n\n.modal {\n  backdrop-filter: blur(2px);\n}\n\n.search-filters label {\n  display: block;\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.quality-indicator {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  margin-right: 6px;\n}\n\n.quality-good { background: #22c55e; }\n.quality-warning { background: #f59e0b; }\n.quality-error { background: #ef4444; }\n\n.status-badge {\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.status-active { background: rgba(34, 197, 94, 0.1); color: #22c55e; }\n.status-inactive { background: rgba(107, 114, 128, 0.1); color: #6b7280; }\n.status-error { background: rgba(239, 68, 68, 0.1); color: #ef4444; }\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}