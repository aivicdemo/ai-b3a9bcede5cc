{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2>外部要因データ管理</h2>\n  <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します。</p>\n</div>\n\n<!-- データ種別選択タブ -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div style=\"display: flex; border-bottom: 1px solid var(--border); margin-bottom: 20px;\">\n    <button id=\"tab-weather\" class=\"tab-btn active\" data-tab=\"weather\" style=\"padding: 10px 20px; border: none; background: none; color: var(--text); border-bottom: 2px solid var(--primary); cursor: pointer;\">天候</button>\n    <button id=\"tab-event\" class=\"tab-btn\" data-tab=\"event\" style=\"padding: 10px 20px; border: none; background: none; color: var(--text-muted); border-bottom: 2px solid transparent; cursor: pointer;\">イベント</button>\n    <button id=\"tab-season\" class=\"tab-btn\" data-tab=\"season\" style=\"padding: 10px 20px; border: none; background: none; color: var(--text-muted); border-bottom: 2px solid transparent; cursor: pointer;\">季節</button>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr auto auto; gap: 15px; align-items: end; margin-bottom: 20px;\">\n    <div>\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">期間指定（開始日）</label>\n      <input type=\"date\" id=\"input-start-date\" class=\"input\" style=\"width: 100%;\">\n    </div>\n    <div>\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">期間指定（終了日）</label>\n      <input type=\"date\" id=\"input-end-date\" class=\"input\" style=\"width: 100%;\">\n    </div>\n    <div>\n      <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗選択</label>\n      <select id=\"select-store\" class=\"input\" style=\"width: 100%;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n</div>\n\n<!-- データ入力フォーム -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h3 id=\"form-title\">天候データ手動入力</h3>\n  \n  <!-- 天候データフォーム -->\n  <div id=\"weather-form\" class=\"data-form\">\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">観測日 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"weather-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">天気 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"weather-condition\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">最高気温（℃）</label>\n        <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">最低気温（℃）</label>\n        <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">平均気温（℃）</label>\n        <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" min=\"-50\" max=\"99.9\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">降水量（mm）</label>\n        <input type=\"number\" id=\"weather-rainfall\" class=\"input\" min=\"0\" max=\"999.9\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">湿度（%）</label>\n        <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">風速（m/s）</label>\n        <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" min=\"0\" max=\"99.9\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">データソース</label>\n        <select id=\"weather-source\" class=\"input\">\n          <option value=\"手動入力\">手動入力</option>\n          <option value=\"気象庁API\">気象庁API</option>\n          <option value=\"外部API\">外部API</option>\n        </select>\n      </div>\n      <div style=\"display: flex; align-items: end; gap: 10px;\">\n        <button id=\"btn-save-weather\" class=\"action-btn\">登録</button>\n        <button id=\"btn-clear-weather\" class=\"action-btn secondary\">クリア</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベントデータフォーム -->\n  <div id=\"event-form\" class=\"data-form hidden\">\n    <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">イベント名 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"text\" id=\"event-name\" class=\"input\" maxlength=\"255\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"event-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">イベント種別 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"event-type\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"祭り\">祭り</option>\n          <option value=\"コンサート\">コンサート</option>\n          <option value=\"スポーツ\">スポーツ</option>\n          <option value=\"セール\">セール</option>\n          <option value=\"その他\">その他</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">開始日時 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">終了日時 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">予想来場者数</label>\n        <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">影響度 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"event-impact\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"大\">大</option>\n          <option value=\"中\">中</option>\n          <option value=\"小\">小</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">場所 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"text\" id=\"event-location\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">店舗からの距離（m）</label>\n        <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">備考</label>\n        <textarea id=\"event-memo\" class=\"input\" rows=\"2\"></textarea>\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 10px;\">\n      <button id=\"btn-save-event\" class=\"action-btn\">登録</button>\n      <button id=\"btn-clear-event\" class=\"action-btn secondary\">クリア</button>\n    </div>\n  </div>\n\n  <!-- 季節情報フォーム -->\n  <div id=\"season-form\" class=\"data-form hidden\">\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">年 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"season-year\" class=\"input\" min=\"2020\" max=\"2030\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">月 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"season-month\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"1\">1月</option>\n          <option value=\"2\">2月</option>\n          <option value=\"3\">3月</option>\n          <option value=\"4\">4月</option>\n          <option value=\"5\">5月</option>\n          <option value=\"6\">6月</option>\n          <option value=\"7\">7月</option>\n          <option value=\"8\">8月</option>\n          <option value=\"9\">9月</option>\n          <option value=\"10\">10月</option>\n          <option value=\"11\">11月</option>\n          <option value=\"12\">12月</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">日</label>\n        <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">季節区分 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"season-category\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"春\">春</option>\n          <option value=\"夏\">夏</option>\n          <option value=\"秋\">秋</option>\n          <option value=\"冬\">冬</option>\n          <option value=\"梅雨\">梅雨</option>\n          <option value=\"年末年始\">年末年始</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">季節係数 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"season-coefficient\" class=\"input\" min=\"0\" max=\"500\" required>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">温度帯区分</label>\n        <select id=\"season-temp-category\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"高温期\">高温期</option>\n          <option value=\"低温期\">低温期</option>\n          <option value=\"適温期\">適温期</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">学校暦区分</label>\n        <select id=\"season-school-category\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"新学期\">新学期</option>\n          <option value=\"夏休み\">夏休み</option>\n          <option value=\"冬休み\">冬休み</option>\n          <option value=\"春休み\">春休み</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">商戦期区分</label>\n        <select id=\"season-business-category\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"クリスマス商戦\">クリスマス商戦</option>\n          <option value=\"お中元\">お中元</option>\n          <option value=\"お歳暮\">お歳暮</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text);\">備考</label>\n        <textarea id=\"season-memo\" class=\"input\" rows=\"2\"></textarea>\n      </div>\n      <div style=\"display: flex; align-items: end; gap: 10px;\">\n        <button id=\"btn-save-season\" class=\"action-btn\">登録</button>\n        <button id=\"btn-clear-season\" class=\"action-btn secondary\">クリア</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- 機能ボタンエリア -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n    <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n    <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">データ自動取得スケジュール設定</button>\n    <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック実行</button>\n    <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n  </div>\n</div>\n\n<!-- データ一覧 -->\n<div class=\"card\">\n  <h3 id=\"list-title\">天候データ一覧</h3>\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr id=\"table-header\">\n          <th>観測日</th>\n          <th>店舗名</th>\n          <th>天気</th>\n          <th>最高気温</th>\n          <th>最低気温</th>\n          <th>降水量</th>\n          <th>湿度</th>\n          <th>データソース</th>\n          <th>更新日時</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"data-tbody\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- 編集モーダル -->\n<div id=\"edit-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 800px; max-height: 90%; overflow-y: auto;\">\n    <h3 id=\"edit-modal-title\">データ編集</h3>\n    <div id=\"edit-form-content\"></div>\n    <div style=\"display: flex; gap: 10px; margin-top: 20px;\">\n      <button id=\"btn-update\" class=\"action-btn\">更新</button>\n      <button id=\"btn-cancel-edit\" class=\"action-btn secondary\">キャンセル</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}