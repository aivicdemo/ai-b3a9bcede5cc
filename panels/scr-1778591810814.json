{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー部分 -->\n  <div class=\"page-header\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します。</p>\n  </div>\n\n  <!-- データ種別タブ -->\n  <div class=\"tab-container\">\n    <div class=\"tab-buttons\">\n      <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n      <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n      <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター部分 -->\n  <div class=\"card\">\n    <div class=\"filter-section\">\n      <div class=\"filter-row\">\n        <div class=\"filter-group\">\n          <label>期間指定</label>\n          <input type=\"date\" id=\"filter-start-date\" class=\"input\">\n          <span>～</span>\n          <input type=\"date\" id=\"filter-end-date\" class=\"input\">\n        </div>\n        <div class=\"filter-group\">\n          <label>店舗</label>\n          <select id=\"filter-store\" class=\"input\">\n            <option value=\"\">全店舗</option>\n          </select>\n        </div>\n        <div class=\"filter-group\">\n          <label>データ種別</label>\n          <select id=\"filter-data-type\" class=\"input\">\n            <option value=\"\">全て</option>\n          </select>\n        </div>\n        <button id=\"btn-search\" class=\"action-btn\">検索</button>\n        <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ一覧表示 -->\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3 id=\"data-list-title\">外部要因データ一覧</h3>\n      <div class=\"header-actions\">\n        <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n        <button id=\"btn-correlation-analysis\" class=\"action-btn\">相関分析実行</button>\n        <button id=\"btn-quality-check\" class=\"action-btn\">データ品質チェック</button>\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr id=\"table-header\">\n            <th>データ種別</th>\n            <th>店舗</th>\n            <th>日付</th>\n            <th>詳細</th>\n            <th>ステータス</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"data-table-body\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 天候データ入力フォーム -->\n  <div class=\"card tab-content\" id=\"weather-form\" style=\"display: none;\">\n    <div class=\"card-header\">\n      <h3>天候データ手動入力</h3>\n    </div>\n    <form id=\"weather-data-form\">\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>店舗 <span class=\"required\">*</span></label>\n          <select id=\"weather-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>観測日 <span class=\"required\">*</span></label>\n          <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>天気 <span class=\"required\">*</span></label>\n          <select id=\"weather-condition\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n            <option value=\"霧\">霧</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>最高気温 (℃)</label>\n          <input type=\"number\" id=\"weather-max-temp\" class=\"input\" step=\"0.1\">\n        </div>\n        <div class=\"form-group\">\n          <label>最低気温 (℃)</label>\n          <input type=\"number\" id=\"weather-min-temp\" class=\"input\" step=\"0.1\">\n        </div>\n        <div class=\"form-group\">\n          <label>平均気温 (℃)</label>\n          <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" step=\"0.1\">\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>降水量 (mm)</label>\n          <input type=\"number\" id=\"weather-rainfall\" class=\"input\" step=\"0.1\" min=\"0\">\n        </div>\n        <div class=\"form-group\">\n          <label>湿度 (%)</label>\n          <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n        <div class=\"form-group\">\n          <label>風速 (m/s)</label>\n          <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" step=\"0.1\" min=\"0\">\n        </div>\n        <div class=\"form-group\">\n          <label>データソース <span class=\"required\">*</span></label>\n          <select id=\"weather-data-source\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"気象庁\">気象庁</option>\n            <option value=\"手動入力\">手動入力</option>\n            <option value=\"外部API\">外部API</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button type=\"submit\" id=\"btn-save-weather\" class=\"action-btn\">登録</button>\n        <button type=\"button\" id=\"btn-clear-weather\" class=\"action-btn secondary\">クリア</button>\n      </div>\n    </form>\n  </div>\n\n  <!-- イベントデータ入力フォーム -->\n  <div class=\"card tab-content\" id=\"event-form\" style=\"display: none;\">\n    <div class=\"card-header\">\n      <h3>イベントデータ登録</h3>\n    </div>\n    <form id=\"event-data-form\">\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>店舗 <span class=\"required\">*</span></label>\n          <select id=\"event-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>イベント名 <span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"event-name\" class=\"input\" required maxlength=\"100\">\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>イベント種別 <span class=\"required\">*</span></label>\n          <select id=\"event-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"祭り\">祭り</option>\n            <option value=\"コンサート\">コンサート</option>\n            <option value=\"スポーツ\">スポーツ</option>\n            <option value=\"セール\">セール</option>\n            <option value=\"地域イベント\">地域イベント</option>\n            <option value=\"祝日\">祝日</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>開始日時 <span class=\"required\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-start-date\" class=\"input\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>終了日時 <span class=\"required\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-end-date\" class=\"input\" required>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>予想来場者数</label>\n          <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n        </div>\n        <div class=\"form-group\">\n          <label>影響度 <span class=\"required\">*</span></label>\n          <select id=\"event-impact\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"大\">大</option>\n            <option value=\"中\">中</option>\n            <option value=\"小\">小</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>場所 <span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"event-location\" class=\"input\" required maxlength=\"100\">\n        </div>\n        <div class=\"form-group\">\n          <label>店舗からの距離 (m)</label>\n          <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group full-width\">\n          <label>備考</label>\n          <textarea id=\"event-memo\" class=\"input\" rows=\"3\" maxlength=\"500\"></textarea>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button type=\"submit\" id=\"btn-save-event\" class=\"action-btn\">登録</button>\n        <button type=\"button\" id=\"btn-clear-event\" class=\"action-btn secondary\">クリア</button>\n      </div>\n    </form>\n  </div>\n\n  <!-- 季節情報設定フォーム -->\n  <div class=\"card tab-content\" id=\"season-form\" style=\"display: none;\">\n    <div class=\"card-header\">\n      <h3>季節情報設定</h3>\n    </div>\n    <form id=\"season-data-form\">\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>年 <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"season-year\" class=\"input\" required min=\"2020\" max=\"2030\">\n        </div>\n        <div class=\"form-group\">\n          <label>月 <span class=\"required\">*</span></label>\n          <select id=\"season-month\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"1\">1月</option>\n            <option value=\"2\">2月</option>\n            <option value=\"3\">3月</option>\n            <option value=\"4\">4月</option>\n            <option value=\"5\">5月</option>\n            <option value=\"6\">6月</option>\n            <option value=\"7\">7月</option>\n            <option value=\"8\">8月</option>\n            <option value=\"9\">9月</option>\n            <option value=\"10\">10月</option>\n            <option value=\"11\">11月</option>\n            <option value=\"12\">12月</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>日</label>\n          <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>季節区分 <span class=\"required\">*</span></label>\n          <select id=\"season-category\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"春\">春</option>\n            <option value=\"夏\">夏</option>\n            <option value=\"秋\">秋</option>\n            <option value=\"冬\">冬</option>\n            <option value=\"梅雨\">梅雨</option>\n            <option value=\"年末年始\">年末年始</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>季節係数 (%) <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"season-coefficient\" class=\"input\" required min=\"0\" max=\"500\" value=\"100\">\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label>温度帯区分</label>\n          <select id=\"season-temp-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"高温期\">高温期</option>\n            <option value=\"低温期\">低温期</option>\n            <option value=\"適温期\">適温期</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>学校暦区分</label>\n          <select id=\"season-school-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"新学期\">新学期</option>\n            <option value=\"夏休み\">夏休み</option>\n            <option value=\"冬休み\">冬休み</option>\n            <option value=\"春休み\">春休み</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>商戦期区分</label>\n          <select id=\"season-business-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"クリスマス商戦\">クリスマス商戦</option>\n            <option value=\"お中元\">お中元</option>\n            <option value=\"お歳暮\">お歳暮</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group full-width\">\n          <label>備考</label>\n          <textarea id=\"season-memo\" class=\"input\" rows=\"3\" maxlength=\"500\"></textarea>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button type=\"submit\" id=\"btn-save-season\" class=\"action-btn\">保存</button>\n        <button type=\"button\" id=\"btn-clear-season\" class=\"action-btn secondary\">クリア</button>\n      </div>\n    </form>\n  </div>\n\n  <!-- 外部API連携・スケジュール設定 -->\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3>外部API連携・自動取得設定</h3>\n    </div>\n    <div class=\"api-settings\">\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <button id=\"btn-api-settings\" class=\"action-btn\">外部API連携設定</button>\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-schedule-settings\" class=\"action-btn\">データ自動取得スケジュール設定</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 品質チェック結果表示エリア -->\n  <div class=\"card\" id=\"quality-check-results\" style=\"display: none;\">\n    <div class=\"card-header\">\n      <h3>データ品質チェック結果</h3>\n    </div>\n    <div id=\"quality-check-content\">\n      <!-- 品質チェック結果がここに表示される -->\n    </div>\n  </div>\n\n  <!-- 相関分析結果表示エリア -->\n  <div class=\"card\" id=\"correlation-results\" style=\"display: none;\">\n    <div class=\"card-header\">\n      <h3>相関分析結果</h3>\n    </div>\n    <div id=\"correlation-content\">\n      <!-- 相関分析結果がここに表示される -->\n    </div>\n  </div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 24px;\n}\n\n.page-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.tab-container {\n  margin-bottom: 20px;\n}\n\n.tab-buttons {\n  display: flex;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 3px solid transparent;\n  transition: all 0.2s;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.filter-section {\n  padding: 16px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 16px;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.filter-group label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.filter-group span {\n  align-self: center;\n  margin: 0 8px;\n  color: var(--text-muted);\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.card-header h3 {\n  color: var(--text);\n  margin: 0;\n}\n\n.header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.tab-content {\n  margin-top: 20px;\n}\n\n.form-row {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 16px;\n  flex-wrap: wrap;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  flex: 1;\n  min-width: 200px;\n}\n\n.form-group.full-width {\n  flex: 100%;\n}\n\n.form-group label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6a00;\n}\n\n.form-actions {\n  display: flex;\n  gap: 12px;\n  padding-top: 16px;\n  border-top: 1px solid var(--border);\n}\n\n.api-settings {\n  padding: 16px;\n}\n\n#quality-check-content,\n#correlation-content {\n  padding: 16px;\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.status-success {\n  background: rgba(34, 197, 94, 0.1);\n  color: #22c55e;\n}\n\n.status-warning {\n  background: rgba(251, 191, 36, 0.1);\n  color: #fbbf24;\n}\n\n.status-error {\n  background: rgba(239, 68, 68, 0.1);\n  color: #ef4444;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}