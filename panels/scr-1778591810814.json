{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー部分 -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h2 style=\"color: var(--text); margin: 0 0 20px 0;\">外部要因データ管理</h2>\n    \n    <!-- タブメニュー -->\n    <div class=\"tab-menu\" style=\"border-bottom: 1px solid var(--border); margin-bottom: 20px;\">\n      <button id=\"tab-weather\" class=\"tab-btn active\" data-tab=\"weather\">天候</button>\n      <button id=\"tab-event\" class=\"tab-btn\" data-tab=\"event\">イベント</button>\n      <button id=\"tab-season\" class=\"tab-btn\" data-tab=\"season\">季節</button>\n    </div>\n\n    <!-- 検索・フィルター部分 -->\n    <div class=\"filter-section\" style=\"display: flex; gap: 15px; flex-wrap: wrap; align-items: end; margin-bottom: 20px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">期間指定</label>\n        <div style=\"display: flex; gap: 10px; align-items: center;\">\n          <input type=\"date\" id=\"filter-start-date\" class=\"input\" style=\"width: 150px;\">\n          <span style=\"color: var(--text-muted);\">〜</span>\n          <input type=\"date\" id=\"filter-end-date\" class=\"input\" style=\"width: 150px;\">\n        </div>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗</label>\n        <select id=\"filter-store\" class=\"input\" style=\"width: 200px;\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <button id=\"btn-search\" class=\"action-btn\">検索</button>\n      <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n    </div>\n  </div>\n\n  <!-- データ入力フォーム -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 id=\"form-title\" style=\"color: var(--text); margin: 0 0 15px 0;\">天候データ登録</h3>\n    \n    <!-- 天候データフォーム -->\n    <div id=\"weather-form\" class=\"data-form\">\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">観測日 *</label>\n          <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 *</label>\n          <select id=\"weather-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">天気 *</label>\n          <select id=\"weather-condition\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n            <option value=\"霧\">霧</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">最高気温 (℃)</label>\n          <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">最低気温 (℃)</label>\n          <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">降水量 (mm)</label>\n          <input type=\"number\" id=\"weather-precipitation\" class=\"input\" min=\"0\" max=\"999.9\" step=\"0.1\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">湿度 (%)</label>\n          <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">風速 (m/s)</label>\n          <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" min=\"0\" max=\"99.9\" step=\"0.1\">\n        </div>\n      </div>\n      <button id=\"btn-save-weather\" class=\"action-btn\">天候データ登録</button>\n    </div>\n\n    <!-- イベントデータフォーム -->\n    <div id=\"event-form\" class=\"data-form hidden\">\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">イベント名 *</label>\n          <input type=\"text\" id=\"event-name\" class=\"input\" maxlength=\"255\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 *</label>\n          <select id=\"event-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">イベント種別 *</label>\n          <select id=\"event-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"祭り\">祭り</option>\n            <option value=\"コンサート\">コンサート</option>\n            <option value=\"スポーツ\">スポーツ</option>\n            <option value=\"セール\">セール</option>\n            <option value=\"その他\">その他</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">開始日時 *</label>\n          <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">終了日時 *</label>\n          <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">影響度 *</label>\n          <select id=\"event-impact\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"大\">大</option>\n            <option value=\"中\">中</option>\n            <option value=\"小\">小</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">予想来場者数</label>\n          <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">場所 *</label>\n          <input type=\"text\" id=\"event-location\" class=\"input\" required>\n        </div>\n      </div>\n      <div style=\"margin-bottom: 15px;\">\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">備考</label>\n        <textarea id=\"event-notes\" class=\"input\" rows=\"3\" style=\"width: 100%; resize: vertical;\"></textarea>\n      </div>\n      <button id=\"btn-save-event\" class=\"action-btn\">イベントデータ登録</button>\n    </div>\n\n    <!-- 季節情報フォーム -->\n    <div id=\"season-form\" class=\"data-form hidden\">\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">年 *</label>\n          <input type=\"number\" id=\"season-year\" class=\"input\" min=\"2020\" max=\"2030\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">月 *</label>\n          <select id=\"season-month\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"1\">1月</option>\n            <option value=\"2\">2月</option>\n            <option value=\"3\">3月</option>\n            <option value=\"4\">4月</option>\n            <option value=\"5\">5月</option>\n            <option value=\"6\">6月</option>\n            <option value=\"7\">7月</option>\n            <option value=\"8\">8月</option>\n            <option value=\"9\">9月</option>\n            <option value=\"10\">10月</option>\n            <option value=\"11\">11月</option>\n            <option value=\"12\">12月</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">日</label>\n          <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">季節区分 *</label>\n          <select id=\"season-category\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"春\">春</option>\n            <option value=\"夏\">夏</option>\n            <option value=\"秋\">秋</option>\n            <option value=\"冬\">冬</option>\n            <option value=\"梅雨\">梅雨</option>\n            <option value=\"年末年始\">年末年始</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">季節係数 (%) *</label>\n          <input type=\"number\" id=\"season-coefficient\" class=\"input\" min=\"0\" max=\"500\" required>\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">商戦期区分</label>\n          <select id=\"season-business\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"クリスマス商戦\">クリスマス商戦</option>\n            <option value=\"お中元\">お中元</option>\n            <option value=\"お歳暮\">お歳暮</option>\n            <option value=\"新学期\">新学期</option>\n            <option value=\"ゴールデンウィーク\">ゴールデンウィーク</option>\n          </select>\n        </div>\n      </div>\n      <div style=\"margin-bottom: 15px;\">\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">備考</label>\n        <textarea id=\"season-notes\" class=\"input\" rows=\"3\" style=\"width: 100%; resize: vertical;\"></textarea>\n      </div>\n      <button id=\"btn-save-season\" class=\"action-btn\">季節情報登録</button>\n    </div>\n  </div>\n\n  <!-- 機能ボタン -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">データ管理機能</h3>\n    <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n      <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n      <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">自動取得スケジュール設定</button>\n      <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n      <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;\">\n      <h3 id=\"list-title\" style=\"color: var(--text); margin: 0;\">天候データ一覧</h3>\n      <div style=\"color: var(--text-muted);\">\n        <span id=\"data-count\">0</span> 件\n      </div>\n    </div>\n    \n    <div class=\"table-wrap\">\n      <table>\n        <thead id=\"table-header\">\n          <tr>\n            <th style=\"color: var(--text);\">観測日</th>\n            <th style=\"color: var(--text);\">店舗</th>\n            <th style=\"color: var(--text);\">天気</th>\n            <th style=\"color: var(--text);\">最高気温</th>\n            <th style=\"color: var(--text);\">最低気温</th>\n            <th style=\"color: var(--text);\">降水量</th>\n            <th style=\"color: var(--text);\">湿度</th>\n            <th style=\"color: var(--text);\">風速</th>\n            <th style=\"color: var(--text);\">データソース</th>\n            <th style=\"color: var(--text);\">操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"data-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<style>\n.external-factors-management .tab-menu {\n  display: flex;\n  gap: 0;\n}\n\n.external-factors-management .tab-btn {\n  padding: 10px 20px;\n  border: 1px solid var(--border);\n  border-bottom: none;\n  background: var(--bg-main);\n  color: var(--text-muted);\n  cursor: pointer;\n  border-radius: 5px 5px 0 0;\n  transition: all 0.2s;\n}\n\n.external-factors-management .tab-btn:first-child {\n  border-radius: 5px 0 0 0;\n}\n\n.external-factors-management .tab-btn:last-child {\n  border-radius: 0 5px 0 0;\n}\n\n.external-factors-management .tab-btn.active {\n  background: var(--bg-card);\n  color: var(--text);\n  border-bottom: 1px solid var(--bg-card);\n  margin-bottom: -1px;\n}\n\n.external-factors-management .tab-btn:hover:not(.active) {\n  background: var(--bg-sidebar);\n}\n\n.external-factors-management .data-form {\n  padding: 20px;\n  background: var(--bg-main);\n  border-radius: 5px;\n  border: 1px solid var(--border);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}