{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"screen-header\">\n  <h1>外部要因データ管理</h1>\n  <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析</p>\n</div>\n\n<div class=\"tab-container\">\n  <div class=\"tab-buttons\">\n    <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n    <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n    <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n  </div>\n</div>\n\n<div class=\"search-filters card\">\n  <div class=\"filter-row\">\n    <div class=\"filter-group\">\n      <label>期間指定</label>\n      <input type=\"date\" id=\"input-start-date\" class=\"input\" placeholder=\"開始日\">\n      <span>～</span>\n      <input type=\"date\" id=\"input-end-date\" class=\"input\" placeholder=\"終了日\">\n    </div>\n    <div class=\"filter-group\">\n      <label>店舗</label>\n      <select id=\"select-store\" class=\"input\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div class=\"filter-group\">\n      <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"キーワード検索\">\n    </div>\n    <button id=\"btn-search\" class=\"action-btn\">検索</button>\n  </div>\n</div>\n\n<div class=\"action-bar\">\n  <div class=\"action-left\">\n    <button id=\"btn-new\" class=\"action-btn\">新規登録</button>\n    <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n    <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">自動取得スケジュール設定</button>\n  </div>\n  <div class=\"action-right\">\n    <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n    <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n</div>\n\n<div class=\"table-wrap\">\n  <table>\n    <thead>\n      <tr id=\"table-header\">\n        <th>日付</th>\n        <th>店舗</th>\n        <th>天気</th>\n        <th>最高気温</th>\n        <th>最低気温</th>\n        <th>降水量</th>\n        <th>湿度</th>\n        <th>データソース</th>\n        <th>更新日時</th>\n        <th>操作</th>\n      </tr>\n    </thead>\n    <tbody id=\"data-tbody\">\n    </tbody>\n  </table>\n</div>\n\n<div id=\"modal-form\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3 id=\"modal-title\">天候データ登録</h3>\n      <button id=\"modal-close\" class=\"close-btn\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <form id=\"data-form\">\n        <div id=\"form-fields\">\n          <!-- 動的に生成される -->\n        </div>\n        <div class=\"form-actions\">\n          <button type=\"button\" id=\"btn-save\" class=\"action-btn\">保存</button>\n          <button type=\"button\" id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n\n<div id=\"modal-api-settings\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>外部API連携設定</h3>\n      <button class=\"close-btn\" onclick=\"this.closest('.modal').classList.add('hidden')\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>API URL</label>\n        <input type=\"url\" id=\"api-url\" class=\"input\" placeholder=\"https://api.weather.com/v1/data\">\n      </div>\n      <div class=\"form-group\">\n        <label>認証キー</label>\n        <input type=\"text\" id=\"api-key\" class=\"input\" placeholder=\"API Key\">\n      </div>\n      <div class=\"form-group\">\n        <label>データ取得間隔</label>\n        <select id=\"api-interval\" class=\"input\">\n          <option value=\"1\">1時間</option>\n          <option value=\"6\">6時間</option>\n          <option value=\"24\">24時間</option>\n        </select>\n      </div>\n      <div class=\"form-actions\">\n        <button type=\"button\" id=\"btn-test-connection\" class=\"action-btn secondary\">接続テスト</button>\n        <button type=\"button\" id=\"btn-save-api-settings\" class=\"action-btn\">保存</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id=\"modal-schedule-settings\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>データ自動取得スケジュール設定</h3>\n      <button class=\"close-btn\" onclick=\"this.closest('.modal').classList.add('hidden')\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>データソース種別</label>\n        <select id=\"schedule-data-type\" class=\"input\">\n          <option value=\"weather\">天候データ</option>\n          <option value=\"event\">イベント情報</option>\n          <option value=\"season\">季節情報</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>取得頻度</label>\n        <select id=\"schedule-frequency\" class=\"input\">\n          <option value=\"daily\">毎日</option>\n          <option value=\"weekly\">毎週</option>\n          <option value=\"monthly\">毎月</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>実行時刻</label>\n        <input type=\"time\" id=\"schedule-time\" class=\"input\" value=\"08:00\">\n      </div>\n      <div class=\"form-actions\">\n        <button type=\"button\" id=\"btn-save-schedule\" class=\"action-btn\">保存</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.tab-container {\n  margin-bottom: 20px;\n}\n\n.tab-buttons {\n  display: flex;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.3s ease;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.search-filters {\n  margin-bottom: 20px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 20px;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.filter-group label {\n  font-size: 14px;\n  color: var(--text-muted);\n}\n\n.filter-group span {\n  align-self: center;\n  margin: 0 5px;\n  color: var(--text-muted);\n}\n\n.action-bar {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.action-left, .action-right {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.close-btn:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.form-group {\n  margin-bottom: 15px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.form-actions {\n  display: flex;\n  gap: 10px;\n  justify-content: flex-end;\n  margin-top: 20px;\n  padding-top: 15px;\n  border-top: 1px solid var(--border);\n}\n\n.hidden {\n  display: none !important;\n}\n\n.error-message {\n  color: #ff6b6b;\n  font-size: 14px;\n  margin-top: 5px;\n}\n\n.success-message {\n  color: #51cf66;\n  font-size: 14px;\n  margin-top: 5px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}