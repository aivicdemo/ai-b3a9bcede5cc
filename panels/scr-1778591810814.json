{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <h2 style=\"color: var(--text); margin: 0 0 20px 0;\">外部要因データ管理</h2>\n  \n  <!-- データ種別タブ -->\n  <div style=\"border-bottom: 1px solid var(--border); margin-bottom: 20px;\">\n    <div style=\"display: flex; gap: 0;\">\n      <button id=\"tab-weather\" class=\"tab-btn active\" style=\"padding: 12px 24px; border: none; background: var(--primary); color: white; cursor: pointer; border-radius: 4px 4px 0 0;\">天候</button>\n      <button id=\"tab-event\" class=\"tab-btn\" style=\"padding: 12px 24px; border: none; background: var(--bg-card); color: var(--text-muted); cursor: pointer; border-radius: 4px 4px 0 0;\">イベント</button>\n      <button id=\"tab-season\" class=\"tab-btn\" style=\"padding: 12px 24px; border: none; background: var(--bg-card); color: var(--text-muted); cursor: pointer; border-radius: 4px 4px 0 0;\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div style=\"display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; align-items: end;\">\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">期間指定</label>\n      <div style=\"display: flex; gap: 10px; align-items: center;\">\n        <input type=\"date\" id=\"input-start-date\" class=\"input\" style=\"width: 150px;\">\n        <span style=\"color: var(--text-muted);\">〜</span>\n        <input type=\"date\" id=\"input-end-date\" class=\"input\" style=\"width: 150px;\">\n      </div>\n    </div>\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗</label>\n      <select id=\"select-store\" class=\"input\" style=\"width: 200px;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div>\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">データ種別</label>\n      <select id=\"select-data-type\" class=\"input\" style=\"width: 150px;\">\n        <option value=\"\">全て</option>\n      </select>\n    </div>\n    <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n  </div>\n</div>\n\n<!-- 天候データタブ -->\n<div id=\"weather-tab\" class=\"tab-content\">\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">天候データ手動入力</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">対象日 *</label>\n        <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 *</label>\n        <select id=\"weather-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">天気 *</label>\n        <select id=\"weather-condition\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"晴れ\">晴れ</option>\n          <option value=\"曇り\">曇り</option>\n          <option value=\"雨\">雨</option>\n          <option value=\"雪\">雪</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">最高気温(℃)</label>\n        <input type=\"number\" id=\"weather-max-temp\" class=\"input\" placeholder=\"例: 25\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">最低気温(℃)</label>\n        <input type=\"number\" id=\"weather-min-temp\" class=\"input\" placeholder=\"例: 15\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">降水量(mm)</label>\n        <input type=\"number\" id=\"weather-rainfall\" class=\"input\" placeholder=\"例: 5\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">湿度(%)</label>\n        <input type=\"number\" id=\"weather-humidity\" class=\"input\" placeholder=\"例: 60\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">風速(m/s)</label>\n        <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" placeholder=\"例: 3\">\n      </div>\n    </div>\n    <button id=\"btn-save-weather\" class=\"action-btn\">天候データ登録</button>\n  </div>\n</div>\n\n<!-- イベントデータタブ -->\n<div id=\"event-tab\" class=\"tab-content hidden\">\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">イベントデータ登録</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">イベント名 *</label>\n        <input type=\"text\" id=\"event-name\" class=\"input\" required placeholder=\"例: 春祭り\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">店舗 *</label>\n        <select id=\"event-store\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">イベント種別 *</label>\n        <select id=\"event-type\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"祭り\">祭り</option>\n          <option value=\"コンサート\">コンサート</option>\n          <option value=\"スポーツ\">スポーツ</option>\n          <option value=\"セール\">セール</option>\n          <option value=\"その他\">その他</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">開始日時 *</label>\n        <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">終了日時 *</label>\n        <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">影響度 *</label>\n        <select id=\"event-impact\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"大\">大</option>\n          <option value=\"中\">中</option>\n          <option value=\"小\">小</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">場所</label>\n        <input type=\"text\" id=\"event-location\" class=\"input\" placeholder=\"例: 東京都渋谷区\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">予想来場者数</label>\n        <input type=\"number\" id=\"event-visitors\" class=\"input\" placeholder=\"例: 10000\">\n      </div>\n    </div>\n    <div style=\"margin-bottom: 15px;\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">備考</label>\n      <textarea id=\"event-memo\" class=\"input\" rows=\"3\" placeholder=\"例: 来場者数約10万人予定\"></textarea>\n    </div>\n    <button id=\"btn-save-event\" class=\"action-btn\">イベントデータ登録</button>\n  </div>\n</div>\n\n<!-- 季節情報タブ -->\n<div id=\"season-tab\" class=\"tab-content hidden\">\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">季節情報設定</h3>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">年 *</label>\n        <input type=\"number\" id=\"season-year\" class=\"input\" required placeholder=\"例: 2024\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">月 *</label>\n        <select id=\"season-month\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"1\">1月</option>\n          <option value=\"2\">2月</option>\n          <option value=\"3\">3月</option>\n          <option value=\"4\">4月</option>\n          <option value=\"5\">5月</option>\n          <option value=\"6\">6月</option>\n          <option value=\"7\">7月</option>\n          <option value=\"8\">8月</option>\n          <option value=\"9\">9月</option>\n          <option value=\"10\">10月</option>\n          <option value=\"11\">11月</option>\n          <option value=\"12\">12月</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">日</label>\n        <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\" placeholder=\"例: 15\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">季節区分 *</label>\n        <select id=\"season-category\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"春\">春</option>\n          <option value=\"夏\">夏</option>\n          <option value=\"秋\">秋</option>\n          <option value=\"冬\">冬</option>\n          <option value=\"梅雨\">梅雨</option>\n          <option value=\"年末年始\">年末年始</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">季節係数 *</label>\n        <input type=\"number\" id=\"season-coefficient\" class=\"input\" required placeholder=\"例: 120\" step=\"0.1\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">温度帯区分</label>\n        <select id=\"season-temp-category\" class=\"input\">\n          <option value=\"\">選択してください</option>\n          <option value=\"高温期\">高温期</option>\n          <option value=\"低温期\">低温期</option>\n          <option value=\"適温期\">適温期</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"margin-bottom: 15px;\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">備考</label>\n      <textarea id=\"season-memo\" class=\"input\" rows=\"3\" placeholder=\"例: 春の需要増加期\"></textarea>\n    </div>\n    <button id=\"btn-save-season\" class=\"action-btn\">季節情報設定</button>\n  </div>\n</div>\n\n<!-- 機能ボタン -->\n<div class=\"card\" style=\"margin-bottom: 20px;\">\n  <div style=\"display: flex; gap: 15px; flex-wrap: wrap;\">\n    <button id=\"btn-api-setting\" class=\"action-btn secondary\">外部API連携設定</button>\n    <button id=\"btn-schedule-setting\" class=\"action-btn secondary\">データ自動取得スケジュール設定</button>\n    <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック実行</button>\n    <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n  </div>\n</div>\n\n<!-- データ一覧 -->\n<div class=\"card\">\n  <h3 style=\"color: var(--text); margin: 0 0 15px 0;\">外部要因データ一覧</h3>\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>データ種別</th>\n          <th>対象日</th>\n          <th>店舗名</th>\n          <th>詳細情報</th>\n          <th>作成日時</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"data-table-body\">\n      </tbody>\n    </table>\n  </div>\n  <div id=\"no-data-message\" class=\"hidden\" style=\"text-align: center; padding: 40px; color: var(--text-muted);\">\n    該当するデータがありません\n  </div>\n</div>\n\n<!-- API設定モーダル -->\n<div id=\"api-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div style=\"background: var(--bg-card); padding: 30px; border-radius: 8px; width: 90%; max-width: 600px; max-height: 80vh; overflow-y: auto;\">\n    <h3 style=\"color: var(--text); margin: 0 0 20px 0;\">外部API連携設定</h3>\n    <div style=\"display: grid; gap: 15px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">API名称 *</label>\n        <input type=\"text\" id=\"api-name\" class=\"input\" required placeholder=\"例: 気象庁API\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">エンドポイントURL *</label>\n        <input type=\"url\" id=\"api-url\" class=\"input\" required placeholder=\"https://api.example.com/weather\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">APIキー *</label>\n        <input type=\"text\" id=\"api-key\" class=\"input\" required placeholder=\"APIキーを入力\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">取得頻度 *</label>\n        <select id=\"api-frequency\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"毎日\">毎日</option>\n          <option value=\"毎週\">毎週</option>\n          <option value=\"毎月\">毎月</option>\n        </select>\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-api-test\" class=\"action-btn secondary\">接続テスト</button>\n      <button id=\"btn-api-save\" class=\"action-btn\">保存</button>\n      <button id=\"btn-api-cancel\" class=\"action-btn secondary\">キャンセル</button>\n    </div>\n  </div>\n</div>\n\n<!-- スケジュール設定モーダル -->\n<div id=\"schedule-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div style=\"background: var(--bg-card); padding: 30px; border-radius: 8px; width: 90%; max-width: 600px;\">\n    <h3 style=\"color: var(--text); margin: 0 0 20px 0;\">データ自動取得スケジュール設定</h3>\n    <div style=\"display: grid; gap: 15px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">スケジュール名 *</label>\n        <input type=\"text\" id=\"schedule-name\" class=\"input\" required placeholder=\"例: 天気データ取得\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">データソース種別 *</label>\n        <select id=\"schedule-source\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"気象データ\">気象データ</option>\n          <option value=\"イベントデータ\">イベントデータ</option>\n          <option value=\"経済指標\">経済指標</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">取得頻度 *</label>\n        <select id=\"schedule-frequency\" class=\"input\" required>\n          <option value=\"\">選択してください</option>\n          <option value=\"毎日\">毎日</option>\n          <option value=\"毎週\">毎週</option>\n          <option value=\"毎月\">毎月</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); display: block; margin-bottom: 5px;\">取得時刻 *</label>\n        <input type=\"time\" id=\"schedule-time\" class=\"input\" required>\n      </div>\n    </div>\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-schedule-save\" class=\"action-btn\">保存</button>\n      <button id=\"btn-schedule-cancel\" class=\"action-btn secondary\">キャンセル</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}