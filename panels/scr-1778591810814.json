{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>外部要因データ管理</h2>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します。</p>\n  </div>\n\n  <!-- データ種別タブ -->\n  <div class=\"tab-container\">\n    <div class=\"tab-buttons\">\n      <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n      <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n      <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card\">\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <label>期間指定</label>\n        <div style=\"display: flex; gap: 8px; align-items: center;\">\n          <input type=\"date\" id=\"search-start-date\" class=\"input\" placeholder=\"開始日\">\n          <span style=\"color: var(--text-muted);\">〜</span>\n          <input type=\"date\" id=\"search-end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n      <div class=\"form-group\">\n        <label>店舗絞り込み</label>\n        <select id=\"search-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>データ種別</label>\n        <select id=\"search-data-type\" class=\"input\">\n          <option value=\"\">全種別</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <button id=\"btn-search\" class=\"action-btn\">検索</button>\n        <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 天候データタブ -->\n  <div id=\"weather-tab\" class=\"tab-content active\">\n    <div class=\"form-section\">\n      <h3>天候データ手動入力</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>観測日 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>天気 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-condition\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n            <option value=\"霧\">霧</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>最高気温（℃）</label>\n          <input type=\"number\" id=\"weather-max-temp\" class=\"input\" placeholder=\"例: 25\">\n        </div>\n        <div class=\"form-group\">\n          <label>最低気温（℃）</label>\n          <input type=\"number\" id=\"weather-min-temp\" class=\"input\" placeholder=\"例: 15\">\n        </div>\n        <div class=\"form-group\">\n          <label>平均気温（℃）</label>\n          <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" placeholder=\"例: 20\">\n        </div>\n        <div class=\"form-group\">\n          <label>降水量（mm）</label>\n          <input type=\"number\" id=\"weather-precipitation\" class=\"input\" placeholder=\"例: 5\">\n        </div>\n        <div class=\"form-group\">\n          <label>湿度（%）</label>\n          <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\" placeholder=\"例: 65\">\n        </div>\n        <div class=\"form-group\">\n          <label>風速（m/s）</label>\n          <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" placeholder=\"例: 3\">\n        </div>\n        <div class=\"form-group\">\n          <label>データ種別 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"weather-data-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"実績値\">実績値</option>\n            <option value=\"予報値\">予報値</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>データソース <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"weather-data-source\" class=\"input\" placeholder=\"例: 気象庁API\" required>\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-save-weather\" class=\"action-btn\">天候データ登録</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベントデータタブ -->\n  <div id=\"event-tab\" class=\"tab-content hidden\">\n    <div class=\"form-section\">\n      <h3>イベントデータ登録</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-store-id\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>イベント名 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"event-name\" class=\"input\" placeholder=\"例: 春祭り\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>イベント種別 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"祭り\">祭り</option>\n            <option value=\"コンサート\">コンサート</option>\n            <option value=\"スポーツ\">スポーツ</option>\n            <option value=\"セール\">セール</option>\n            <option value=\"地域イベント\">地域イベント</option>\n            <option value=\"祝日\">祝日</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>開始日時 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-start-date\" class=\"input\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>終了日時 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-end-date\" class=\"input\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>予想来場者数</label>\n          <input type=\"number\" id=\"event-visitors\" class=\"input\" placeholder=\"例: 10000\">\n        </div>\n        <div class=\"form-group\">\n          <label>影響度 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"event-impact\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"大\">大</option>\n            <option value=\"中\">中</option>\n            <option value=\"小\">小</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>場所 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"event-location\" class=\"input\" placeholder=\"例: 東京都渋谷区\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>店舗からの距離（m）</label>\n          <input type=\"number\" id=\"event-distance\" class=\"input\" placeholder=\"例: 500\">\n        </div>\n        <div class=\"form-group\">\n          <label>備考</label>\n          <textarea id=\"event-memo\" class=\"input\" rows=\"3\" placeholder=\"例: 来場者数約10万人予定\"></textarea>\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-save-event\" class=\"action-btn\">イベントデータ登録</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 季節情報タブ -->\n  <div id=\"season-tab\" class=\"tab-content hidden\">\n    <div class=\"form-section\">\n      <h3>季節情報設定</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>年 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"season-year\" class=\"input\" min=\"2020\" max=\"2030\" placeholder=\"例: 2024\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>月 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"season-month\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"1\">1月</option>\n            <option value=\"2\">2月</option>\n            <option value=\"3\">3月</option>\n            <option value=\"4\">4月</option>\n            <option value=\"5\">5月</option>\n            <option value=\"6\">6月</option>\n            <option value=\"7\">7月</option>\n            <option value=\"8\">8月</option>\n            <option value=\"9\">9月</option>\n            <option value=\"10\">10月</option>\n            <option value=\"11\">11月</option>\n            <option value=\"12\">12月</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>日</label>\n          <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\" placeholder=\"例: 15\">\n        </div>\n        <div class=\"form-group\">\n          <label>季節区分 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"season-category\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"春\">春</option>\n            <option value=\"夏\">夏</option>\n            <option value=\"秋\">秋</option>\n            <option value=\"冬\">冬</option>\n            <option value=\"梅雨\">梅雨</option>\n            <option value=\"年末年始\">年末年始</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>季節係数 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"number\" id=\"season-coefficient\" class=\"input\" step=\"0.1\" placeholder=\"例: 1.2\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>温度帯区分</label>\n          <select id=\"season-temp-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"高温期\">高温期</option>\n            <option value=\"低温期\">低温期</option>\n            <option value=\"適温期\">適温期</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>学校暦区分</label>\n          <select id=\"season-school-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"新学期\">新学期</option>\n            <option value=\"夏休み\">夏休み</option>\n            <option value=\"冬休み\">冬休み</option>\n            <option value=\"春休み\">春休み</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>商戦期区分</label>\n          <select id=\"season-business-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"クリスマス商戦\">クリスマス商戦</option>\n            <option value=\"お中元\">お中元</option>\n            <option value=\"お歳暮\">お歳暮</option>\n            <option value=\"新年商戦\">新年商戦</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>備考</label>\n          <textarea id=\"season-memo\" class=\"input\" rows=\"3\" placeholder=\"例: 春の需要増加期\"></textarea>\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-save-season\" class=\"action-btn\">季節情報設定</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 外部API連携・スケジュール設定 -->\n  <div class=\"card\">\n    <h3>外部API連携・自動取得設定</h3>\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <button id=\"btn-api-settings\" class=\"action-btn secondary\">外部API連携設定</button>\n      </div>\n      <div class=\"form-group\">\n        <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">データ自動取得スケジュール設定</button>\n      </div>\n      <div class=\"form-group\">\n        <button id=\"btn-quality-check\" class=\"action-btn secondary\">データ品質チェック実行</button>\n      </div>\n      <div class=\"form-group\">\n        <button id=\"btn-correlation-analysis\" class=\"action-btn secondary\">相関分析実行</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card\">\n    <h3>外部要因データ一覧</h3>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr id=\"table-header\">\n            <th>データ種別</th>\n            <th>店舗名</th>\n            <th>日時</th>\n            <th>内容</th>\n            <th>ステータス</th>\n            <th>作成日時</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"data-list\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<!-- API設定モーダル -->\n<div id=\"api-modal\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>外部API連携設定</h3>\n      <button class=\"modal-close\" id=\"close-api-modal\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>API名称 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"api-name\" class=\"input\" placeholder=\"例: 気象庁API\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>エンドポイントURL <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"url\" id=\"api-endpoint\" class=\"input\" placeholder=\"https://api.example.com/weather\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>認証方式 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"api-auth-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"APIキー\">APIキー</option>\n            <option value=\"Bearer Token\">Bearer Token</option>\n            <option value=\"Basic認証\">Basic認証</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>APIキー <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"password\" id=\"api-key\" class=\"input\" placeholder=\"APIキーを入力\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>データ取得頻度 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"api-frequency\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"毎時\">毎時</option>\n            <option value=\"毎日\">毎日</option>\n            <option value=\"毎週\">毎週</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>タイムアウト（秒）</label>\n          <input type=\"number\" id=\"api-timeout\" class=\"input\" min=\"1\" placeholder=\"30\">\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-test-connection\" class=\"action-btn secondary\">接続テスト</button>\n          <button id=\"btn-save-api\" class=\"action-btn\">保存</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- スケジュール設定モーダル -->\n<div id=\"schedule-modal\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>データ自動取得スケジュール設定</h3>\n      <button class=\"modal-close\" id=\"close-schedule-modal\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>スケジュール名 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"text\" id=\"schedule-name\" class=\"input\" placeholder=\"例: 天気データ取得\" required>\n        </div>\n        <div class=\"form-group\">\n          <label>データソース種別 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"schedule-data-source\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"気象データ\">気象データ</option>\n            <option value=\"イベントデータ\">イベントデータ</option>\n            <option value=\"経済指標\">経済指標</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>取得頻度 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"schedule-frequency\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"毎日\">毎日</option>\n            <option value=\"毎週\">毎週</option>\n            <option value=\"毎月\">毎月</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>取得時刻 <span style=\"color: #ff6a00;\">*</span></label>\n          <input type=\"time\" id=\"schedule-time\" class=\"input\" required>\n        </div>\n        <div class=\"form-group\">\n          <button id=\"btn-save-schedule\" class=\"action-btn\">保存</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.tab-container {\n  margin-bottom: 20px;\n}\n\n.tab-buttons {\n  display: flex;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.3s ease;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.tab-content {\n  margin-top: 20px;\n}\n\n.form-section {\n  background: var(--bg-card);\n  padding: 20px;\n  border-radius: 8px;\n  margin-bottom: 20px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 16px;\n  align-items: end;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.form-group label {\n  font-weight: 500;\n  color: var(--text);\n  font-size: 14px;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 80vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-close:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}