{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー -->\n  <div class=\"header-section\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します。</p>\n  </div>\n\n  <!-- タブメニュー -->\n  <div class=\"tab-menu\">\n    <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n    <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n    <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card search-section\">\n    <div class=\"search-filters\">\n      <div class=\"filter-row\">\n        <div class=\"filter-item\">\n          <label>期間指定</label>\n          <div class=\"date-range\">\n            <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n            <span>〜</span>\n            <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n          </div>\n        </div>\n        <div class=\"filter-item\">\n          <label>店舗</label>\n          <select id=\"store-filter\" class=\"input\">\n            <option value=\"\">全店舗</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>キーワード</label>\n          <input type=\"text\" id=\"keyword-search\" class=\"input\" placeholder=\"検索キーワード\">\n        </div>\n      </div>\n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索</button>\n        <button class=\"action-btn secondary\" id=\"btn-reset\">リセット</button>\n        <button class=\"action-btn secondary\" id=\"btn-export\">CSVエクスポート</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ入力フォーム -->\n  <div class=\"card form-section\" id=\"form-section\">\n    <!-- 天候データフォーム -->\n    <div class=\"data-form\" id=\"weather-form\">\n      <h3>天候データ登録</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-item\">\n          <label>店舗 <span class=\"required\">*</span></label>\n          <select id=\"weather-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>観測日 <span class=\"required\">*</span></label>\n          <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>天気 <span class=\"required\">*</span></label>\n          <select id=\"weather-condition\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"晴れ\">晴れ</option>\n            <option value=\"曇り\">曇り</option>\n            <option value=\"雨\">雨</option>\n            <option value=\"雪\">雪</option>\n            <option value=\"台風\">台風</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>最高気温 (℃)</label>\n          <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n        </div>\n        <div class=\"form-item\">\n          <label>最低気温 (℃)</label>\n          <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n        </div>\n        <div class=\"form-item\">\n          <label>平均気温 (℃)</label>\n          <input type=\"number\" id=\"weather-avg-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n        </div>\n        <div class=\"form-item\">\n          <label>降水量 (mm)</label>\n          <input type=\"number\" id=\"weather-rainfall\" class=\"input\" min=\"0\" max=\"1000\" step=\"0.1\">\n        </div>\n        <div class=\"form-item\">\n          <label>湿度 (%)</label>\n          <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n        </div>\n        <div class=\"form-item\">\n          <label>風速 (m/s)</label>\n          <input type=\"number\" id=\"weather-wind\" class=\"input\" min=\"0\" max=\"100\" step=\"0.1\">\n        </div>\n        <div class=\"form-item\">\n          <label>データ種別 <span class=\"required\">*</span></label>\n          <select id=\"weather-type\" class=\"input\" required>\n            <option value=\"実績値\">実績値</option>\n            <option value=\"予報値\">予報値</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>データソース <span class=\"required\">*</span></label>\n          <select id=\"weather-source\" class=\"input\" required>\n            <option value=\"気象庁\">気象庁</option>\n            <option value=\"外部API\">外部API</option>\n            <option value=\"手動入力\">手動入力</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"action-btn\" id=\"btn-save-weather\">登録</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear-weather\">クリア</button>\n      </div>\n    </div>\n\n    <!-- イベントデータフォーム -->\n    <div class=\"data-form hidden\" id=\"event-form\">\n      <h3>イベントデータ登録</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-item\">\n          <label>店舗 <span class=\"required\">*</span></label>\n          <select id=\"event-store\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>イベント名 <span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"event-name\" class=\"input\" maxlength=\"100\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>イベント種別 <span class=\"required\">*</span></label>\n          <select id=\"event-type\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"祭り\">祭り</option>\n            <option value=\"コンサート\">コンサート</option>\n            <option value=\"スポーツ\">スポーツ</option>\n            <option value=\"セール\">セール</option>\n            <option value=\"その他\">その他</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>開始日時 <span class=\"required\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-start\" class=\"input\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>終了日時 <span class=\"required\">*</span></label>\n          <input type=\"datetime-local\" id=\"event-end\" class=\"input\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>予想来場者数</label>\n          <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n        </div>\n        <div class=\"form-item\">\n          <label>影響度 <span class=\"required\">*</span></label>\n          <select id=\"event-impact\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"大\">大</option>\n            <option value=\"中\">中</option>\n            <option value=\"小\">小</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>場所 <span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"event-location\" class=\"input\" maxlength=\"100\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>店舗からの距離 (m)</label>\n          <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n        </div>\n        <div class=\"form-item full-width\">\n          <label>備考</label>\n          <textarea id=\"event-memo\" class=\"input\" rows=\"3\"></textarea>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"action-btn\" id=\"btn-save-event\">登録</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear-event\">クリア</button>\n      </div>\n    </div>\n\n    <!-- 季節情報フォーム -->\n    <div class=\"data-form hidden\" id=\"season-form\">\n      <h3>季節情報設定</h3>\n      <div class=\"form-grid\">\n        <div class=\"form-item\">\n          <label>年 <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"season-year\" class=\"input\" min=\"2020\" max=\"2030\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>月 <span class=\"required\">*</span></label>\n          <select id=\"season-month\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"1\">1月</option>\n            <option value=\"2\">2月</option>\n            <option value=\"3\">3月</option>\n            <option value=\"4\">4月</option>\n            <option value=\"5\">5月</option>\n            <option value=\"6\">6月</option>\n            <option value=\"7\">7月</option>\n            <option value=\"8\">8月</option>\n            <option value=\"9\">9月</option>\n            <option value=\"10\">10月</option>\n            <option value=\"11\">11月</option>\n            <option value=\"12\">12月</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>日</label>\n          <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n        </div>\n        <div class=\"form-item\">\n          <label>季節区分 <span class=\"required\">*</span></label>\n          <select id=\"season-category\" class=\"input\" required>\n            <option value=\"\">選択してください</option>\n            <option value=\"春\">春</option>\n            <option value=\"夏\">夏</option>\n            <option value=\"秋\">秋</option>\n            <option value=\"冬\">冬</option>\n            <option value=\"梅雨\">梅雨</option>\n            <option value=\"年末年始\">年末年始</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>季節係数 (%) <span class=\"required\">*</span></label>\n          <input type=\"number\" id=\"season-coefficient\" class=\"input\" min=\"0\" max=\"500\" required>\n        </div>\n        <div class=\"form-item\">\n          <label>温度帯区分</label>\n          <select id=\"season-temp-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"高温期\">高温期</option>\n            <option value=\"低温期\">低温期</option>\n            <option value=\"適温期\">適温期</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>学校暦区分</label>\n          <select id=\"season-school-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"新学期\">新学期</option>\n            <option value=\"夏休み\">夏休み</option>\n            <option value=\"冬休み\">冬休み</option>\n            <option value=\"春休み\">春休み</option>\n          </select>\n        </div>\n        <div class=\"form-item\">\n          <label>商戦期区分</label>\n          <select id=\"season-business-category\" class=\"input\">\n            <option value=\"\">選択してください</option>\n            <option value=\"クリスマス商戦\">クリスマス商戦</option>\n            <option value=\"お中元\">お中元</option>\n            <option value=\"お歳暮\">お歳暮</option>\n            <option value=\"新年商戦\">新年商戦</option>\n          </select>\n        </div>\n        <div class=\"form-item full-width\">\n          <label>備考</label>\n          <textarea id=\"season-memo\" class=\"input\" rows=\"3\"></textarea>\n        </div>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"action-btn\" id=\"btn-save-season\">登録</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear-season\">クリア</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 外部API連携・分析機能 -->\n  <div class=\"card api-section\">\n    <h3>外部連携・分析機能</h3>\n    <div class=\"api-actions\">\n      <button class=\"action-btn secondary\" id=\"btn-api-settings\">外部API連携設定</button>\n      <button class=\"action-btn secondary\" id=\"btn-schedule-settings\">自動取得スケジュール設定</button>\n      <button class=\"action-btn secondary\" id=\"btn-quality-check\">データ品質チェック</button>\n      <button class=\"action-btn secondary\" id=\"btn-correlation-analysis\">相関分析実行</button>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card\">\n    <div class=\"table-header\">\n      <h3 id=\"table-title\">天候データ一覧</h3>\n      <div class=\"table-actions\">\n        <span class=\"muted\" id=\"data-count\">0件</span>\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead id=\"table-head\">\n          <!-- 動的に生成 -->\n        </thead>\n        <tbody id=\"table-body\">\n          <!-- 動的に生成 -->\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n}\n\n.header-section {\n  margin-bottom: 24px;\n}\n\n.header-section h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.tab-menu {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 24px;\n  border-bottom: 1px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: transparent;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.2s;\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.search-section {\n  margin-bottom: 24px;\n}\n\n.search-filters {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.filter-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 200px;\n}\n\n.filter-item label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.filter-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.form-section {\n  margin-bottom: 24px;\n}\n\n.data-form h3 {\n  color: var(--text);\n  margin-bottom: 16px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 16px;\n  margin-bottom: 20px;\n}\n\n.form-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.form-item.full-width {\n  grid-column: 1 / -1;\n}\n\n.form-item label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6b6b;\n}\n\n.form-actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-start;\n}\n\n.api-section {\n  margin-bottom: 24px;\n}\n\n.api-section h3 {\n  color: var(--text);\n  margin-bottom: 16px;\n}\n\n.api-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.table-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n}\n\n.table-header h3 {\n  color: var(--text);\n  margin: 0;\n}\n\n.table-actions {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.hidden {\n  display: none !important;\n}\n\n@media (max-width: 768px) {\n  .filter-row {\n    flex-direction: column;\n  }\n  \n  .filter-item {\n    min-width: auto;\n  }\n  \n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .api-actions {\n    flex-direction: column;\n  }\n  \n  .api-actions button {\n    width: 100%;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}