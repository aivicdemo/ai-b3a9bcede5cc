{
  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー -->\n  <div class=\"header-section\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します</p>\n  </div>\n\n  <!-- タブメニュー -->\n  <div class=\"tab-menu\">\n    <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n    <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n    <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card filter-section\">\n    <div class=\"filter-row\">\n      <div class=\"filter-group\">\n        <label>期間指定</label>\n        <input type=\"date\" id=\"filter-start-date\" class=\"input\">\n        <span>～</span>\n        <input type=\"date\" id=\"filter-end-date\" class=\"input\">\n      </div>\n      <div class=\"filter-group\">\n        <label>店舗</label>\n        <select id=\"filter-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <button id=\"btn-search\" class=\"action-btn\">検索</button>\n        <button id=\"btn-reset\" class=\"action-btn secondary\">リセット</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 天候データタブ -->\n  <div id=\"weather-tab\" class=\"tab-content active\">\n    <div class=\"card\">\n      <div class=\"section-header\">\n        <h3>天候データ管理</h3>\n        <div class=\"header-actions\">\n          <button id=\"btn-weather-api-sync\" class=\"action-btn secondary\">外部API連携</button>\n          <button id=\"btn-weather-schedule\" class=\"action-btn secondary\">自動取得設定</button>\n          <button id=\"btn-weather-export\" class=\"action-btn secondary\">エクスポート</button>\n        </div>\n      </div>\n\n      <!-- 天候データ登録フォーム -->\n      <div class=\"form-section\">\n        <h4>天候データ手動入力</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>観測日 <span class=\"required\">*</span></label>\n            <input type=\"date\" id=\"weather-date\" class=\"input\" required>\n          </div>\n          <div class=\"form-group\">\n            <label>店舗 <span class=\"required\">*</span></label>\n            <select id=\"weather-store\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>天気 <span class=\"required\">*</span></label>\n            <select id=\"weather-condition\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"晴れ\">晴れ</option>\n              <option value=\"曇り\">曇り</option>\n              <option value=\"雨\">雨</option>\n              <option value=\"雪\">雪</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>最高気温 (℃)</label>\n            <input type=\"number\" id=\"weather-max-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n          </div>\n          <div class=\"form-group\">\n            <label>最低気温 (℃)</label>\n            <input type=\"number\" id=\"weather-min-temp\" class=\"input\" min=\"-50\" max=\"50\" step=\"0.1\">\n          </div>\n          <div class=\"form-group\">\n            <label>降水量 (mm)</label>\n            <input type=\"number\" id=\"weather-precipitation\" class=\"input\" min=\"0\" max=\"999.9\" step=\"0.1\">\n          </div>\n          <div class=\"form-group\">\n            <label>湿度 (%)</label>\n            <input type=\"number\" id=\"weather-humidity\" class=\"input\" min=\"0\" max=\"100\">\n          </div>\n          <div class=\"form-group\">\n            <label>風速 (m/s)</label>\n            <input type=\"number\" id=\"weather-wind-speed\" class=\"input\" min=\"0\" max=\"99.9\" step=\"0.1\">\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button id=\"btn-weather-save\" class=\"action-btn\">登録</button>\n          <button id=\"btn-weather-clear\" class=\"action-btn secondary\">クリア</button>\n        </div>\n      </div>\n\n      <!-- 天候データ一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"weather-table\">\n          <thead>\n            <tr>\n              <th>観測日</th>\n              <th>店舗名</th>\n              <th>天気</th>\n              <th>最高気温</th>\n              <th>最低気温</th>\n              <th>降水量</th>\n              <th>湿度</th>\n              <th>風速</th>\n              <th>データソース</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"weather-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベントデータタブ -->\n  <div id=\"event-tab\" class=\"tab-content\">\n    <div class=\"card\">\n      <div class=\"section-header\">\n        <h3>イベントデータ管理</h3>\n        <div class=\"header-actions\">\n          <button id=\"btn-event-export\" class=\"action-btn secondary\">エクスポート</button>\n        </div>\n      </div>\n\n      <!-- イベントデータ登録フォーム -->\n      <div class=\"form-section\">\n        <h4>イベントデータ登録</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>イベント名 <span class=\"required\">*</span></label>\n            <input type=\"text\" id=\"event-name\" class=\"input\" required maxlength=\"255\">\n          </div>\n          <div class=\"form-group\">\n            <label>店舗 <span class=\"required\">*</span></label>\n            <select id=\"event-store\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>イベント種別 <span class=\"required\">*</span></label>\n            <select id=\"event-type\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"祭り\">祭り</option>\n              <option value=\"コンサート\">コンサート</option>\n              <option value=\"スポーツ\">スポーツ</option>\n              <option value=\"セール\">セール</option>\n              <option value=\"その他\">その他</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>開始日時 <span class=\"required\">*</span></label>\n            <input type=\"datetime-local\" id=\"event-start-date\" class=\"input\" required>\n          </div>\n          <div class=\"form-group\">\n            <label>終了日時 <span class=\"required\">*</span></label>\n            <input type=\"datetime-local\" id=\"event-end-date\" class=\"input\" required>\n          </div>\n          <div class=\"form-group\">\n            <label>予想来場者数</label>\n            <input type=\"number\" id=\"event-visitors\" class=\"input\" min=\"0\">\n          </div>\n          <div class=\"form-group\">\n            <label>影響度 <span class=\"required\">*</span></label>\n            <select id=\"event-impact\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"大\">大</option>\n              <option value=\"中\">中</option>\n              <option value=\"小\">小</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>場所 <span class=\"required\">*</span></label>\n            <input type=\"text\" id=\"event-location\" class=\"input\" required>\n          </div>\n          <div class=\"form-group\">\n            <label>店舗からの距離 (m)</label>\n            <input type=\"number\" id=\"event-distance\" class=\"input\" min=\"0\">\n          </div>\n          <div class=\"form-group full-width\">\n            <label>備考</label>\n            <textarea id=\"event-memo\" class=\"input\" rows=\"3\"></textarea>\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button id=\"btn-event-save\" class=\"action-btn\">登録</button>\n          <button id=\"btn-event-clear\" class=\"action-btn secondary\">クリア</button>\n        </div>\n      </div>\n\n      <!-- イベントデータ一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"event-table\">\n          <thead>\n            <tr>\n              <th>イベント名</th>\n              <th>店舗名</th>\n              <th>種別</th>\n              <th>開始日時</th>\n              <th>終了日時</th>\n              <th>影響度</th>\n              <th>場所</th>\n              <th>距離</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"event-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- 季節情報タブ -->\n  <div id=\"season-tab\" class=\"tab-content\">\n    <div class=\"card\">\n      <div class=\"section-header\">\n        <h3>季節情報管理</h3>\n        <div class=\"header-actions\">\n          <button id=\"btn-season-export\" class=\"action-btn secondary\">エクスポート</button>\n        </div>\n      </div>\n\n      <!-- 季節情報設定フォーム -->\n      <div class=\"form-section\">\n        <h4>季節情報設定</h4>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>年 <span class=\"required\">*</span></label>\n            <input type=\"number\" id=\"season-year\" class=\"input\" required min=\"2020\" max=\"2030\">\n          </div>\n          <div class=\"form-group\">\n            <label>月 <span class=\"required\">*</span></label>\n            <select id=\"season-month\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"1\">1月</option>\n              <option value=\"2\">2月</option>\n              <option value=\"3\">3月</option>\n              <option value=\"4\">4月</option>\n              <option value=\"5\">5月</option>\n              <option value=\"6\">6月</option>\n              <option value=\"7\">7月</option>\n              <option value=\"8\">8月</option>\n              <option value=\"9\">9月</option>\n              <option value=\"10\">10月</option>\n              <option value=\"11\">11月</option>\n              <option value=\"12\">12月</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>日</label>\n            <input type=\"number\" id=\"season-day\" class=\"input\" min=\"1\" max=\"31\">\n          </div>\n          <div class=\"form-group\">\n            <label>季節区分 <span class=\"required\">*</span></label>\n            <select id=\"season-category\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n              <option value=\"春\">春</option>\n              <option value=\"夏\">夏</option>\n              <option value=\"秋\">秋</option>\n              <option value=\"冬\">冬</option>\n              <option value=\"梅雨\">梅雨</option>\n              <option value=\"年末年始\">年末年始</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>季節係数 (%) <span class=\"required\">*</span></label>\n            <input type=\"number\" id=\"season-coefficient\" class=\"input\" required min=\"0\" max=\"500\" value=\"100\">\n          </div>\n          <div class=\"form-group\">\n            <label>温度帯区分</label>\n            <select id=\"season-temp-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"高温期\">高温期</option>\n              <option value=\"低温期\">低温期</option>\n              <option value=\"適温期\">適温期</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>学校暦区分</label>\n            <select id=\"season-school-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"新学期\">新学期</option>\n              <option value=\"夏休み\">夏休み</option>\n              <option value=\"冬休み\">冬休み</option>\n              <option value=\"春休み\">春休み</option>\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label>商戦期区分</label>\n            <select id=\"season-business-category\" class=\"input\">\n              <option value=\"\">選択してください</option>\n              <option value=\"クリスマス商戦\">クリスマス商戦</option>\n              <option value=\"お中元\">お中元</option>\n              <option value=\"お歳暮\">お歳暮</option>\n            </select>\n          </div>\n          <div class=\"form-group full-width\">\n            <label>備考</label>\n            <textarea id=\"season-memo\" class=\"input\" rows=\"3\"></textarea>\n          </div>\n        </div>\n        <div class=\"form-actions\">\n          <button id=\"btn-season-save\" class=\"action-btn\">登録</button>\n          <button id=\"btn-season-clear\" class=\"action-btn secondary\">クリア</button>\n        </div>\n      </div>\n\n      <!-- 季節情報一覧 -->\n      <div class=\"table-wrap\">\n        <table id=\"season-table\">\n          <thead>\n            <tr>\n              <th>年</th>\n              <th>月</th>\n              <th>日</th>\n              <th>季節区分</th>\n              <th>季節係数</th>\n              <th>温度帯区分</th>\n              <th>学校暦区分</th>\n              <th>商戦期区分</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"season-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- 分析・設定エリア -->\n  <div class=\"card analysis-section\">\n    <div class=\"section-header\">\n      <h3>データ分析・設定</h3>\n    </div>\n    <div class=\"analysis-actions\">\n      <button id=\"btn-correlation-analysis\" class=\"action-btn\">相関分析実行</button>\n      <button id=\"btn-data-quality-check\" class=\"action-btn secondary\">データ品質チェック</button>\n      <button id=\"btn-schedule-settings\" class=\"action-btn secondary\">自動取得スケジュール設定</button>\n    </div>\n    <div id=\"analysis-results\" class=\"analysis-results hidden\">\n      <h4>分析結果</h4>\n      <div id=\"analysis-content\"></div>\n    </div>\n  </div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.header-section {\n  margin-bottom: 24px;\n}\n\n.header-section h1 {\n  margin: 0 0 8px 0;\n  color: var(--text);\n  font-size: 24px;\n}\n\n.tab-menu {\n  display: flex;\n  margin-bottom: 20px;\n  border-bottom: 2px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.2s;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--primary-hover);\n}\n\n.filter-section {\n  margin-bottom: 20px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 20px;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.filter-group label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.filter-group span {\n  margin: 0 8px;\n  color: var(--text-muted);\n  align-self: center;\n  margin-top: 20px;\n}\n\n.tab-content {\n  display: none;\n}\n\n.tab-content.active {\n  display: block;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.section-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.form-section {\n  margin-bottom: 32px;\n  padding: 20px;\n  background: var(--bg-card);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.form-section h4 {\n  margin: 0 0 16px 0;\n  color: var(--text);\n  font-size: 16px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  margin-bottom: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.form-group.full-width {\n  grid-column: 1 / -1;\n}\n\n.form-group label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6a6a;\n}\n\n.form-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.analysis-section {\n  margin-top: 24px;\n}\n\n.analysis-actions {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.analysis-results {\n  margin-top: 20px;\n  padding: 16px;\n  background: var(--bg-card);\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.analysis-results h4 {\n  margin: 0 0 12px 0;\n  color: var(--text);\n}\n\n#analysis-content {\n  color: var(--text-muted);\n}\n\n.error-message {\n  color: #ff6a6a;\n  font-size: 14px;\n  margin-top: 4px;\n}\n\n.success-message {\n  color: #4caf50;\n  font-size: 14px;\n  margin-top: 4px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}