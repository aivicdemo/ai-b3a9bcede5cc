  "screenId": "scr-1778591810814",
  "screenName": "外部要因データ管理",
  "html": "<div class=\"external-factors-management\">\n  <!-- ヘッダー -->\n  <div class=\"header-section\">\n    <h1>外部要因データ管理</h1>\n    <p class=\"muted\">天候、イベント、季節情報などの外部要因データを一元管理し、需要予測の精度向上に必要なデータを収集・更新・分析します</p>\n  </div>\n\n  <!-- タブメニュー -->\n  <div class=\"tab-menu\">\n    <button class=\"tab-btn active\" data-tab=\"weather\" id=\"tab-weather\">天候</button>\n    <button class=\"tab-btn\" data-tab=\"event\" id=\"tab-event\">イベント</button>\n    <button class=\"tab-btn\" data-tab=\"season\" id=\"tab-season\">季節</button>\n  </div>\n\n  <!-- 検索・フィルター -->\n  <div class=\"card filter-section\">\n    <div class=\"filter-row\">\n      <div class=\"filter-item\">\n        <label>期間指定</label>\n        <div class=\"date-range\">\n          <input type=\"date\" id=\"start-date\" class=\"input\" placeholder=\"開始日\">\n          <span>〜</span>\n          <input type=\"date\" id=\"end-date\" class=\"input\" placeholder=\"終了日\">\n        </div>\n      </div>\n      <div class=\"filter-item\">\n        <label>店舗</label>\n        <select id=\"store-filter\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索</button>\n        <button class=\"action-btn secondary\" id=\"btn-reset\">リセット</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- データ一覧 -->\n  <div class=\"card data-section\">\n    <div class=\"section-header\">\n      <h3 id=\"data-title\">天候データ一覧</h3>\n      <div class=\"section-actions\">\n        <button class=\"action-btn\" id=\"btn-add\">新規登録</button>\n        <button class=\"action-btn secondary\" id=\"btn-api-settings\">外部API連携設定</button>\n        <button class=\"action-btn secondary\" id=\"btn-schedule\">自動取得スケジュール</button>\n        <button class=\"action-btn secondary\" id=\"btn-quality-check\">データ品質チェック</button>\n        <button class=\"action-btn secondary\" id=\"btn-correlation\">相関分析実行</button>\n        <button class=\"action-btn secondary\" id=\"btn-export\">データエクスポート</button>\n      </div>\n    </div>\n    \n    <div class=\"table-wrap\">\n      <table>\n        <thead id=\"table-header\">\n          <!-- 動的に生成 -->\n        </thead>\n        <tbody id=\"table-body\">\n          <!-- 動的に生成 -->\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 登録・編集フォーム（モーダル） -->\n  <div class=\"modal hidden\" id=\"form-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3 id=\"modal-title\">天候データ登録</h3>\n        <button class=\"close-btn\" id=\"btn-close-modal\">&times;</button>\n      </div>\n      <div class=\"modal-body\" id=\"form-container\">\n        <!-- 動的に生成 -->\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn\" id=\"btn-save\">保存</button>\n        <button class=\"action-btn secondary\" id=\"btn-cancel\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- API設定モーダル -->\n  <div class=\"modal hidden\" id=\"api-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>外部API連携設定</h3>\n        <button class=\"close-btn\" id=\"btn-close-api-modal\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"form-group\">\n          <label>API URL</label>\n          <input type=\"text\" id=\"api-url\" class=\"input\" placeholder=\"https://api.example.com/weather\">\n        </div>\n        <div class=\"form-group\">\n          <label>認証キー</label>\n          <input type=\"text\" id=\"api-key\" class=\"input\" placeholder=\"API Key\">\n        </div>\n        <div class=\"form-group\">\n          <label>データ取得間隔</label>\n          <select id=\"api-interval\" class=\"input\">\n            <option value=\"1\">1時間</option>\n            <option value=\"6\">6時間</option>\n            <option value=\"24\">24時間</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn\" id=\"btn-test-api\">接続テスト</button>\n        <button class=\"action-btn\" id=\"btn-save-api\">保存</button>\n        <button class=\"action-btn secondary\" id=\"btn-cancel-api\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- スケジュール設定モーダル -->\n  <div class=\"modal hidden\" id=\"schedule-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>データ自動取得スケジュール設定</h3>\n        <button class=\"close-btn\" id=\"btn-close-schedule-modal\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"form-group\">\n          <label>データソース種別</label>\n          <select id=\"schedule-type\" class=\"input\">\n            <option value=\"weather\">天候データ</option>\n            <option value=\"event\">イベント情報</option>\n            <option value=\"season\">季節情報</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>取得頻度</label>\n          <select id=\"schedule-frequency\" class=\"input\">\n            <option value=\"daily\">毎日</option>\n            <option value=\"weekly\">毎週</option>\n            <option value=\"monthly\">毎月</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>実行時刻</label>\n          <input type=\"time\" id=\"schedule-time\" class=\"input\" value=\"08:00\">\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn\" id=\"btn-save-schedule\">保存</button>\n        <button class=\"action-btn secondary\" id=\"btn-cancel-schedule\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 品質チェック結果モーダル -->\n  <div class=\"modal hidden\" id=\"quality-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>データ品質チェック結果</h3>\n        <button class=\"close-btn\" id=\"btn-close-quality-modal\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div id=\"quality-results\">\n          <!-- 動的に生成 -->\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn secondary\" id=\"btn-close-quality\">閉じる</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.external-factors-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.header-section {\n  margin-bottom: 24px;\n}\n\n.header-section h1 {\n  margin: 0 0 8px 0;\n  font-size: 24px;\n  color: var(--text);\n}\n\n.tab-menu {\n  display: flex;\n  gap: 4px;\n  margin-bottom: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.tab-btn {\n  padding: 12px 24px;\n  background: transparent;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.2s;\n}\n\n.tab-btn.active {\n  color: var(--primary);\n  border-bottom-color: var(--primary);\n}\n\n.tab-btn:hover {\n  color: var(--text);\n}\n\n.filter-section {\n  margin-bottom: 20px;\n}\n\n.filter-row {\n  display: flex;\n  align-items: end;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\n.filter-item {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.filter-item label {\n  font-size: 14px;\n  color: var(--text);\n}\n\n.date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.date-range span {\n  color: var(--text-muted);\n}\n\n.filter-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.section-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.section-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 80vh;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.close-btn:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n  overflow-y: auto;\n  flex: 1;\n}\n\n.modal-footer {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 4px;\n  font-size: 14px;\n  color: var(--text);\n}\n\n.form-row {\n  display: flex;\n  gap: 16px;\n}\n\n.form-row .form-group {\n  flex: 1;\n}\n\n.quality-item {\n  padding: 12px;\n  margin-bottom: 8px;\n  border-radius: 4px;\n  border-left: 4px solid;\n}\n\n.quality-item.success {\n  border-left-color: #10b981;\n  background: rgba(16, 185, 129, 0.1);\n}\n\n.quality-item.warning {\n  border-left-color: #f59e0b;\n  background: rgba(245, 158, 11, 0.1);\n}\n\n.quality-item.error {\n  border-left-color: #ef4444;\n  background: rgba(239, 68, 68, 0.1);\n}\n\n.quality-item h4 {\n  margin: 0 0 4px 0;\n  font-size: 14px;\n  color: var(--text);\n}\n\n.quality-item p {\n  margin: 0;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n@media (max-width: 768px) {\n  .filter-row {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .section-header {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .section-actions {\n    justify-content: flex-start;\n  }\n  \n  .modal-content {\n    width: 95%;\n    margin: 20px;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}