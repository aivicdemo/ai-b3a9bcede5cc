{
  "screenId": "scr-1778591974844",
  "screenName": "予測精度監視画面",
  "html": "<div class=\"prediction-accuracy-monitor\">\n  <!-- ヘッダー -->\n  <div class=\"page-header\">\n    <h1>予測精度監視画面</h1>\n    <div class=\"header-actions\">\n      <button class=\"action-btn\" id=\"btn-refresh\">\n        <span>🔄</span> 更新\n      </button>\n      <button class=\"action-btn secondary\" id=\"btn-export-report\">\n        <span>📊</span> レポート出力\n      </button>\n    </div>\n  </div>\n\n  <!-- フィルター -->\n  <div class=\"card filter-section\">\n    <div class=\"filter-row\">\n      <div class=\"filter-group\">\n        <label for=\"period-select\">期間選択</label>\n        <select id=\"period-select\" class=\"input\">\n          <option value=\"7\">過去1週間</option>\n          <option value=\"30\" selected>過去1ヶ月</option>\n          <option value=\"90\">過去3ヶ月</option>\n          <option value=\"365\">過去1年</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <label for=\"store-select\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <label for=\"category-select\">商品カテゴリ</label>\n        <select id=\"category-select\" class=\"input\">\n          <option value=\"\">全カテゴリ</option>\n          <option value=\"食品\">食品</option>\n          <option value=\"日用品\">日用品</option>\n          <option value=\"衣料品\">衣料品</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <button class=\"action-btn\" id=\"btn-apply-filter\">適用</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 予測精度サマリーカード -->\n  <div class=\"summary-cards\">\n    <div class=\"card summary-card\">\n      <div class=\"summary-header\">\n        <h3>MAPE</h3>\n        <span class=\"summary-subtitle\">平均絶対パーセント誤差</span>\n      </div>\n      <div class=\"summary-value\" id=\"mape-value\">15.25%</div>\n      <div class=\"summary-trend\" id=\"mape-trend\">\n        <span class=\"trend-icon\">📈</span>\n        <span class=\"trend-text\">前月比 -2.1%</span>\n      </div>\n    </div>\n    <div class=\"card summary-card\">\n      <div class=\"summary-header\">\n        <h3>RMSE</h3>\n        <span class=\"summary-subtitle\">二乗平均平方根誤差</span>\n      </div>\n      <div class=\"summary-value\" id=\"rmse-value\">12.8</div>\n      <div class=\"summary-trend\" id=\"rmse-trend\">\n        <span class=\"trend-icon\">📉</span>\n        <span class=\"trend-text\">前月比 -1.5</span>\n      </div>\n    </div>\n    <div class=\"card summary-card\">\n      <div class=\"summary-header\">\n        <h3>予測精度</h3>\n        <span class=\"summary-subtitle\">全体平均</span>\n      </div>\n      <div class=\"summary-value\" id=\"accuracy-value\">84.75%</div>\n      <div class=\"summary-trend\" id=\"accuracy-trend\">\n        <span class=\"trend-icon\">📈</span>\n        <span class=\"trend-text\">前月比 +2.1%</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- アラート通知パネル -->\n  <div class=\"card alert-panel\" id=\"alert-panel\" style=\"display: none;\">\n    <div class=\"alert-header\">\n      <span class=\"alert-icon\">⚠️</span>\n      <h3>精度アラート</h3>\n    </div>\n    <div class=\"alert-content\" id=\"alert-content\">\n      <!-- アラート内容がここに表示される -->\n    </div>\n  </div>\n\n  <!-- グラフエリア -->\n  <div class=\"charts-section\">\n    <div class=\"card chart-card\">\n      <div class=\"chart-header\">\n        <h3>予測精度推移グラフ</h3>\n      </div>\n      <div class=\"chart-container\">\n        <canvas id=\"accuracy-trend-chart\" width=\"800\" height=\"300\"></canvas>\n      </div>\n    </div>\n    <div class=\"card chart-card\">\n      <div class=\"chart-header\">\n        <h3>予測vs実績比較チャート</h3>\n      </div>\n      <div class=\"chart-container\">\n        <canvas id=\"prediction-vs-actual-chart\" width=\"800\" height=\"300\"></canvas>\n      </div>\n    </div>\n  </div>\n\n  <!-- 精度ランキング表 -->\n  <div class=\"card\">\n    <div class=\"table-header\">\n      <h3>精度ランキング表</h3>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th class=\"sortable\" data-sort=\"rank\">順位 <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"storeName\">店舗名 <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"productName\">商品名 <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"accuracy\">精度 <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"mape\">MAPE <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"rmse\">RMSE <span class=\"sort-icon\">↕️</span></th>\n            <th class=\"sortable\" data-sort=\"period\">期間 <span class=\"sort-icon\">↕️</span></th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"ranking-tbody\">\n          <!-- データがここに表示される -->\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ -->\n  <div class=\"error-message\" id=\"error-message\" style=\"display: none;\">\n    <span class=\"error-icon\">❌</span>\n    <span class=\"error-text\" id=\"error-text\"></span>\n    <button class=\"action-btn secondary\" id=\"btn-retry\">再試行</button>\n  </div>\n</div>\n\n<style>\n.prediction-accuracy-monitor {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n  min-height: 100vh;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.page-header h1 {\n  margin: 0;\n  color: var(--text);\n}\n\n.header-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.filter-section {\n  margin-bottom: 20px;\n  padding: 20px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 20px;\n  align-items: end;\n  flex-wrap: wrap;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.filter-group label {\n  font-size: 14px;\n  color: var(--text-muted);\n}\n\n.summary-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.summary-card {\n  padding: 20px;\n  text-align: center;\n}\n\n.summary-header h3 {\n  margin: 0 0 5px 0;\n  color: var(--text);\n}\n\n.summary-subtitle {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.summary-value {\n  font-size: 32px;\n  font-weight: bold;\n  margin: 15px 0;\n  color: var(--primary);\n}\n\n.summary-trend {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  font-size: 14px;\n  color: var(--text-muted);\n}\n\n.alert-panel {\n  margin-bottom: 20px;\n  padding: 15px;\n  border-left: 4px solid #ff6a00;\n  background: var(--bg-card);\n}\n\n.alert-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 10px;\n}\n\n.alert-header h3 {\n  margin: 0;\n  color: #ff6a00;\n}\n\n.charts-section {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin-bottom: 20px;\n}\n\n.chart-card {\n  padding: 20px;\n}\n\n.chart-header {\n  margin-bottom: 15px;\n  border-bottom: 1px solid var(--border);\n  padding-bottom: 10px;\n}\n\n.chart-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.chart-container {\n  position: relative;\n  width: 100%;\n  height: 300px;\n}\n\n.chart-container canvas {\n  width: 100% !important;\n  height: 100% !important;\n}\n\n.table-header {\n  padding: 15px 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.table-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.sortable {\n  cursor: pointer;\n  user-select: none;\n}\n\n.sortable:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.sort-icon {\n  font-size: 12px;\n  margin-left: 5px;\n}\n\n.error-message {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 15px;\n  background: var(--bg-card);\n  border: 1px solid #ff6a00;\n  border-radius: 4px;\n  margin-top: 20px;\n}\n\n.error-icon {\n  font-size: 18px;\n}\n\n.error-text {\n  flex: 1;\n  color: var(--text);\n}\n\n@media (max-width: 768px) {\n  .charts-section {\n    grid-template-columns: 1fr;\n  }\n  \n  .filter-row {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .filter-group {\n    width: 100%;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}