{
  "screenId": "scr-1778591974844",
  "screenName": "予測精度監視画面",
  "html": "<div class=\"prediction-accuracy-monitor\">\n  <!-- ページヘッダー -->\n  <div class=\"page-header\">\n    <h1>予測精度監視画面</h1>\n    <div class=\"header-actions\">\n      <button class=\"action-btn\" id=\"btn-detailed-analysis\">詳細分析</button>\n      <button class=\"action-btn secondary\" id=\"btn-export-report\">レポート出力</button>\n    </div>\n  </div>\n\n  <!-- 予測精度サマリーカード -->\n  <div class=\"summary-cards\">\n    <div class=\"card summary-card\">\n      <h3>全体精度</h3>\n      <div class=\"metric-value\" id=\"overall-accuracy\">--</div>\n      <div class=\"metric-label\">平均予測精度</div>\n    </div>\n    <div class=\"card summary-card\">\n      <h3>MAPE</h3>\n      <div class=\"metric-value\" id=\"mape-value\">--</div>\n      <div class=\"metric-label\">平均絶対パーセント誤差</div>\n    </div>\n    <div class=\"card summary-card\">\n      <h3>RMSE</h3>\n      <div class=\"metric-value\" id=\"rmse-value\">--</div>\n      <div class=\"metric-label\">二乗平均平方根誤差</div>\n    </div>\n    <div class=\"card summary-card\">\n      <h3>アラート件数</h3>\n      <div class=\"metric-value alert-count\" id=\"alert-count\">--</div>\n      <div class=\"metric-label\">精度閾値未満</div>\n    </div>\n  </div>\n\n  <!-- フィルターエリア -->\n  <div class=\"card filter-section\">\n    <h3>フィルター設定</h3>\n    <div class=\"filter-grid\">\n      <div class=\"filter-item\">\n        <label for=\"period-select\">期間選択</label>\n        <select class=\"input\" id=\"period-select\">\n          <option value=\"7\">過去7日間</option>\n          <option value=\"30\" selected>過去30日間</option>\n          <option value=\"90\">過去3ヶ月</option>\n          <option value=\"180\">過去6ヶ月</option>\n          <option value=\"365\">過去12ヶ月</option>\n          <option value=\"730\">過去24ヶ月</option>\n        </select>\n      </div>\n      <div class=\"filter-item\">\n        <label for=\"store-select\">店舗選択</label>\n        <select class=\"input\" id=\"store-select\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div class=\"filter-item\">\n        <label for=\"category-select\">商品カテゴリ</label>\n        <select class=\"input\" id=\"category-select\">\n          <option value=\"\">全カテゴリ</option>\n          <option value=\"食品\">食品</option>\n          <option value=\"飲料\">飲料</option>\n          <option value=\"日用品\">日用品</option>\n        </select>\n      </div>\n      <div class=\"filter-item\">\n        <label for=\"accuracy-threshold\">精度閾値</label>\n        <select class=\"input\" id=\"accuracy-threshold\">\n          <option value=\"\">指定なし</option>\n          <option value=\"60\">60%以上</option>\n          <option value=\"70\">70%以上</option>\n          <option value=\"80\">80%以上</option>\n          <option value=\"90\">90%以上</option>\n        </select>\n      </div>\n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-apply-filter\">フィルター適用</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear-filter\">クリア</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- アラート通知パネル -->\n  <div class=\"card alert-panel\" id=\"alert-panel\" style=\"display: none;\">\n    <h3>アラート通知</h3>\n    <div id=\"alert-list\"></div>\n  </div>\n\n  <!-- 予測精度推移グラフ -->\n  <div class=\"card chart-section\">\n    <h3>予測精度推移</h3>\n    <div class=\"chart-controls\">\n      <button class=\"chart-period-btn active\" data-period=\"daily\">日次</button>\n      <button class=\"chart-period-btn\" data-period=\"weekly\">週次</button>\n      <button class=\"chart-period-btn\" data-period=\"monthly\">月次</button>\n    </div>\n    <div class=\"chart-container\">\n      <canvas id=\"accuracy-trend-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n  </div>\n\n  <!-- 予測vs実績比較チャート -->\n  <div class=\"card chart-section\">\n    <h3>予測vs実績比較</h3>\n    <div class=\"chart-container\">\n      <canvas id=\"prediction-vs-actual-chart\" width=\"800\" height=\"400\"></canvas>\n    </div>\n  </div>\n\n  <!-- 精度ランキング表 -->\n  <div class=\"card\">\n    <h3>精度ランキング</h3>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th class=\"sortable\" data-sort=\"rank\">順位</th>\n            <th class=\"sortable\" data-sort=\"store\">店舗名</th>\n            <th class=\"sortable\" data-sort=\"category\">商品カテゴリ</th>\n            <th class=\"sortable\" data-sort=\"accuracy\">予測精度 (%)</th>\n            <th class=\"sortable\" data-sort=\"mape\">MAPE (%)</th>\n            <th class=\"sortable\" data-sort=\"rmse\">RMSE</th>\n            <th class=\"sortable\" data-sort=\"predictions\">予測回数</th>\n            <th>ステータス</th>\n          </tr>\n        </thead>\n        <tbody id=\"ranking-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<style>\n.prediction-accuracy-monitor {\n  padding: 20px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.page-header h1 {\n  color: var(--text);\n  margin: 0;\n}\n\n.header-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.summary-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 24px;\n}\n\n.summary-card {\n  text-align: center;\n  padding: 24px;\n}\n\n.summary-card h3 {\n  color: var(--text);\n  margin: 0 0 12px 0;\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.metric-value {\n  font-size: 32px;\n  font-weight: bold;\n  color: var(--primary);\n  margin-bottom: 8px;\n}\n\n.metric-value.alert-count {\n  color: #ff6b6b;\n}\n\n.metric-label {\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n.filter-section {\n  margin-bottom: 24px;\n}\n\n.filter-section h3 {\n  color: var(--text);\n  margin: 0 0 16px 0;\n}\n\n.filter-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  align-items: end;\n}\n\n.filter-item label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 4px;\n  font-size: 14px;\n}\n\n.filter-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.alert-panel {\n  margin-bottom: 24px;\n  border-left: 4px solid #ff6b6b;\n}\n\n.alert-panel h3 {\n  color: var(--text);\n  margin: 0 0 16px 0;\n}\n\n.alert-item {\n  padding: 12px;\n  background: rgba(255, 107, 107, 0.1);\n  border-radius: 4px;\n  margin-bottom: 8px;\n  color: var(--text);\n}\n\n.chart-section {\n  margin-bottom: 24px;\n}\n\n.chart-section h3 {\n  color: var(--text);\n  margin: 0 0 16px 0;\n}\n\n.chart-controls {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n\n.chart-period-btn {\n  padding: 8px 16px;\n  border: 1px solid var(--border);\n  background: var(--bg-card);\n  color: var(--text);\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.chart-period-btn.active {\n  background: var(--primary);\n  color: white;\n  border-color: var(--primary);\n}\n\n.chart-container {\n  position: relative;\n  background: var(--bg-card);\n  border-radius: 4px;\n  padding: 16px;\n}\n\n.sortable {\n  cursor: pointer;\n  user-select: none;\n}\n\n.sortable:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 12px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.status-good {\n  background: rgba(34, 197, 94, 0.2);\n  color: #22c55e;\n}\n\n.status-warning {\n  background: rgba(251, 191, 36, 0.2);\n  color: #fbbf24;\n}\n\n.status-poor {\n  background: rgba(239, 68, 68, 0.2);\n  color: #ef4444;\n}\n\n.error-message {\n  text-align: center;\n  color: var(--text-muted);\n  padding: 40px;\n  font-style: italic;\n}\n\n.loading {\n  text-align: center;\n  color: var(--text-muted);\n  padding: 40px;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}