{
  "screenId": "scr-1778591907544",
  "screenName": "発注書作成画面",
  "html": "<div class=\"order-creation-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>発注書作成画面</h1>\n    <p class=\"muted\">AI需要予測結果を基に効率的な発注書を作成し、在庫最適化と売上機会損失を防ぐための発注業務を支援します</p>\n  </div>\n\n  <!-- 基本情報入力エリア -->\n  <div class=\"card\">\n    <h2>基本情報</h2>\n    <div class=\"form-grid\">\n      <div class=\"form-group\">\n        <label for=\"store-select\">店舗選択 <span class=\"required\">*</span></label>\n        <select id=\"store-select\" class=\"input\" required>\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"order-date\">発注日付 <span class=\"required\">*</span></label>\n        <input type=\"date\" id=\"order-date\" class=\"input\" required>\n      </div>\n      <div class=\"form-group\">\n        <label for=\"delivery-date\">納期指定 <span class=\"required\">*</span></label>\n        <input type=\"date\" id=\"delivery-date\" class=\"input\" required>\n      </div>\n    </div>\n  </div>\n\n  <!-- 商品検索・選択エリア -->\n  <div class=\"card\">\n    <h2>商品選択</h2>\n    <div class=\"search-controls\">\n      <div class=\"category-tabs\">\n        <button class=\"tab-btn active\" data-category=\"\">全て</button>\n        <button class=\"tab-btn\" data-category=\"食品\">食品</button>\n        <button class=\"tab-btn\" data-category=\"飲料\">飲料</button>\n        <button class=\"tab-btn\" data-category=\"日用品\">日用品</button>\n        <button class=\"tab-btn\" data-category=\"その他\">その他</button>\n      </div>\n      <div class=\"search-box\">\n        <input type=\"text\" id=\"product-search\" class=\"input\" placeholder=\"商品名・商品コードで検索\">\n        <button id=\"btn-product-search\" class=\"action-btn\">検索</button>\n      </div>\n    </div>\n    \n    <div class=\"product-list-area\">\n      <div class=\"table-wrap\">\n        <table id=\"product-table\">\n          <thead>\n            <tr>\n              <th>選択</th>\n              <th>商品コード</th>\n              <th>商品名</th>\n              <th>単価</th>\n              <th>AI予測数量</th>\n              <th>手動調整数量</th>\n              <th>予測根拠</th>\n              <th>在庫状況</th>\n              <th>過去実績</th>\n            </tr>\n          </thead>\n          <tbody id=\"product-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- 発注商品一覧エリア -->\n  <div class=\"card\">\n    <h2>発注商品一覧</h2>\n    <div class=\"table-wrap\">\n      <table id=\"order-items-table\">\n        <thead>\n          <tr>\n            <th>商品コード</th>\n            <th>商品名</th>\n            <th>単価</th>\n            <th>発注数量</th>\n            <th>小計</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"order-items-tbody\">\n        </tbody>\n      </table>\n    </div>\n    \n    <div class=\"order-summary\">\n      <div class=\"total-amount\">\n        <strong>発注総額: <span id=\"total-amount\">0</span>円</strong>\n      </div>\n      <div class=\"order-actions\">\n        <button id=\"btn-create-order\" class=\"action-btn\">発注書作成</button>\n        <button id=\"btn-back-to-list\" class=\"action-btn secondary\">発注管理に戻る</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 予測根拠詳細モーダル -->\n  <div id=\"prediction-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>AI予測根拠詳細</h3>\n        <button class=\"modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div id=\"prediction-details\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 在庫状況確認モーダル -->\n  <div id=\"inventory-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>在庫状況確認</h3>\n        <button class=\"modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div id=\"inventory-details\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 過去実績参照モーダル -->\n  <div id=\"history-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>過去実績参照</h3>\n        <button class=\"modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div id=\"history-details\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- エラーメッセージエリア -->\n  <div id=\"error-message\" class=\"error-message hidden\"></div>\n</div>\n\n<style>\n.order-creation-screen {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.screen-header {\n  margin-bottom: 30px;\n}\n\n.screen-header h1 {\n  color: var(--text);\n  margin-bottom: 10px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.form-group label {\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6a00;\n}\n\n.search-controls {\n  margin-bottom: 20px;\n}\n\n.category-tabs {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 15px;\n  flex-wrap: wrap;\n}\n\n.tab-btn {\n  padding: 8px 16px;\n  border: 1px solid var(--border);\n  background: var(--bg-card);\n  color: var(--text);\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.tab-btn:hover {\n  background: var(--primary-hover);\n}\n\n.tab-btn.active {\n  background: var(--primary);\n  color: white;\n  border-color: var(--primary);\n}\n\n.search-box {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.search-box .input {\n  flex: 1;\n  max-width: 400px;\n}\n\n.product-list-area {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.order-summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  padding-top: 20px;\n  border-top: 1px solid var(--border);\n}\n\n.total-amount {\n  font-size: 18px;\n  color: var(--text);\n}\n\n.order-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 80%;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  color: var(--text-muted);\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-close:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.error-message {\n  position: fixed;\n  top: 20px;\n  right: 20px;\n  background: #ff4444;\n  color: white;\n  padding: 15px 20px;\n  border-radius: 4px;\n  z-index: 1001;\n  max-width: 400px;\n}\n\n.quantity-input {\n  width: 80px;\n  text-align: center;\n}\n\n.btn-small {\n  padding: 4px 8px;\n  font-size: 12px;\n  min-width: auto;\n}\n\n.prediction-info {\n  background: var(--bg-main);\n  padding: 15px;\n  border-radius: 4px;\n  margin-bottom: 15px;\n}\n\n.prediction-factors {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 15px;\n  margin-top: 15px;\n}\n\n.factor-item {\n  background: var(--bg-card);\n  padding: 10px;\n  border-radius: 4px;\n  border-left: 3px solid var(--primary);\n}\n\n.factor-label {\n  font-weight: 500;\n  color: var(--text);\n  margin-bottom: 5px;\n}\n\n.factor-value {\n  color: var(--text-muted);\n}\n\n.inventory-info {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 15px;\n}\n\n.inventory-item {\n  text-align: center;\n  padding: 15px;\n  background: var(--bg-main);\n  border-radius: 4px;\n}\n\n.inventory-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 5px;\n}\n\n.inventory-value {\n  font-size: 18px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.history-chart {\n  margin-top: 20px;\n}\n\n.chart-container {\n  background: var(--bg-main);\n  padding: 20px;\n  border-radius: 4px;\n  text-align: center;\n  color: var(--text-muted);\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}