  "screenName": "データ収集ログ管理",
  "html": "<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>データ収集ログ管理</h2>\n    <div class=\"header-actions\">\n      <button class=\"action-btn\" id=\"btn-auto-refresh-toggle\">\n        <span id=\"auto-refresh-status\">自動更新: OFF</span>\n      </button>\n      <button class=\"action-btn secondary\" id=\"btn-alert-settings\">アラート通知設定</button>\n    </div>\n  </div>\n\n  <!-- データ収集状況サマリー -->\n  <div class=\"summary-section\">\n    <div class=\"summary-cards\">\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">総収集件数</div>\n        <div class=\"summary-value\" id=\"total-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">成功件数</div>\n        <div class=\"summary-value success\" id=\"success-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">エラー件数</div>\n        <div class=\"summary-value error\" id=\"error-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">最終実行時刻</div>\n        <div class=\"summary-value\" id=\"last-execution\">-</div>\n      </div>\n    </div>\n    <div class=\"error-indicator\" id=\"error-indicator\">\n      <span class=\"indicator-icon\">⚠️</span>\n      <span class=\"indicator-text\">データ収集エラーが発生しています</span>\n    </div>\n  </div>\n\n  <!-- 検索・絞り込みエリア -->\n  <div class=\"search-section\">\n    <div class=\"search-row\">\n      <div class=\"search-field\">\n        <label>データソース</label>\n        <select class=\"input\" id=\"filter-data-source\">\n          <option value=\"\">すべて</option>\n          <option value=\"POSシステム\">POSシステム</option>\n          <option value=\"気象庁API\">気象庁API</option>\n          <option value=\"店舗システム\">店舗システム</option>\n          <option value=\"外部API\">外部API</option>\n        </select>\n      </div>\n      <div class=\"search-field\">\n        <label>ログレベル</label>\n        <select class=\"input\" id=\"filter-log-level\">\n          <option value=\"\">すべて</option>\n          <option value=\"INFO\">INFO</option>\n          <option value=\"WARN\">WARN</option>\n          <option value=\"ERROR\">ERROR</option>\n        </select>\n      </div>\n      <div class=\"search-field\">\n        <label>処理ステータス</label>\n        <select class=\"input\" id=\"filter-status\">\n          <option value=\"\">すべて</option>\n          <option value=\"実行中\">実行中</option>\n          <option value=\"成功\">成功</option>\n          <option value=\"失敗\">失敗</option>\n          <option value=\"警告\">警告</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"search-row\">\n      <div class=\"search-field\">\n        <label>収集開始日時</label>\n        <input type=\"datetime-local\" class=\"input\" id=\"filter-start-date\">\n      </div>\n      <div class=\"search-field\">\n        <label>収集終了日時</label>\n        <input type=\"datetime-local\" class=\"input\" id=\"filter-end-date\">\n      </div>\n      <div class=\"search-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear\">クリア</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ログ一覧表示エリア -->\n  <div class=\"table-actions\">\n    <button class=\"action-btn secondary\" id=\"btn-export\">ログエクスポート</button>\n    <button class=\"action-btn secondary\" id=\"btn-retry-selected\">選択ログ再実行</button>\n  </div>\n\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th><input type=\"checkbox\" id=\"select-all\"></th>\n          <th>収集日時</th>\n          <th>データ種別</th>\n          <th>データソース</th>\n          <th>店舗</th>\n          <th>処理ステータス</th>\n          <th>収集件数</th>\n          <th>エラー件数</th>\n          <th>処理時間</th>\n          <th>品質スコア</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"log-table-body\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- ログ詳細モーダル -->\n<div class=\"modal hidden\" id=\"log-detail-modal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>ログ詳細情報</h3>\n      <button class=\"modal-close\" id=\"modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"detail-section\">\n        <div class=\"detail-row\">\n          <label>ログID:</label>\n          <span id=\"detail-log-id\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ種別:</label>\n          <span id=\"detail-data-type\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データソース:</label>\n          <span id=\"detail-data-source\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理ステータス:</label>\n          <span id=\"detail-status\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集開始日時:</label>\n          <span id=\"detail-start-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集終了日時:</label>\n          <span id=\"detail-end-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理時間:</label>\n          <span id=\"detail-processing-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集件数:</label>\n          <span id=\"detail-collected-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>エラー件数:</label>\n          <span id=\"detail-error-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ品質スコア:</label>\n          <span id=\"detail-quality-score\"></span>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>エラーメッセージ:</label>\n          <div class=\"error-message-box\" id=\"detail-error-message\"></div>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>備考:</label>\n          <div class=\"remarks-box\" id=\"detail-remarks\"></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn secondary\" id=\"btn-retry-single\">再実行</button>\n      <button class=\"action-btn secondary\" id=\"btn-close-modal\">閉じる</button>\n    </div>\n  </div>\n</div>\n\n<!-- アラート通知設定モーダル -->\n<div class=\"modal hidden\" id=\"alert-settings-modal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>アラート通知設定</h3>\n      <button class=\"modal-close\" id=\"alert-modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"setting-section\">\n        <div class=\"setting-row\">\n          <label>エラー発生時通知:</label>\n          <input type=\"checkbox\" id=\"alert-error-enabled\" checked>\n        </div>\n        <div class=\"setting-row\">\n          <label>通知メールアドレス:</label>\n          <input type=\"email\" class=\"input\" id=\"alert-email\" placeholder=\"admin@example.com\">\n        </div>\n        <div class=\"setting-row\">\n          <label>通知頻度:</label>\n          <select class=\"input\" id=\"alert-frequency\">\n            <option value=\"immediate\">即座</option>\n            <option value=\"hourly\">1時間毎</option>\n            <option value=\"daily\">1日毎</option>\n          </select>\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn\" id=\"btn-save-alert-settings\">保存</button>\n      <button class=\"action-btn secondary\" id=\"btn-close-alert-modal\">キャンセル</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n}\n\n.header-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.summary-section {\n  margin-bottom: 1.5rem;\n}\n\n.summary-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n\n.summary-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 1rem;\n  text-align: center;\n}\n\n.summary-label {\n  font-size: 0.9rem;\n  color: var(--text-muted);\n  margin-bottom: 0.5rem;\n}\n\n.summary-value {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.summary-value.success {\n  color: #28a745;\n}\n\n.summary-value.error {\n  color: #dc3545;\n}\n\n.error-indicator {\n  display: none;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.75rem;\n  background: rgba(220, 53, 69, 0.1);\n  border: 1px solid #dc3545;\n  border-radius: 4px;\n  color: #dc3545;\n}\n\n.error-indicator.show {\n  display: flex;\n}\n\n.search-section {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 1rem;\n  margin-bottom: 1rem;\n}\n\n.search-row {\n  display: flex;\n  gap: 1rem;\n  align-items: end;\n  margin-bottom: 1rem;\n}\n\n.search-row:last-child {\n  margin-bottom: 0;\n}\n\n.search-field {\n  flex: 1;\n}\n\n.search-field label {\n  display: block;\n  margin-bottom: 0.25rem;\n  font-size: 0.9rem;\n  color: var(--text);\n}\n\n.search-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.table-actions {\n  display: flex;\n  gap: 0.5rem;\n  margin-bottom: 1rem;\n}\n\n.status-badge {\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.8rem;\n  font-weight: bold;\n}\n\n.status-success {\n  background: rgba(40, 167, 69, 0.1);\n  color: #28a745;\n  border: 1px solid #28a745;\n}\n\n.status-error {\n  background: rgba(220, 53, 69, 0.1);\n  color: #dc3545;\n  border: 1px solid #dc3545;\n}\n\n.status-warning {\n  background: rgba(255, 193, 7, 0.1);\n  color: #ffc107;\n  border: 1px solid #ffc107;\n}\n\n.status-running {\n  background: rgba(0, 123, 255, 0.1);\n  color: #007bff;\n  border: 1px solid #007bff;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 1.5rem;\n  cursor: pointer;\n  color: var(--text-muted);\n}\n\n.modal-body {\n  padding: 1rem;\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.5rem;\n  padding: 1rem;\n  border-top: 1px solid var(--border);\n}\n\n.detail-section {\n  display: grid;\n  gap: 1rem;\n}\n\n.detail-row {\n  display: grid;\n  grid-template-columns: 150px 1fr;\n  gap: 1rem;\n  align-items: start;\n}\n\n.detail-row.full-width {\n  grid-template-columns: 1fr;\n}\n\n.detail-row label {\n  font-weight: bold;\n  color: var(--text);\n}\n\n.error-message-box,\n.remarks-box {\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 0.75rem;\n  min-height: 100px;\n  white-space: pre-wrap;\n  font-family: monospace;\n  font-size: 0.9rem;\n  color: var(--text);\n}\n\n.setting-section {\n  display: grid;\n  gap: 1rem;\n}\n\n.setting-row {\n  display: grid;\n  grid-template-columns: 200px 1fr;\n  gap: 1rem;\n  align-items: center;\n}\n\n.setting-row label {\n  font-weight: bold;\n  color: var(--text);\n}\n</style>",
