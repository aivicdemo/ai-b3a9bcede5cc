  "screenName": "データ収集ログ管理",
  "html": "<div class=\"screen-header\">\n  <h1>データ収集ログ管理</h1>\n  <p class=\"muted\">AI需要予測システムで使用する各種データの収集状況、エラー発生状況、データ品質を監視・管理</p>\n</div>\n\n<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>検索・絞り込み条件</h2>\n    <div class=\"auto-refresh-section\">\n      <label>\n        <input type=\"checkbox\" id=\"auto-refresh-toggle\"> 自動更新（30秒間隔）\n      </label>\n      <button class=\"action-btn secondary\" id=\"btn-alert-settings\">アラート通知設定</button>\n    </div>\n  </div>\n  \n  <div class=\"filter-section\">\n    <div class=\"filter-row\">\n      <div class=\"filter-item\">\n        <label>データソース</label>\n        <select id=\"select-data-source\" class=\"input\">\n          <option value=\"\">すべて</option>\n          <option value=\"POSシステム\">POSシステム</option>\n          <option value=\"気象庁API\">気象庁API</option>\n          <option value=\"店舗システム\">店舗システム</option>\n          <option value=\"外部API\">外部API</option>\n          <option value=\"イベント情報API\">イベント情報API</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-item\">\n        <label>ログレベル</label>\n        <select id=\"select-log-level\" class=\"input\">\n          <option value=\"\">すべて</option>\n          <option value=\"INFO\">INFO</option>\n          <option value=\"WARN\">WARN</option>\n          <option value=\"ERROR\">ERROR</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-item\">\n        <label>処理ステータス</label>\n        <select id=\"select-status\" class=\"input\">\n          <option value=\"\">すべて</option>\n          <option value=\"実行中\">実行中</option>\n          <option value=\"成功\">成功</option>\n          <option value=\"失敗\">失敗</option>\n          <option value=\"警告\">警告</option>\n        </select>\n      </div>\n    </div>\n    \n    <div class=\"filter-row\">\n      <div class=\"filter-item\">\n        <label>収集開始日時</label>\n        <input type=\"datetime-local\" id=\"input-start-date\" class=\"input\">\n      </div>\n      \n      <div class=\"filter-item\">\n        <label>収集終了日時</label>\n        <input type=\"datetime-local\" id=\"input-end-date\" class=\"input\">\n      </div>\n      \n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n        <button class=\"action-btn secondary\" id=\"btn-reset\">リセット</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"summary-section\">\n  <div class=\"summary-cards\">\n    <div class=\"summary-card\">\n      <div class=\"summary-title\">総収集件数</div>\n      <div class=\"summary-value\" id=\"total-count\">0</div>\n    </div>\n    <div class=\"summary-card success\">\n      <div class=\"summary-title\">成功件数</div>\n      <div class=\"summary-value\" id=\"success-count\">0</div>\n    </div>\n    <div class=\"summary-card error\">\n      <div class=\"summary-title\">エラー件数</div>\n      <div class=\"summary-value\" id=\"error-count\">0</div>\n    </div>\n    <div class=\"summary-card\">\n      <div class=\"summary-title\">最終実行時刻</div>\n      <div class=\"summary-value\" id=\"last-execution\">-</div>\n    </div>\n  </div>\n  \n  <div class=\"error-indicator\" id=\"error-indicator\">\n    <span class=\"indicator-icon\">⚠</span>\n    <span class=\"indicator-text\">データ収集エラーが発生しています</span>\n  </div>\n</div>\n\n<div class=\"card\">\n  <div class=\"card-header\">\n    <h2>データ収集ログ一覧</h2>\n    <div class=\"actions\">\n      <button class=\"action-btn secondary\" id=\"btn-retry-errors\">エラーログ再実行</button>\n      <button class=\"action-btn secondary\" id=\"btn-export\">ログエクスポート</button>\n    </div>\n  </div>\n  \n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th><input type=\"checkbox\" id=\"select-all\"></th>\n          <th>収集日時</th>\n          <th>データソース</th>\n          <th>データ種別</th>\n          <th>店舗</th>\n          <th>ステータス</th>\n          <th>収集件数</th>\n          <th>エラー件数</th>\n          <th>処理時間</th>\n          <th>品質スコア</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"log-table-body\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- ログ詳細モーダル -->\n<div id=\"log-detail-modal\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>ログ詳細情報</h3>\n      <button class=\"modal-close\" id=\"modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"detail-section\">\n        <div class=\"detail-row\">\n          <label>ログID:</label>\n          <span id=\"detail-log-id\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ種別:</label>\n          <span id=\"detail-data-type\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データソース:</label>\n          <span id=\"detail-data-source\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集開始日時:</label>\n          <span id=\"detail-start-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集終了日時:</label>\n          <span id=\"detail-end-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理ステータス:</label>\n          <span id=\"detail-status\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>対象期間:</label>\n          <span id=\"detail-period\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集件数:</label>\n          <span id=\"detail-success-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>エラー件数:</label>\n          <span id=\"detail-error-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理時間:</label>\n          <span id=\"detail-processing-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ品質スコア:</label>\n          <span id=\"detail-quality-score\"></span>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>エラーメッセージ:</label>\n          <div id=\"detail-error-message\" class=\"error-message-box\"></div>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>備考:</label>\n          <div id=\"detail-remarks\" class=\"remarks-box\"></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn secondary\" id=\"btn-retry-single\">再実行</button>\n      <button class=\"action-btn secondary\" id=\"btn-close-modal\">閉じる</button>\n    </div>\n  </div>\n</div>\n\n<!-- アラート通知設定モーダル -->\n<div id=\"alert-settings-modal\" class=\"modal hidden\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>アラート通知設定</h3>\n      <button class=\"modal-close\" id=\"alert-modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"setting-section\">\n        <div class=\"setting-row\">\n          <label>\n            <input type=\"checkbox\" id=\"alert-error-enabled\"> エラー発生時の通知\n          </label>\n        </div>\n        <div class=\"setting-row\">\n          <label>\n            <input type=\"checkbox\" id=\"alert-quality-enabled\"> データ品質低下時の通知\n          </label>\n        </div>\n        <div class=\"setting-row\">\n          <label>品質スコア閾値:</label>\n          <input type=\"number\" id=\"quality-threshold\" class=\"input\" min=\"0\" max=\"100\" value=\"80\">\n        </div>\n        <div class=\"setting-row\">\n          <label>通知先メールアドレス:</label>\n          <input type=\"email\" id=\"alert-email\" class=\"input\" placeholder=\"admin@example.com\">\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn\" id=\"btn-save-alert-settings\">保存</button>\n      <button class=\"action-btn secondary\" id=\"btn-cancel-alert-settings\">キャンセル</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.screen-header {\n  margin-bottom: 24px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n}\n\n.auto-refresh-section {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.auto-refresh-section label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  font-size: 14px;\n}\n\n.filter-section {\n  margin-bottom: 24px;\n}\n\n.filter-row {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 16px;\n  align-items: end;\n}\n\n.filter-item {\n  flex: 1;\n}\n\n.filter-item label {\n  display: block;\n  margin-bottom: 4px;\n  color: var(--text);\n  font-size: 14px;\n}\n\n.filter-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.summary-section {\n  margin-bottom: 24px;\n}\n\n.summary-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.summary-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 16px;\n  text-align: center;\n}\n\n.summary-card.success {\n  border-left: 4px solid #22c55e;\n}\n\n.summary-card.error {\n  border-left: 4px solid #ef4444;\n}\n\n.summary-title {\n  color: var(--text-muted);\n  font-size: 14px;\n  margin-bottom: 8px;\n}\n\n.summary-value {\n  color: var(--text);\n  font-size: 24px;\n  font-weight: bold;\n}\n\n.error-indicator {\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid #ef4444;\n  border-radius: 8px;\n  padding: 12px 16px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: #ef4444;\n}\n\n.error-indicator.hidden {\n  display: none;\n}\n\n.indicator-icon {\n  font-size: 18px;\n}\n\n.actions {\n  display: flex;\n  gap: 8px;\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: bold;\n}\n\n.status-success {\n  background: rgba(34, 197, 94, 0.1);\n  color: #22c55e;\n}\n\n.status-error {\n  background: rgba(239, 68, 68, 0.1);\n  color: #ef4444;\n}\n\n.status-warning {\n  background: rgba(245, 158, 11, 0.1);\n  color: #f59e0b;\n}\n\n.status-running {\n  background: rgba(59, 130, 246, 0.1);\n  color: #3b82f6;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal.hidden {\n  display: none;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px 24px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  color: var(--text-muted);\n  padding: 0;\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-close:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 24px;\n}\n\n.modal-footer {\n  padding: 16px 24px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\n\n.detail-section {\n  display: grid;\n  gap: 16px;\n}\n\n.detail-row {\n  display: grid;\n  grid-template-columns: 150px 1fr;\n  gap: 16px;\n  align-items: start;\n}\n\n.detail-row.full-width {\n  grid-template-columns: 1fr;\n}\n\n.detail-row label {\n  font-weight: bold;\n  color: var(--text);\n}\n\n.detail-row span {\n  color: var(--text);\n}\n\n.error-message-box, .remarks-box {\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 12px;\n  color: var(--text);\n  font-family: monospace;\n  font-size: 14px;\n  white-space: pre-wrap;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.setting-section {\n  display: grid;\n  gap: 16px;\n}\n\n.setting-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.setting-row label {\n  color: var(--text);\n  font-size: 14px;\n}\n\n.quality-score {\n  font-weight: bold;\n}\n\n.quality-high {\n  color: #22c55e;\n}\n\n.quality-medium {\n  color: #f59e0b;\n}\n\n.quality-low {\n  color: #ef4444;\n}\n\n.row-selected {\n  background: rgba(59, 130, 246, 0.1);\n}\n\n.error-message {\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid #ef4444;\n  border-radius: 4px;\n  padding: 8px 12px;\n  color: #ef4444;\n  font-size: 14px;\n  margin: 8px 0;\n}\n\n.error-message.hidden {\n  display: none;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
