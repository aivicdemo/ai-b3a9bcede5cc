{
  "screenId": "scr-1778591864631",
  "screenName": "データ収集ログ管理",
  "html": "<div class=\"data-collection-log-management\">\n  <!-- ヘッダー部分 -->\n  <div class=\"header-section\">\n    <h2>データ収集ログ管理</h2>\n    <div class=\"header-controls\">\n      <div class=\"auto-refresh-toggle\">\n        <label>\n          <input type=\"checkbox\" id=\"auto-refresh-toggle\"> 自動更新\n        </label>\n      </div>\n      <button class=\"action-btn\" id=\"btn-alert-settings\">アラート通知設定</button>\n    </div>\n  </div>\n\n  <!-- サマリー情報 -->\n  <div class=\"summary-section\">\n    <div class=\"card\">\n      <h3>データ収集状況サマリー</h3>\n      <div class=\"summary-grid\">\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">総収集件数</span>\n          <span class=\"summary-value\" id=\"total-count\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">成功件数</span>\n          <span class=\"summary-value success\" id=\"success-count\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">エラー件数</span>\n          <span class=\"summary-value error\" id=\"error-count\">-</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">成功率</span>\n          <span class=\"summary-value\" id=\"success-rate\">-</span>\n        </div>\n      </div>\n      <div class=\"error-indicator\">\n        <span class=\"indicator-label\">システム状態:</span>\n        <span class=\"status-indicator\" id=\"system-status\">正常</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター部分 -->\n  <div class=\"filter-section\">\n    <div class=\"card\">\n      <h3>検索・フィルター</h3>\n      <div class=\"filter-grid\">\n        <div class=\"filter-item\">\n          <label>データソース</label>\n          <select id=\"filter-data-source\" class=\"input\">\n            <option value=\"\">すべてのデータソース</option>\n            <option value=\"POSシステム\">POSシステム</option>\n            <option value=\"気象庁API\">気象庁API</option>\n            <option value=\"店舗システム\">店舗システム</option>\n            <option value=\"在庫管理システム\">在庫管理システム</option>\n            <option value=\"外部API\">外部API</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>ログレベル</label>\n          <select id=\"filter-log-level\" class=\"input\">\n            <option value=\"\">すべてのレベル</option>\n            <option value=\"INFO\">INFO</option>\n            <option value=\"WARNING\">WARNING</option>\n            <option value=\"ERROR\">ERROR</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>収集開始日時</label>\n          <input type=\"datetime-local\" id=\"filter-start-date\" class=\"input\">\n        </div>\n        <div class=\"filter-item\">\n          <label>収集終了日時</label>\n          <input type=\"datetime-local\" id=\"filter-end-date\" class=\"input\">\n        </div>\n        <div class=\"filter-item\">\n          <label>処理ステータス</label>\n          <select id=\"filter-status\" class=\"input\">\n            <option value=\"\">すべてのステータス</option>\n            <option value=\"実行中\">実行中</option>\n            <option value=\"成功\">成功</option>\n            <option value=\"失敗\">失敗</option>\n            <option value=\"警告\">警告</option>\n          </select>\n        </div>\n        <div class=\"filter-actions\">\n          <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n          <button class=\"action-btn secondary\" id=\"btn-clear-filter\">フィルタクリア</button>\n          <button class=\"action-btn secondary\" id=\"btn-export\">ログエクスポート</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ログ一覧 -->\n  <div class=\"log-list-section\">\n    <div class=\"card\">\n      <h3>データ収集ログ一覧</h3>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>ログID</th>\n              <th>データ種別</th>\n              <th>データソース</th>\n              <th>店舗</th>\n              <th>収集開始日時</th>\n              <th>収集終了日時</th>\n              <th>ステータス</th>\n              <th>収集件数</th>\n              <th>エラー件数</th>\n              <th>処理時間</th>\n              <th>品質スコア</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"log-table-body\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- ログ詳細モーダル -->\n  <div id=\"log-detail-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>ログ詳細情報</h3>\n        <button class=\"modal-close\" id=\"modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"detail-grid\">\n          <div class=\"detail-item\">\n            <label>ログID:</label>\n            <span id=\"detail-log-id\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>データ種別:</label>\n            <span id=\"detail-data-type\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>データソース:</label>\n            <span id=\"detail-data-source\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>店舗ID:</label>\n            <span id=\"detail-store-id\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>収集開始日時:</label>\n            <span id=\"detail-start-time\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>収集終了日時:</label>\n            <span id=\"detail-end-time\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>処理ステータス:</label>\n            <span id=\"detail-status\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>対象期間開始日:</label>\n            <span id=\"detail-target-start\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>対象期間終了日:</label>\n            <span id=\"detail-target-end\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>収集件数:</label>\n            <span id=\"detail-collected-count\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>エラー件数:</label>\n            <span id=\"detail-error-count\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>処理時間:</label>\n            <span id=\"detail-processing-time\">-</span>\n          </div>\n          <div class=\"detail-item\">\n            <label>データ品質スコア:</label>\n            <span id=\"detail-quality-score\">-</span>\n          </div>\n          <div class=\"detail-item full-width\">\n            <label>エラーメッセージ:</label>\n            <div id=\"detail-error-message\" class=\"error-message-box\">-</div>\n          </div>\n          <div class=\"detail-item full-width\">\n            <label>備考:</label>\n            <div id=\"detail-remarks\">-</div>\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn secondary\" id=\"modal-close-btn\">閉じる</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- アラート設定モーダル -->\n  <div id=\"alert-settings-modal\" class=\"modal hidden\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>アラート通知設定</h3>\n        <button class=\"modal-close\" id=\"alert-modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"alert-settings-form\">\n          <div class=\"form-group\">\n            <label>エラー発生時の通知</label>\n            <label><input type=\"checkbox\" id=\"alert-error\" checked> エラー発生時に通知する</label>\n          </div>\n          <div class=\"form-group\">\n            <label>警告発生時の通知</label>\n            <label><input type=\"checkbox\" id=\"alert-warning\"> 警告発生時に通知する</label>\n          </div>\n          <div class=\"form-group\">\n            <label>品質スコア閾値</label>\n            <input type=\"number\" id=\"alert-quality-threshold\" class=\"input\" value=\"80\" min=\"0\" max=\"100\">\n            <small class=\"muted\">品質スコアがこの値を下回った場合に通知</small>\n          </div>\n          <div class=\"form-group\">\n            <label>通知先メールアドレス</label>\n            <input type=\"email\" id=\"alert-email\" class=\"input\" placeholder=\"admin@example.com\">\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn\" id=\"save-alert-settings\">設定保存</button>\n        <button class=\"action-btn secondary\" id=\"alert-modal-close-btn\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.data-collection-log-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.header-section {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-section h2 {\n  margin: 0;\n  color: var(--text);\n}\n\n.header-controls {\n  display: flex;\n  gap: 15px;\n  align-items: center;\n}\n\n.auto-refresh-toggle label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.summary-section {\n  margin-bottom: 20px;\n}\n\n.summary-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n  margin-bottom: 15px;\n}\n\n.summary-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.summary-label {\n  font-size: 0.9em;\n  color: var(--text-muted);\n}\n\n.summary-value {\n  font-size: 1.5em;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.summary-value.success {\n  color: #4ade80;\n}\n\n.summary-value.error {\n  color: #f87171;\n}\n\n.error-indicator {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px;\n  background: var(--bg-main);\n  border-radius: 6px;\n}\n\n.indicator-label {\n  color: var(--text-muted);\n}\n\n.status-indicator {\n  padding: 4px 12px;\n  border-radius: 20px;\n  font-size: 0.9em;\n  font-weight: bold;\n  background: #4ade80;\n  color: #1a2a40;\n}\n\n.status-indicator.warning {\n  background: #fbbf24;\n  color: #1a2a40;\n}\n\n.status-indicator.error {\n  background: #f87171;\n  color: #1a2a40;\n}\n\n.filter-section {\n  margin-bottom: 20px;\n}\n\n.filter-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 15px;\n  margin-bottom: 15px;\n}\n\n.filter-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.filter-item label {\n  font-size: 0.9em;\n  color: var(--text-muted);\n}\n\n.filter-actions {\n  grid-column: 1 / -1;\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.log-list-section {\n  margin-bottom: 20px;\n}\n\n.table-wrap {\n  max-height: 600px;\n  overflow-y: auto;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\n\nth, td {\n  padding: 12px 8px;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\n\nth {\n  background: var(--bg-card);\n  color: var(--text);\n  font-weight: bold;\n  position: sticky;\n  top: 0;\n}\n\ntd {\n  color: var(--text);\n}\n\n.log-row {\n  cursor: pointer;\n}\n\n.log-row:hover {\n  background: var(--bg-card);\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 0.8em;\n  font-weight: bold;\n}\n\n.status-success {\n  background: rgba(74, 222, 128, 0.2);\n  color: #4ade80;\n}\n\n.status-error {\n  background: rgba(248, 113, 113, 0.2);\n  color: #f87171;\n}\n\n.status-warning {\n  background: rgba(251, 191, 36, 0.2);\n  color: #fbbf24;\n}\n\n.status-running {\n  background: rgba(59, 130, 246, 0.2);\n  color: #3b82f6;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal.hidden {\n  display: none;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-close:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.modal-footer {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n}\n\n.detail-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 15px;\n}\n\n.detail-item {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.detail-item.full-width {\n  grid-column: 1 / -1;\n}\n\n.detail-item label {\n  font-weight: bold;\n  color: var(--text-muted);\n  font-size: 0.9em;\n}\n\n.detail-item span, .detail-item div {\n  color: var(--text);\n}\n\n.error-message-box {\n  background: var(--bg-main);\n  padding: 10px;\n  border-radius: 4px;\n  border-left: 3px solid #f87171;\n  font-family: monospace;\n  font-size: 0.9em;\n  white-space: pre-wrap;\n}\n\n.alert-settings-form {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.form-group label {\n  font-weight: bold;\n  color: var(--text);\n}\n\n.form-group small {\n  font-size: 0.8em;\n  color: var(--text-muted);\n}\n\n.retry-btn {\n  background: #3b82f6;\n  color: white;\n  border: none;\n  padding: 4px 8px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 0.8em;\n}\n\n.retry-btn:hover {\n  background: #2563eb;\n}\n\n.retry-btn:disabled {\n  background: var(--text-muted);\n  cursor: not-allowed;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}