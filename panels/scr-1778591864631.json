  "screenName": "データ収集ログ管理",
  "html": "<div class=\"data-collection-log-management\">\n  <!-- ヘッダー部分 -->\n  <div class=\"header-section\">\n    <h1>データ収集ログ管理</h1>\n    <div class=\"header-controls\">\n      <div class=\"auto-refresh-toggle\">\n        <label>\n          <input type=\"checkbox\" id=\"auto-refresh-toggle\"> 自動更新\n        </label>\n      </div>\n      <button class=\"action-btn\" id=\"btn-alert-settings\">アラート通知設定</button>\n    </div>\n  </div>\n\n  <!-- データ収集状況サマリー -->\n  <div class=\"summary-section\">\n    <div class=\"card\">\n      <h3>データ収集状況サマリー</h3>\n      <div class=\"summary-grid\">\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">今日の収集件数</span>\n          <span class=\"summary-value\" id=\"today-count\">0</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">成功率</span>\n          <span class=\"summary-value\" id=\"success-rate\">0%</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">エラー件数</span>\n          <span class=\"summary-value error\" id=\"error-count\">0</span>\n        </div>\n        <div class=\"summary-item\">\n          <span class=\"summary-label\">最終収集日時</span>\n          <span class=\"summary-value\" id=\"last-collection\">-</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- エラー状況インジケーター -->\n  <div class=\"status-indicator-section\">\n    <div class=\"card\">\n      <h3>システム状況</h3>\n      <div class=\"status-indicators\">\n        <div class=\"status-item\">\n          <div class=\"status-indicator\" id=\"pos-status\"></div>\n          <span>POSシステム</span>\n        </div>\n        <div class=\"status-item\">\n          <div class=\"status-indicator\" id=\"weather-status\"></div>\n          <span>天候データ</span>\n        </div>\n        <div class=\"status-item\">\n          <div class=\"status-indicator\" id=\"event-status\"></div>\n          <span>イベントデータ</span>\n        </div>\n        <div class=\"status-item\">\n          <div class=\"status-indicator\" id=\"inventory-status\"></div>\n          <span>在庫システム</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 検索・フィルター部分 -->\n  <div class=\"filter-section\">\n    <div class=\"card\">\n      <h3>検索・フィルター</h3>\n      <div class=\"filter-grid\">\n        <div class=\"filter-item\">\n          <label>データソース</label>\n          <select class=\"input\" id=\"filter-data-source\">\n            <option value=\"\">すべてのデータソース</option>\n            <option value=\"POSシステム\">POSシステム</option>\n            <option value=\"気象庁API\">気象庁API</option>\n            <option value=\"店舗システム\">店舗システム</option>\n            <option value=\"在庫管理システム\">在庫管理システム</option>\n            <option value=\"外部API\">外部API</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>ログレベル</label>\n          <select class=\"input\" id=\"filter-log-level\">\n            <option value=\"\">すべてのレベル</option>\n            <option value=\"INFO\">INFO</option>\n            <option value=\"WARNING\">WARNING</option>\n            <option value=\"ERROR\">ERROR</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>開始日時</label>\n          <input type=\"datetime-local\" class=\"input\" id=\"filter-start-date\">\n        </div>\n        <div class=\"filter-item\">\n          <label>終了日時</label>\n          <input type=\"datetime-local\" class=\"input\" id=\"filter-end-date\">\n        </div>\n        <div class=\"filter-item\">\n          <label>処理ステータス</label>\n          <select class=\"input\" id=\"filter-status\">\n            <option value=\"\">すべてのステータス</option>\n            <option value=\"実行中\">実行中</option>\n            <option value=\"成功\">成功</option>\n            <option value=\"失敗\">失敗</option>\n            <option value=\"警告\">警告</option>\n          </select>\n        </div>\n        <div class=\"filter-item\">\n          <label>店舗</label>\n          <select class=\"input\" id=\"filter-store\">\n            <option value=\"\">すべての店舗</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"filter-actions\">\n        <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n        <button class=\"action-btn secondary\" id=\"btn-clear-filter\">フィルタークリア</button>\n        <button class=\"action-btn secondary\" id=\"btn-export\">ログエクスポート</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ログ一覧表示 -->\n  <div class=\"log-list-section\">\n    <div class=\"card\">\n      <h3>データ収集ログ一覧</h3>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>ログID</th>\n              <th>データ種別</th>\n              <th>データソース</th>\n              <th>店舗</th>\n              <th>収集開始日時</th>\n              <th>収集終了日時</th>\n              <th>ステータス</th>\n              <th>収集件数</th>\n              <th>エラー件数</th>\n              <th>処理時間</th>\n              <th>品質スコア</th>\n              <th>操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"log-table-body\">\n          </tbody>\n        </table>\n      </div>\n      <div class=\"pagination\" id=\"pagination\">\n        <button class=\"action-btn secondary\" id=\"btn-prev-page\">前のページ</button>\n        <span id=\"page-info\">1 / 1</span>\n        <button class=\"action-btn secondary\" id=\"btn-next-page\">次のページ</button>\n        <select class=\"input\" id=\"page-size\">\n          <option value=\"20\">20件/ページ</option>\n          <option value=\"50\">50件/ページ</option>\n          <option value=\"100\">100件/ページ</option>\n        </select>\n      </div>\n    </div>\n  </div>\n\n  <!-- ログ詳細モーダル -->\n  <div class=\"modal hidden\" id=\"log-detail-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>ログ詳細情報</h3>\n        <button class=\"modal-close\" id=\"modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\" id=\"modal-body\">\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn secondary\" id=\"btn-retry-log\">再実行</button>\n        <button class=\"action-btn secondary\" id=\"btn-close-modal\">閉じる</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- アラート通知設定モーダル -->\n  <div class=\"modal hidden\" id=\"alert-settings-modal\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>アラート通知設定</h3>\n        <button class=\"modal-close\" id=\"alert-modal-close\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"form-grid\">\n          <div class=\"form-item\">\n            <label>エラー通知</label>\n            <input type=\"checkbox\" id=\"error-notification\" checked>\n          </div>\n          <div class=\"form-item\">\n            <label>警告通知</label>\n            <input type=\"checkbox\" id=\"warning-notification\">\n          </div>\n          <div class=\"form-item\">\n            <label>通知メールアドレス</label>\n            <input type=\"email\" class=\"input\" id=\"notification-email\" placeholder=\"admin@example.com\">\n          </div>\n          <div class=\"form-item\">\n            <label>通知頻度</label>\n            <select class=\"input\" id=\"notification-frequency\">\n              <option value=\"immediate\">即座</option>\n              <option value=\"hourly\">1時間毎</option>\n              <option value=\"daily\">1日毎</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"action-btn\" id=\"btn-save-alert-settings\">設定保存</button>\n        <button class=\"action-btn secondary\" id=\"btn-close-alert-modal\">キャンセル</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.data-collection-log-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n}\n\n.header-section {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-section h1 {\n  margin: 0;\n  color: var(--text);\n}\n\n.header-controls {\n  display: flex;\n  gap: 15px;\n  align-items: center;\n}\n\n.auto-refresh-toggle label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n}\n\n.summary-section, .status-indicator-section, .filter-section, .log-list-section {\n  margin-bottom: 20px;\n}\n\n.summary-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n  margin-top: 15px;\n}\n\n.summary-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 15px;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.summary-label {\n  font-size: 14px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n\n.summary-value {\n  font-size: 24px;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.summary-value.error {\n  color: #ff6b6b;\n}\n\n.status-indicators {\n  display: flex;\n  gap: 30px;\n  margin-top: 15px;\n  flex-wrap: wrap;\n}\n\n.status-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.status-indicator {\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: #6c757d;\n}\n\n.status-indicator.normal {\n  background: #28a745;\n}\n\n.status-indicator.warning {\n  background: #ffc107;\n}\n\n.status-indicator.error {\n  background: #dc3545;\n}\n\n.filter-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 15px;\n  margin-bottom: 20px;\n}\n\n.filter-item label {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.filter-actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.table-wrap {\n  max-height: 600px;\n  overflow-y: auto;\n}\n\n.pagination {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 15px;\n  padding: 15px 0;\n  border-top: 1px solid var(--border);\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 800px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  cursor: pointer;\n  color: var(--text-muted);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n  padding: 20px;\n  border-top: 1px solid var(--border);\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 15px;\n}\n\n.form-item label {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.status-success {\n  color: #28a745;\n  font-weight: bold;\n}\n\n.status-error {\n  color: #dc3545;\n  font-weight: bold;\n}\n\n.status-warning {\n  color: #ffc107;\n  font-weight: bold;\n}\n\n.status-running {\n  color: #007bff;\n  font-weight: bold;\n}\n\n.retry-btn {\n  padding: 4px 8px;\n  font-size: 12px;\n}\n\n.retry-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n</style>",
