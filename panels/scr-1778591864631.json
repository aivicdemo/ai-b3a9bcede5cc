{
  "screenId": "scr-1778591864631",
  "screenName": "データ収集ログ管理",
  "html": "<div class=\"data-collection-log-management\">\n  <!-- ヘッダー -->\n  <div class=\"header-section\">\n    <h2>データ収集ログ管理</h2>\n    <div class=\"header-actions\">\n      <button class=\"action-btn\" id=\"btn-alert-settings\">\n        <i class=\"icon-bell\"></i>アラート通知設定\n      </button>\n      <button class=\"action-btn secondary\" id=\"btn-export\">\n        <i class=\"icon-download\"></i>ログエクスポート\n      </button>\n    </div>\n  </div>\n\n  <!-- サマリー表示エリア -->\n  <div class=\"summary-section\">\n    <div class=\"summary-cards\">\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">総収集件数</div>\n        <div class=\"summary-value\" id=\"total-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">成功件数</div>\n        <div class=\"summary-value success\" id=\"success-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">エラー件数</div>\n        <div class=\"summary-value error\" id=\"error-count\">0</div>\n      </div>\n      <div class=\"summary-card\">\n        <div class=\"summary-label\">最終実行</div>\n        <div class=\"summary-value\" id=\"last-execution\">-</div>\n      </div>\n    </div>\n    <div class=\"status-indicator\">\n      <div class=\"indicator-item\">\n        <span class=\"indicator-dot\" id=\"status-dot\"></span>\n        <span id=\"status-text\">システム正常</span>\n      </div>\n      <div class=\"auto-refresh\">\n        <label>\n          <input type=\"checkbox\" id=\"auto-refresh-toggle\">\n          自動更新\n        </label>\n      </div>\n    </div>\n  </div>\n\n  <!-- 検索・フィルターエリア -->\n  <div class=\"filter-section card\">\n    <div class=\"filter-row\">\n      <div class=\"filter-group\">\n        <label>データソース</label>\n        <select class=\"input\" id=\"filter-data-source\">\n          <option value=\"\">すべて</option>\n          <option value=\"POSシステム\">POSシステム</option>\n          <option value=\"気象庁API\">気象庁API</option>\n          <option value=\"店舗システム\">店舗システム</option>\n          <option value=\"外部API\">外部API</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <label>ログレベル</label>\n        <select class=\"input\" id=\"filter-log-level\">\n          <option value=\"\">すべて</option>\n          <option value=\"INFO\">INFO</option>\n          <option value=\"WARN\">WARN</option>\n          <option value=\"ERROR\">ERROR</option>\n        </select>\n      </div>\n      <div class=\"filter-group\">\n        <label>処理ステータス</label>\n        <select class=\"input\" id=\"filter-status\">\n          <option value=\"\">すべて</option>\n          <option value=\"実行中\">実行中</option>\n          <option value=\"成功\">成功</option>\n          <option value=\"失敗\">失敗</option>\n          <option value=\"警告\">警告</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"filter-row\">\n      <div class=\"filter-group\">\n        <label>収集開始日時</label>\n        <input type=\"datetime-local\" class=\"input\" id=\"filter-start-date\">\n      </div>\n      <div class=\"filter-group\">\n        <label>収集終了日時</label>\n        <input type=\"datetime-local\" class=\"input\" id=\"filter-end-date\">\n      </div>\n      <div class=\"filter-group\">\n        <label>店舗</label>\n        <select class=\"input\" id=\"filter-store\">\n          <option value=\"\">すべて</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"filter-actions\">\n      <button class=\"action-btn\" id=\"btn-search\">検索・絞り込み</button>\n      <button class=\"action-btn secondary\" id=\"btn-clear-filter\">条件クリア</button>\n    </div>\n  </div>\n\n  <!-- ログ一覧表示エリア -->\n  <div class=\"log-list-section card\">\n    <div class=\"table-header\">\n      <h3>データ収集ログ一覧</h3>\n      <div class=\"table-actions\">\n        <span class=\"result-count\" id=\"result-count\">0件</span>\n      </div>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>収集日時</th>\n            <th>データソース</th>\n            <th>データ種別</th>\n            <th>店舗</th>\n            <th>ステータス</th>\n            <th>収集件数</th>\n            <th>エラー件数</th>\n            <th>処理時間</th>\n            <th>品質スコア</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"log-table-body\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<!-- ログ詳細モーダル -->\n<div class=\"modal hidden\" id=\"log-detail-modal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>ログ詳細情報</h3>\n      <button class=\"modal-close\" id=\"modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"detail-section\">\n        <div class=\"detail-row\">\n          <label>ログID:</label>\n          <span id=\"detail-log-id\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ種別:</label>\n          <span id=\"detail-data-type\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データソース:</label>\n          <span id=\"detail-data-source\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集開始日時:</label>\n          <span id=\"detail-start-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集終了日時:</label>\n          <span id=\"detail-end-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理ステータス:</label>\n          <span id=\"detail-status\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>収集件数:</label>\n          <span id=\"detail-success-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>エラー件数:</label>\n          <span id=\"detail-error-count\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>処理時間:</label>\n          <span id=\"detail-process-time\"></span>\n        </div>\n        <div class=\"detail-row\">\n          <label>データ品質スコア:</label>\n          <span id=\"detail-quality-score\"></span>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>エラーメッセージ:</label>\n          <div class=\"error-message-box\" id=\"detail-error-message\"></div>\n        </div>\n        <div class=\"detail-row full-width\">\n          <label>備考:</label>\n          <div class=\"remarks-box\" id=\"detail-remarks\"></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn secondary\" id=\"btn-retry-log\">再実行</button>\n      <button class=\"action-btn secondary\" id=\"modal-close-btn\">閉じる</button>\n    </div>\n  </div>\n</div>\n\n<!-- アラート通知設定モーダル -->\n<div class=\"modal hidden\" id=\"alert-settings-modal\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h3>アラート通知設定</h3>\n      <button class=\"modal-close\" id=\"alert-modal-close\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"setting-section\">\n        <div class=\"setting-row\">\n          <label>\n            <input type=\"checkbox\" id=\"alert-error-enabled\">\n            エラー発生時の通知\n          </label>\n        </div>\n        <div class=\"setting-row\">\n          <label>\n            <input type=\"checkbox\" id=\"alert-quality-enabled\">\n            データ品質低下時の通知\n          </label>\n        </div>\n        <div class=\"setting-row\">\n          <label>品質スコア閾値:</label>\n          <input type=\"number\" class=\"input\" id=\"quality-threshold\" min=\"0\" max=\"100\" value=\"80\">\n        </div>\n        <div class=\"setting-row\">\n          <label>通知先メールアドレス:</label>\n          <input type=\"email\" class=\"input\" id=\"notification-email\" placeholder=\"admin@example.com\">\n        </div>\n      </div>\n    </div>\n    <div class=\"modal-footer\">\n      <button class=\"action-btn\" id=\"btn-save-alert-settings\">保存</button>\n      <button class=\"action-btn secondary\" id=\"alert-modal-close-btn\">キャンセル</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.data-collection-log-management {\n  padding: 20px;\n  background: var(--bg-main);\n  color: var(--text);\n  min-height: 100vh;\n}\n\n.header-section {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.header-section h2 {\n  margin: 0;\n  color: var(--text);\n  font-size: 24px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.summary-section {\n  margin-bottom: 24px;\n}\n\n.summary-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.summary-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 16px;\n  text-align: center;\n}\n\n.summary-label {\n  font-size: 14px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n\n.summary-value {\n  font-size: 24px;\n  font-weight: bold;\n  color: var(--text);\n}\n\n.summary-value.success {\n  color: #22c55e;\n}\n\n.summary-value.error {\n  color: #ef4444;\n}\n\n.status-indicator {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px 16px;\n}\n\n.indicator-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.indicator-dot {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: #22c55e;\n}\n\n.indicator-dot.error {\n  background: #ef4444;\n}\n\n.indicator-dot.warning {\n  background: #f59e0b;\n}\n\n.auto-refresh label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.filter-section {\n  margin-bottom: 24px;\n  padding: 20px;\n}\n\n.filter-row {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.filter-group label {\n  font-size: 14px;\n  color: var(--text);\n  font-weight: 500;\n}\n\n.filter-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.log-list-section {\n  padding: 20px;\n}\n\n.table-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n}\n\n.table-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.result-count {\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.table-wrap {\n  overflow-x: auto;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\n\nth {\n  background: var(--bg-card);\n  color: var(--text);\n  font-weight: 600;\n  padding: 12px 8px;\n  text-align: left;\n  border-bottom: 2px solid var(--border);\n  white-space: nowrap;\n}\n\ntd {\n  padding: 12px 8px;\n  border-bottom: 1px solid var(--border);\n  color: var(--text);\n}\n\n.status-badge {\n  display: inline-block;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.status-success {\n  background: rgba(34, 197, 94, 0.1);\n  color: #22c55e;\n  border: 1px solid #22c55e;\n}\n\n.status-error {\n  background: rgba(239, 68, 68, 0.1);\n  color: #ef4444;\n  border: 1px solid #ef4444;\n}\n\n.status-warning {\n  background: rgba(245, 158, 11, 0.1);\n  color: #f59e0b;\n  border: 1px solid #f59e0b;\n}\n\n.status-running {\n  background: rgba(59, 130, 246, 0.1);\n  color: #3b82f6;\n  border: 1px solid #3b82f6;\n}\n\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal.hidden {\n  display: none;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: 8px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 80vh;\n  overflow-y: auto;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.modal-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  width: 30px;\n  height: 30px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-close:hover {\n  color: var(--text);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  padding: 20px;\n  border-top: 1px solid var(--border);\n}\n\n.detail-section {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.detail-row {\n  display: grid;\n  grid-template-columns: 150px 1fr;\n  gap: 12px;\n  align-items: start;\n}\n\n.detail-row.full-width {\n  grid-template-columns: 1fr;\n}\n\n.detail-row label {\n  font-weight: 500;\n  color: var(--text);\n}\n\n.error-message-box,\n.remarks-box {\n  background: var(--bg-main);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 12px;\n  min-height: 60px;\n  color: var(--text);\n  font-family: monospace;\n  font-size: 14px;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.setting-section {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.setting-row {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.setting-row label {\n  color: var(--text);\n  font-weight: 500;\n}\n\n.setting-row input[type=\"checkbox\"] {\n  margin-right: 8px;\n}\n\n.icon-bell::before { content: \"🔔\"; }\n.icon-download::before { content: \"⬇️\"; }\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
