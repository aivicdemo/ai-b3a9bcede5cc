  "screenName": "ダッシュボード",
  "html": "<div class=\"dashboard-header\">\n  <div class=\"header-nav\">\n    <div class=\"nav-left\">\n      <h1>AI需要予測・発注管理システム</h1>\n      <nav class=\"main-nav\">\n        <button class=\"nav-btn active\" onclick=\"window.showScreen('dashboard')\">ダッシュボード</button>\n        <button class=\"nav-btn\" onclick=\"window.showScreen('scr-1778591838939')\">需要予測</button>\n        <button class=\"nav-btn\" onclick=\"window.showScreen('scr-1778591852463')\">発注管理</button>\n        <button class=\"nav-btn\" onclick=\"window.showScreen('scr-1778591945891')\">在庫管理</button>\n        <button class=\"nav-btn\" onclick=\"window.showScreen('scr-1778591797884')\">売上実績</button>\n        <button class=\"nav-btn\" onclick=\"window.showScreen('scr-1778591822586')\">分析</button>\n      </nav>\n    </div>\n    <div class=\"nav-right\">\n      <div class=\"user-info\">\n        <span id=\"user-name\">管理者</span>\n        <button class=\"action-btn secondary\">ログアウト</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"dashboard-controls\">\n  <div class=\"control-group\">\n    <label for=\"store-select\">店舗選択:</label>\n    <select id=\"store-select\" class=\"input\">\n      <option value=\"\">全店舗</option>\n    </select>\n  </div>\n  <div class=\"control-group\">\n    <label for=\"period-select\">期間:</label>\n    <select id=\"period-select\" class=\"input\">\n      <option value=\"7\">過去7日間</option>\n      <option value=\"30\" selected>過去30日間</option>\n      <option value=\"90\">過去90日間</option>\n    </select>\n  </div>\n  <div class=\"control-group\">\n    <label for=\"date-from\">開始日:</label>\n    <input type=\"date\" id=\"date-from\" class=\"input\">\n  </div>\n  <div class=\"control-group\">\n    <label for=\"date-to\">終了日:</label>\n    <input type=\"date\" id=\"date-to\" class=\"input\">\n  </div>\n  <button id=\"btn-refresh\" class=\"action-btn\">更新</button>\n</div>\n\n<div id=\"loading-indicator\" class=\"loading hidden\">\n  <div class=\"spinner\"></div>\n  <span>データを読み込み中...</span>\n</div>\n\n<div id=\"error-message\" class=\"error-message hidden\">\n  <span id=\"error-text\">データの取得に失敗しました。しばらく時間をおいて再度お試しください。</span>\n  <button id=\"btn-retry\" class=\"action-btn secondary\">再試行</button>\n</div>\n\n<div class=\"kpi-cards\">\n  <div class=\"card kpi-card\">\n    <div class=\"kpi-header\">\n      <h3>今月売上実績</h3>\n      <span class=\"kpi-period\" id=\"sales-period\">2024年1月</span>\n    </div>\n    <div class=\"kpi-value\" id=\"sales-amount\">¥0</div>\n    <div class=\"kpi-change\">\n      <span id=\"sales-change\">前月比: --</span>\n    </div>\n  </div>\n\n  <div class=\"card kpi-card\">\n    <div class=\"kpi-header\">\n      <h3>需要予測精度</h3>\n      <span class=\"kpi-period\">MAPE</span>\n    </div>\n    <div class=\"kpi-value\" id=\"prediction-accuracy\">--%</div>\n    <div class=\"kpi-change\">\n      <span id=\"accuracy-trend\">前月比: --</span>\n    </div>\n  </div>\n\n  <div class=\"card kpi-card\">\n    <div class=\"kpi-header\">\n      <h3>発注件数</h3>\n      <span class=\"kpi-period\">今月</span>\n    </div>\n    <div class=\"kpi-value\" id=\"order-count\">0件</div>\n    <div class=\"kpi-change\">\n      <span id=\"order-change\">前月比: --</span>\n    </div>\n  </div>\n\n  <div class=\"card kpi-card alert-card\">\n    <div class=\"kpi-header\">\n      <h3>在庫アラート</h3>\n      <span class=\"kpi-period\">要注意商品</span>\n    </div>\n    <div class=\"kpi-value alert-value\" id=\"alert-count\">0件</div>\n    <div class=\"kpi-change\">\n      <button id=\"btn-view-alerts\" class=\"action-btn secondary\">詳細確認</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"dashboard-grid\">\n  <div class=\"card chart-card\">\n    <div class=\"card-header\">\n      <h3>売上トレンド</h3>\n      <div class=\"chart-controls\">\n        <select id=\"trend-period\" class=\"input\">\n          <option value=\"daily\">日次</option>\n          <option value=\"weekly\" selected>週次</option>\n          <option value=\"monthly\">月次</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"chart-wrap\" style=\"position:relative;height:260px;max-height:280px;\">\n      <canvas id=\"sales-trend-chart\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"card chart-card\">\n    <div class=\"card-header\">\n      <h3>発注状況</h3>\n    </div>\n    <div class=\"order-status-grid\">\n      <div class=\"status-item\">\n        <div class=\"status-label\">未発注</div>\n        <div class=\"status-count\" id=\"status-pending\">0</div>\n      </div>\n      <div class=\"status-item\">\n        <div class=\"status-label\">発注済</div>\n        <div class=\"status-count\" id=\"status-ordered\">0</div>\n      </div>\n      <div class=\"status-item\">\n        <div class=\"status-label\">配送中</div>\n        <div class=\"status-count\" id=\"status-shipping\">0</div>\n      </div>\n      <div class=\"status-item\">\n        <div class=\"status-label\">完了</div>\n        <div class=\"status-count\" id=\"status-completed\">0</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"card chart-card\">\n    <div class=\"card-header\">\n      <h3>商品別売上ランキング</h3>\n      <div class=\"chart-controls\">\n        <select id=\"ranking-period\" class=\"input\">\n          <option value=\"daily\">日次</option>\n          <option value=\"weekly\" selected>週次</option>\n          <option value=\"monthly\">月次</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"ranking-list\" id=\"product-ranking\">\n      <div class=\"ranking-item\">\n        <span class=\"rank\">1</span>\n        <span class=\"product-name\">データ読み込み中...</span>\n        <span class=\"sales-amount\">¥0</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"card chart-card\">\n    <div class=\"card-header\">\n      <h3>天候影響分析</h3>\n    </div>\n    <div class=\"chart-wrap\" style=\"position:relative;height:260px;max-height:280px;\">\n      <canvas id=\"weather-impact-chart\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h3>イベント・季節要因</h3>\n    </div>\n    <div class=\"events-list\" id=\"events-list\">\n      <div class=\"event-item\">\n        <div class=\"event-date\">データ読み込み中...</div>\n        <div class=\"event-name\">-</div>\n        <div class=\"event-impact\">影響度: -</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"card chart-card\">\n    <div class=\"card-header\">\n      <h3>需要予測vs実績</h3>\n    </div>\n    <div class=\"chart-wrap\" style=\"position:relative;height:260px;max-height:280px;\">\n      <canvas id=\"prediction-vs-actual-chart\"></canvas>\n    </div>\n  </div>\n</div>\n\n<style>\n.dashboard-header {\n  background: var(--top-bar-bg);\n  border-bottom: 1px solid var(--border);\n  padding: 1rem;\n  margin-bottom: 1.5rem;\n}\n\n.header-nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.nav-left h1 {\n  color: var(--text);\n  margin: 0 0 0.5rem 0;\n  font-size: 1.5rem;\n}\n\n.main-nav {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.nav-btn {\n  background: transparent;\n  border: 1px solid var(--border);\n  color: var(--text);\n  padding: 0.5rem 1rem;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.nav-btn:hover {\n  background: var(--primary-hover);\n  color: white;\n}\n\n.nav-btn.active {\n  background: var(--primary);\n  color: white;\n  border-color: var(--primary);\n}\n\n.user-info {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  color: var(--text);\n}\n\n.dashboard-controls {\n  display: flex;\n  gap: 1rem;\n  align-items: end;\n  margin-bottom: 1.5rem;\n  flex-wrap: wrap;\n}\n\n.control-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n.control-group label {\n  color: var(--text);\n  font-size: 0.875rem;\n}\n\n.loading {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 1rem;\n  background: var(--bg-card);\n  border-radius: 4px;\n  margin-bottom: 1rem;\n  color: var(--text);\n}\n\n.spinner {\n  width: 20px;\n  height: 20px;\n  border: 2px solid var(--border);\n  border-top: 2px solid var(--primary);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.error-message {\n  background: rgba(220, 53, 69, 0.1);\n  border: 1px solid #dc3545;\n  color: var(--text);\n  padding: 1rem;\n  border-radius: 4px;\n  margin-bottom: 1rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.kpi-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 1rem;\n  margin-bottom: 2rem;\n}\n\n.kpi-card {\n  padding: 1.5rem;\n}\n\n.kpi-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n}\n\n.kpi-header h3 {\n  margin: 0;\n  color: var(--text);\n  font-size: 1rem;\n}\n\n.kpi-period {\n  color: var(--text-muted);\n  font-size: 0.875rem;\n}\n\n.kpi-value {\n  font-size: 2rem;\n  font-weight: bold;\n  color: var(--primary);\n  margin-bottom: 0.5rem;\n}\n\n.kpi-change {\n  color: var(--text-muted);\n  font-size: 0.875rem;\n}\n\n.alert-card {\n  border-left: 4px solid #ff6a00;\n}\n\n.alert-value {\n  color: #ff6a00;\n}\n\n.dashboard-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 1.5rem;\n}\n\n.chart-card {\n  min-height: 350px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1rem;\n  padding-bottom: 0.5rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.card-header h3 {\n  margin: 0;\n  color: var(--text);\n}\n\n.chart-controls {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.order-status-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 1rem;\n}\n\n.status-item {\n  text-align: center;\n  padding: 1rem;\n  background: rgba(255, 255, 255, 0.05);\n  border-radius: 4px;\n}\n\n.status-label {\n  color: var(--text-muted);\n  font-size: 0.875rem;\n  margin-bottom: 0.5rem;\n}\n\n.status-count {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: var(--primary);\n}\n\n.ranking-list {\n  max-height: 260px;\n  overflow-y: auto;\n}\n\n.ranking-item {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding: 0.75rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.ranking-item:last-child {\n  border-bottom: none;\n}\n\n.rank {\n  background: var(--primary);\n  color: white;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.875rem;\n  font-weight: bold;\n  flex-shrink: 0;\n}\n\n.product-name {\n  flex: 1;\n  color: var(--text);\n}\n\n.sales-amount {\n  color: var(--primary);\n  font-weight: bold;\n}\n\n.events-list {\n  max-height: 280px;\n  overflow-y: auto;\n}\n\n.event-item {\n  padding: 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.event-item:last-child {\n  border-bottom: none;\n}\n\n.event-date {\n  color: var(--text-muted);\n  font-size: 0.875rem;\n  margin-bottom: 0.25rem;\n}\n\n.event-name {\n  color: var(--text);\n  font-weight: bold;\n  margin-bottom: 0.25rem;\n}\n\n.event-impact {\n  color: var(--text-muted);\n  font-size: 0.875rem;\n}\n\n@media (max-width: 768px) {\n  .dashboard-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .kpi-cards {\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  }\n  \n  .main-nav {\n    flex-wrap: wrap;\n  }\n  \n  .header-nav {\n    flex-direction: column;\n    gap: 1rem;\n    align-items: stretch;\n  }\n  \n  .dashboard-controls {\n    flex-direction: column;\n    align-items: stretch;\n  }\n}\n</style>",
