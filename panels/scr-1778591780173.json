  "screenName": "ダッシュボード",
  "html": "<div class=\"dashboard-container\">\n  <!-- ヘッダーナビゲーション -->\n  <div class=\"header-nav\" style=\"background: var(--top-bar-bg); padding: 1rem 2rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n      <div style=\"display: flex; gap: 2rem; align-items: center;\">\n        <h1 style=\"color: var(--text); margin: 0; font-size: 1.5rem;\">ダッシュボード</h1>\n        <nav style=\"display: flex; gap: 1.5rem;\">\n          <a href=\"#\" class=\"nav-link\" data-screen=\"scr-1778591838939\" style=\"color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; transition: background 0.2s;\">需要予測</a>\n          <a href=\"#\" class=\"nav-link\" data-screen=\"scr-1778591852463\" style=\"color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; transition: background 0.2s;\">発注管理</a>\n          <a href=\"#\" class=\"nav-link\" data-screen=\"scr-1778591945891\" style=\"color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; transition: background 0.2s;\">在庫管理</a>\n          <a href=\"#\" class=\"nav-link\" data-screen=\"scr-1778591797884\" style=\"color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px; transition: background 0.2s;\">売上実績</a>\n        </nav>\n      </div>\n      <div class=\"user-info\" style=\"color: var(--text-muted); font-size: 0.9rem;\">\n        <span id=\"user-name\">管理者</span>\n        <span style=\"margin-left: 1rem;\">最終ログイン: <span id=\"last-login\">2024-01-15 09:30</span></span>\n      </div>\n    </div>\n  </div>\n\n  <!-- 店舗選択・期間選択 -->\n  <div class=\"controls-section\" style=\"display: flex; gap: 2rem; margin-bottom: 2rem; align-items: center;\">\n    <div class=\"card\" style=\"padding: 1rem; flex: 1;\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 0.5rem;\">店舗選択</label>\n      <select id=\"store-select\" class=\"input\" style=\"width: 100%;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div class=\"card\" style=\"padding: 1rem; flex: 1;\">\n      <label style=\"color: var(--text); display: block; margin-bottom: 0.5rem;\">期間選択</label>\n      <div style=\"display: flex; gap: 0.5rem;\">\n        <input type=\"date\" id=\"date-from\" class=\"input\" style=\"flex: 1;\">\n        <span style=\"color: var(--text); align-self: center;\">〜</span>\n        <input type=\"date\" id=\"date-to\" class=\"input\" style=\"flex: 1;\">\n      </div>\n    </div>\n    <button id=\"btn-apply-filter\" class=\"action-btn\" style=\"height: fit-content; align-self: end;\">適用</button>\n  </div>\n\n  <!-- KPIカード -->\n  <div class=\"kpi-cards\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;\">\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem; text-align: center;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">今月売上金額</h3>\n      <div id=\"kpi-sales-amount\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">¥0</div>\n      <div id=\"kpi-sales-change\" style=\"color: var(--text-muted); font-size: 0.8rem;\">前月比: --</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem; text-align: center;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">今月販売数量</h3>\n      <div id=\"kpi-sales-quantity\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">0個</div>\n      <div id=\"kpi-quantity-change\" style=\"color: var(--text-muted); font-size: 0.8rem;\">前月比: --</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem; text-align: center;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">需要予測精度</h3>\n      <div id=\"kpi-prediction-accuracy\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">--%</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem;\">MAPE基準</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem; text-align: center;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">発注済み件数</h3>\n      <div id=\"kpi-order-count\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">0件</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem;\">今月実績</div>\n    </div>\n  </div>\n\n  <!-- 在庫アラート -->\n  <div id=\"inventory-alerts\" class=\"card\" style=\"margin-bottom: 2rem; padding: 1.5rem;\">\n    <h3 style=\"color: var(--text); margin: 0 0 1rem 0; display: flex; align-items: center; gap: 0.5rem;\">\n      <span style=\"color: #ff6a00;\">⚠</span> 在庫アラート通知\n    </h3>\n    <div id=\"alert-list\" style=\"display: flex; flex-direction: column; gap: 0.5rem;\">\n      <div style=\"color: var(--text-muted); text-align: center; padding: 2rem;\">アラートはありません</div>\n    </div>\n  </div>\n\n  <!-- グラフエリア -->\n  <div class=\"charts-section\" style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2rem;\">\n    <!-- 売上トレンドグラフ -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">売上トレンドグラフ</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"sales-trend-chart\"></canvas>\n      </div>\n    </div>\n\n    <!-- 商品別売上ランキング -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">商品別売上ランキング</h3>\n      <div id=\"product-ranking\" style=\"max-height: 260px; overflow-y: auto;\">\n        <div style=\"color: var(--text-muted); text-align: center; padding: 2rem;\">データを読み込み中...</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 発注状況・天候影響分析 -->\n  <div class=\"charts-section\" style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;\">\n    <!-- 発注状況ステータス -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">発注状況ステータス</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"order-status-chart\"></canvas>\n      </div>\n    </div>\n\n    <!-- 天候影響分析チャート -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">天候影響分析チャート</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"weather-impact-chart\"></canvas>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベント・季節要因表示 -->\n  <div class=\"card\" style=\"padding: 1.5rem;\">\n    <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">イベント・季節要因表示</h3>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;\">\n      <div>\n        <h4 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">今後のイベント</h4>\n        <div id=\"upcoming-events\" style=\"display: flex; flex-direction: column; gap: 0.5rem;\">\n          <div style=\"color: var(--text-muted); text-align: center; padding: 1rem;\">データを読み込み中...</div>\n        </div>\n      </div>\n      <div>\n        <h4 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">季節要因</h4>\n        <div id=\"seasonal-factors\" style=\"display: flex; flex-direction: column; gap: 0.5rem;\">\n          <div style=\"color: var(--text-muted); text-align: center; padding: 1rem;\">データを読み込み中...</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div id=\"error-message\" class=\"hidden\" style=\"background: rgba(255, 106, 0, 0.1); border: 1px solid #ff6a00; border-radius: 4px; padding: 1rem; margin: 1rem 0; color: var(--text);\">\n    <strong>エラー:</strong> <span id=\"error-text\"></span>\n    <button id=\"btn-retry\" class=\"action-btn secondary\" style=\"margin-left: 1rem;\">再試行</button>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}