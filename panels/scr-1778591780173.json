{
  "screenId": "scr-1778591780173",
  "screenName": "ダッシュボード",
  "html": "<div class=\"dashboard-container\">\n  <!-- ヘッダーナビゲーション -->\n  <div class=\"header-nav\" style=\"background: var(--top-bar-bg); padding: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border);\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n      <div style=\"display: flex; gap: 1rem;\">\n        <button class=\"action-btn nav-btn\" data-screen=\"dashboard\">ダッシュボード</button>\n        <button class=\"action-btn secondary nav-btn\" data-screen=\"scr-1778591838939\">需要予測</button>\n        <button class=\"action-btn secondary nav-btn\" data-screen=\"scr-1778591852463\">発注管理</button>\n        <button class=\"action-btn secondary nav-btn\" data-screen=\"scr-1778591945891\">在庫管理</button>\n        <button class=\"action-btn secondary nav-btn\" data-screen=\"scr-1778591797884\">売上実績</button>\n        <button class=\"action-btn secondary nav-btn\" data-screen=\"scr-1778591810814\">外部要因</button>\n      </div>\n      <div class=\"user-info\" style=\"color: var(--text);\">\n        <span id=\"user-name\">管理者</span>\n        <span style=\"margin-left: 1rem; color: var(--text-muted);\">最終ログイン: 2024/01/15 09:30</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- フィルター -->\n  <div class=\"filter-section\" style=\"display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: center;\">\n    <div>\n      <label style=\"color: var(--text); margin-right: 0.5rem;\">店舗:</label>\n      <select id=\"store-select\" class=\"input\" style=\"width: 200px;\">\n        <option value=\"\">全店舗</option>\n      </select>\n    </div>\n    <div>\n      <label style=\"color: var(--text); margin-right: 0.5rem;\">期間:</label>\n      <select id=\"period-select\" class=\"input\" style=\"width: 150px;\">\n        <option value=\"7\">過去7日</option>\n        <option value=\"30\" selected>過去30日</option>\n        <option value=\"90\">過去90日</option>\n      </select>\n    </div>\n    <div>\n      <input type=\"date\" id=\"date-start\" class=\"input\" style=\"width: 150px;\">\n      <span style=\"margin: 0 0.5rem; color: var(--text);\">〜</span>\n      <input type=\"date\" id=\"date-end\" class=\"input\" style=\"width: 150px;\">\n    </div>\n    <button id=\"btn-apply-filter\" class=\"action-btn\">適用</button>\n  </div>\n\n  <!-- KPIカード -->\n  <div class=\"kpi-cards\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin-bottom: 2rem;\">\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); font-size: 0.9rem; margin: 0 0 0.5rem 0;\">今月売上</h3>\n      <div style=\"font-size: 2rem; font-weight: bold; color: var(--text);\" id=\"kpi-sales\">¥0</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;\" id=\"kpi-sales-change\">前月比: --</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); font-size: 0.9rem; margin: 0 0 0.5rem 0;\">予測精度</h3>\n      <div style=\"font-size: 2rem; font-weight: bold; color: var(--text);\" id=\"kpi-accuracy\">--%</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;\">MAPE値</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); font-size: 0.9rem; margin: 0 0 0.5rem 0;\">発注件数</h3>\n      <div style=\"font-size: 2rem; font-weight: bold; color: var(--text);\" id=\"kpi-orders\">0件</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;\" id=\"kpi-orders-status\">処理中: 0件</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); font-size: 0.9rem; margin: 0 0 0.5rem 0;\">在庫アラート</h3>\n      <div style=\"font-size: 2rem; font-weight: bold; color: #ff6a00;\" id=\"kpi-alerts\">0件</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;\">要対応商品</div>\n    </div>\n  </div>\n\n  <!-- アラート通知 -->\n  <div id=\"alert-notifications\" class=\"card\" style=\"margin-bottom: 2rem; padding: 1rem; border-left: 4px solid #ff6a00; display: none;\">\n    <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">⚠️ 在庫アラート</h3>\n    <div id=\"alert-list\"></div>\n  </div>\n\n  <!-- グラフエリア -->\n  <div style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;\">\n    <!-- 売上トレンドグラフ -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">売上トレンド</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"sales-trend-chart\"></canvas>\n      </div>\n    </div>\n\n    <!-- 商品別売上ランキング -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">商品別売上TOP10</h3>\n      <div id=\"product-ranking\" style=\"max-height: 260px; overflow-y: auto;\">\n        <div style=\"color: var(--text-muted); text-align: center; padding: 2rem;\">データを読み込み中...</div>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;\">\n    <!-- 天候影響分析 -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">天候影響分析</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"weather-chart\"></canvas>\n      </div>\n    </div>\n\n    <!-- 発注状況 -->\n    <div class=\"card\" style=\"padding: 1.5rem;\">\n      <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">発注状況</h3>\n      <div class=\"chart-wrap\" style=\"position: relative; height: 260px; max-height: 280px;\">\n        <canvas id=\"order-status-chart\"></canvas>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベント・季節要因 -->\n  <div class=\"card\" style=\"padding: 1.5rem;\">\n    <h3 style=\"color: var(--text); margin: 0 0 1rem 0;\">イベント・季節要因</h3>\n    <div id=\"event-factors\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;\">\n      <div style=\"color: var(--text-muted); text-align: center; padding: 2rem;\">データを読み込み中...</div>\n    </div>\n  </div>\n\n  <!-- データ読み込み中表示 -->\n  <div id=\"loading-overlay\" style=\"position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: none; z-index: 1000;\">\n    <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--bg-card); padding: 2rem; border-radius: 8px; color: var(--text);\">\n      <div style=\"text-align: center;\">\n        <div style=\"border: 3px solid var(--border); border-top: 3px solid var(--primary); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 1rem;\"></div>\n        データを読み込み中...\n      </div>\n    </div>\n  </div>\n\n  <!-- エラー表示 -->\n  <div id=\"error-message\" class=\"card\" style=\"margin-top: 1rem; padding: 1rem; border-left: 4px solid #dc3545; display: none;\">\n    <div style=\"color: #dc3545; font-weight: bold;\">エラーが発生しました</div>\n    <div id=\"error-text\" style=\"color: var(--text); margin-top: 0.5rem;\"></div>\n  </div>\n</div>\n\n<style>\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.nav-btn {\n  border: none;\n  padding: 0.5rem 1rem;\n  cursor: pointer;\n  border-radius: 4px;\n  transition: background-color 0.2s;\n}\n\n.kpi-card:hover {\n  transform: translateY(-2px);\n  transition: transform 0.2s;\n}\n\n.product-rank-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.5rem 0;\n  border-bottom: 1px solid var(--border);\n}\n\n.product-rank-item:last-child {\n  border-bottom: none;\n}\n\n.rank-number {\n  background: var(--primary);\n  color: white;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.8rem;\n  font-weight: bold;\n}\n\n.event-item {\n  background: var(--bg-main);\n  padding: 1rem;\n  border-radius: 6px;\n  border-left: 3px solid var(--primary);\n}\n\n@media (max-width: 768px) {\n  .dashboard-container {\n    padding: 0.5rem;\n  }\n  \n  .header-nav {\n    padding: 0.5rem !important;\n  }\n  \n  .header-nav > div {\n    flex-direction: column;\n    gap: 1rem;\n  }\n  \n  .filter-section {\n    flex-direction: column;\n    align-items: stretch !important;\n  }\n  \n  .kpi-cards {\n    grid-template-columns: 1fr 1fr !important;\n  }\n  \n  div[style*=\"grid-template-columns: 2fr 1fr\"] {\n    grid-template-columns: 1fr !important;\n  }\n  \n  div[style*=\"grid-template-columns: 1fr 1fr\"] {\n    grid-template-columns: 1fr !important;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}