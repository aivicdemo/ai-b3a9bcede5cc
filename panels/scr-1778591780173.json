  "screenId": "scr-1778591780173",
  "screenName": "ダッシュボード",
  "html": "<div class=\"dashboard-container\">\n  <!-- ヘッダーナビゲーション -->\n  <header class=\"dashboard-header\" style=\"background: var(--top-bar-bg); border-bottom: 1px solid var(--border); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center;\">\n    <div class=\"nav-menu\" style=\"display: flex; gap: 2rem;\">\n      <button class=\"nav-btn active\" data-screen=\"dashboard\" style=\"background: var(--primary); color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;\">ダッシュボード</button>\n      <button class=\"nav-btn\" data-screen=\"scr-1778591838939\" style=\"background: transparent; color: var(--text); border: none; padding: 0.5rem 1rem; cursor: pointer;\">需要予測</button>\n      <button class=\"nav-btn\" data-screen=\"scr-1778591852463\" style=\"background: transparent; color: var(--text); border: none; padding: 0.5rem 1rem; cursor: pointer;\">発注管理</button>\n      <button class=\"nav-btn\" data-screen=\"scr-1778591945891\" style=\"background: transparent; color: var(--text); border: none; padding: 0.5rem 1rem; cursor: pointer;\">在庫管理</button>\n      <button class=\"nav-btn\" data-screen=\"scr-1778591797884\" style=\"background: transparent; color: var(--text); border: none; padding: 0.5rem 1rem; cursor: pointer;\">売上実績</button>\n    </div>\n    <div class=\"user-info\" style=\"display: flex; align-items: center; gap: 1rem; color: var(--text);\">\n      <span id=\"user-name\">管理者</span>\n      <span style=\"color: var(--text-muted);\">|</span>\n      <span id=\"last-login\">最終ログイン: 2024/01/15 09:30</span>\n    </div>\n  </header>\n\n  <!-- フィルターエリア -->\n  <div class=\"filter-area\" style=\"background: var(--bg-card); padding: 1.5rem; margin: 1rem; border-radius: 8px; border: 1px solid var(--border);\">\n    <div style=\"display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;\">\n      <div>\n        <label style=\"color: var(--text); margin-bottom: 0.5rem; display: block;\">店舗選択</label>\n        <select id=\"store-select\" class=\"input\" style=\"min-width: 200px;\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); margin-bottom: 0.5rem; display: block;\">期間</label>\n        <select id=\"period-select\" class=\"input\">\n          <option value=\"7\">過去7日間</option>\n          <option value=\"30\" selected>過去30日間</option>\n          <option value=\"90\">過去90日間</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); margin-bottom: 0.5rem; display: block;\">開始日</label>\n        <input type=\"date\" id=\"start-date\" class=\"input\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); margin-bottom: 0.5rem; display: block;\">終了日</label>\n        <input type=\"date\" id=\"end-date\" class=\"input\">\n      </div>\n      <button id=\"btn-filter\" class=\"action-btn\" style=\"margin-top: 1.5rem;\">フィルター適用</button>\n    </div>\n  </div>\n\n  <!-- KPIカード -->\n  <div class=\"kpi-cards\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin: 1rem; margin-bottom: 2rem;\">\n    <div class=\"card kpi-card\" style=\"text-align: center; padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">今月売上</h3>\n      <div id=\"kpi-sales\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">¥0</div>\n      <div id=\"kpi-sales-change\" style=\"color: var(--text-muted); font-size: 0.8rem;\"></div>\n    </div>\n    <div class=\"card kpi-card\" style=\"text-align: center; padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">予測精度</h3>\n      <div id=\"kpi-accuracy\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">0%</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem;\">MAPE基準</div>\n    </div>\n    <div class=\"card kpi-card\" style=\"text-align: center; padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">発注件数</h3>\n      <div id=\"kpi-orders\" style=\"color: var(--text); font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">0</div>\n      <div id=\"kpi-orders-status\" style=\"color: var(--text-muted); font-size: 0.8rem;\"></div>\n    </div>\n    <div class=\"card kpi-card\" style=\"text-align: center; padding: 1.5rem;\">\n      <h3 style=\"color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 0.9rem;\">在庫アラート</h3>\n      <div id=\"kpi-alerts\" style=\"color: #ff6a00; font-size: 2rem; font-weight: bold; margin-bottom: 0.5rem;\">0</div>\n      <div style=\"color: var(--text-muted); font-size: 0.8rem;\">要対応</div>\n    </div>\n  </div>\n\n  <!-- メインコンテンツエリア -->\n  <div class=\"main-content\" style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin: 1rem;\">\n    \n    <!-- 左カラム -->\n    <div class=\"left-column\">\n      <!-- 売上トレンドグラフ -->\n      <div class=\"card\" style=\"margin-bottom: 1rem;\">\n        <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;\">\n          <h3 style=\"color: var(--text); margin: 0;\">売上トレンド</h3>\n          <div style=\"display: flex; gap: 0.5rem;\">\n            <button class=\"trend-period-btn active\" data-period=\"daily\" style=\"background: var(--primary); color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer;\">日次</button>\n            <button class=\"trend-period-btn\" data-period=\"weekly\" style=\"background: var(--bg-main); color: var(--text); border: 1px solid var(--border); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer;\">週次</button>\n            <button class=\"trend-period-btn\" data-period=\"monthly\" style=\"background: var(--bg-main); color: var(--text); border: 1px solid var(--border); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer;\">月次</button>\n          </div>\n        </div>\n        <div style=\"padding: 1rem;\">\n          <div class=\"chart-wrap\" style=\"position:relative;height:260px;max-height:280px;\">\n            <canvas id=\"sales-trend-chart\"></canvas>\n          </div>\n        </div>\n      </div>\n\n      <!-- 天候影響分析チャート -->\n      <div class=\"card\">\n        <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border);\">\n          <h3 style=\"color: var(--text); margin: 0;\">天候影響分析</h3>\n        </div>\n        <div style=\"padding: 1rem;\">\n          <div class=\"chart-wrap\" style=\"position:relative;height:260px;max-height:280px;\">\n            <canvas id=\"weather-impact-chart\"></canvas>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 右カラム -->\n    <div class=\"right-column\">\n      <!-- 在庫アラート通知 -->\n      <div class=\"card alert-card\" style=\"margin-bottom: 1rem; border-left: 4px solid #ff6a00;\">\n        <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border);\">\n          <h3 style=\"color: var(--text); margin: 0;\">在庫アラート</h3>\n        </div>\n        <div id=\"alert-list\" style=\"max-height: 200px; overflow-y: auto;\">\n          <div class=\"loading-state\" style=\"padding: 2rem; text-align: center; color: var(--text-muted);\">\n            読み込み中...\n          </div>\n        </div>\n      </div>\n\n      <!-- 商品別売上ランキング -->\n      <div class=\"card\" style=\"margin-bottom: 1rem;\">\n        <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border);\">\n          <h3 style=\"color: var(--text); margin: 0;\">売上ランキング TOP10</h3>\n        </div>\n        <div id=\"ranking-list\" style=\"max-height: 300px; overflow-y: auto;\">\n          <div class=\"loading-state\" style=\"padding: 2rem; text-align: center; color: var(--text-muted);\">\n            読み込み中...\n          </div>\n        </div>\n      </div>\n\n      <!-- 発注状況ステータス -->\n      <div class=\"card\">\n        <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border);\">\n          <h3 style=\"color: var(--text); margin: 0;\">発注状況</h3>\n        </div>\n        <div style=\"padding: 1rem;\">\n          <div class=\"chart-wrap\" style=\"position:relative;height:200px;max-height:220px;\">\n            <canvas id=\"order-status-chart\"></canvas>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- イベント・季節要因表示 -->\n  <div class=\"card\" style=\"margin: 1rem;\">\n    <div class=\"card-header\" style=\"padding: 1rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;\">\n      <h3 style=\"color: var(--text); margin: 0;\">イベント・季節要因</h3>\n      <button id=\"btn-event-detail\" class=\"action-btn secondary\">詳細を見る</button>\n    </div>\n    <div style=\"padding: 1rem;\">\n      <div id=\"event-factors\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;\">\n        <div class=\"loading-state\" style=\"padding: 2rem; text-align: center; color: var(--text-muted);\">\n          読み込み中...\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- エラー表示エリア -->\n  <div id=\"error-display\" class=\"hidden\" style=\"margin: 1rem; padding: 1rem; background: rgba(255, 106, 0, 0.1); border: 1px solid #ff6a00; border-radius: 4px; color: var(--text);\">\n    <strong>エラー:</strong> <span id=\"error-message\"></span>\n  </div>\n\n  <!-- ローディング表示 -->\n  <div id=\"loading-overlay\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;\">\n    <div style=\"background: var(--bg-card); padding: 2rem; border-radius: 8px; text-align: center; color: var(--text);\">\n      <div style=\"width: 40px; height: 40px; border: 4px solid var(--border); border-top: 4px solid var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1rem;\"></div>\n      <div>データを読み込んでいます...</div>\n    </div>\n  </div>\n</div>\n\n<style>\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.nav-btn:hover {\n  background: var(--primary-hover) !important;\n  color: white !important;\n}\n\n.trend-period-btn:hover {\n  opacity: 0.8;\n}\n\n.alert-item {\n  padding: 0.75rem;\n  border-bottom: 1px solid var(--border);\n  cursor: pointer;\n}\n\n.alert-item:hover {\n  background: var(--bg-main);\n}\n\n.alert-item:last-child {\n  border-bottom: none;\n}\n\n.ranking-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.75rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.ranking-item:last-child {\n  border-bottom: none;\n}\n\n.event-factor-item {\n  padding: 1rem;\n  background: var(--bg-main);\n  border-radius: 4px;\n  border: 1px solid var(--border);\n}\n\n@media (max-width: 768px) {\n  .dashboard-header {\n    flex-direction: column;\n    gap: 1rem;\n  }\n  \n  .nav-menu {\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n  \n  .filter-area > div {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  \n  .main-content {\n    grid-template-columns: 1fr;\n  }\n  \n  .kpi-cards {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 480px) {\n  .kpi-cards {\n    grid-template-columns: 1fr;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}