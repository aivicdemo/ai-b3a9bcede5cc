{
  "screenId": "scr-1778591984641",
  "screenName": "モデル設定画面",
  "html": "<div class=\"model-config-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h2>モデル設定画面</h2>\n    <p class=\"muted\">AI需要予測モデルのパラメータ設定、学習データの選択、予測精度の調整を行い、店舗や商品に最適化された予測モデルを構築・管理します</p>\n  </div>\n\n  <!-- 既存モデル一覧 -->\n  <div class=\"card\">\n    <h3>既存モデル一覧</h3>\n    <div class=\"table-controls\">\n      <div class=\"search-box\">\n        <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"モデル名で検索...\">\n        <button id=\"btn-search\" class=\"action-btn\">検索</button>\n      </div>\n      <button id=\"btn-export\" class=\"action-btn secondary\">CSVエクスポート</button>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>モデル名</th>\n            <th>対象店舗</th>\n            <th>商品カテゴリ</th>\n            <th>アルゴリズム</th>\n            <th>精度目標</th>\n            <th>ステータス</th>\n            <th>作成日時</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"model-list-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- モデル設定フォーム -->\n  <div class=\"card\">\n    <h3 id=\"form-title\">新規モデル作成</h3>\n    <form id=\"model-form\">\n      <div class=\"form-grid\">\n        <!-- 基本設定 -->\n        <div class=\"form-section\">\n          <h4>基本設定</h4>\n          <div class=\"form-row\">\n            <label for=\"model-name\">モデル名 <span class=\"required\">*</span></label>\n            <input type=\"text\" id=\"model-name\" class=\"input\" maxlength=\"255\" required>\n            <div class=\"error-message\" id=\"model-name-error\"></div>\n          </div>\n          \n          <div class=\"form-row\">\n            <label for=\"target-store\">対象店舗 <span class=\"required\">*</span></label>\n            <select id=\"target-store\" class=\"input\" required>\n              <option value=\"\">選択してください</option>\n            </select>\n            <div class=\"error-message\" id=\"target-store-error\"></div>\n          </div>\n        </div>\n\n        <!-- 商品カテゴリ選択 -->\n        <div class=\"form-section\">\n          <h4>対象商品カテゴリ <span class=\"required\">*</span></h4>\n          <div class=\"checkbox-group\">\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" id=\"select-all-categories\"> 全て選択\n            </label>\n            <div id=\"category-checkboxes\"></div>\n          </div>\n          <div class=\"error-message\" id=\"category-error\"></div>\n        </div>\n\n        <!-- 学習期間設定 -->\n        <div class=\"form-section\">\n          <h4>学習期間設定 <span class=\"required\">*</span></h4>\n          <div class=\"form-row\">\n            <label for=\"learning-start-date\">開始日</label>\n            <input type=\"date\" id=\"learning-start-date\" class=\"input\" required>\n          </div>\n          <div class=\"form-row\">\n            <label for=\"learning-end-date\">終了日</label>\n            <input type=\"date\" id=\"learning-end-date\" class=\"input\" required>\n          </div>\n          <div class=\"error-message\" id=\"learning-period-error\"></div>\n        </div>\n\n        <!-- 予測期間設定 -->\n        <div class=\"form-section\">\n          <h4>予測期間設定 <span class=\"required\">*</span></h4>\n          <div class=\"radio-group\">\n            <label class=\"radio-item\">\n              <input type=\"radio\" name=\"prediction-period\" value=\"7\"> 7日\n            </label>\n            <label class=\"radio-item\">\n              <input type=\"radio\" name=\"prediction-period\" value=\"14\"> 14日\n            </label>\n            <label class=\"radio-item\">\n              <input type=\"radio\" name=\"prediction-period\" value=\"30\" checked> 30日\n            </label>\n            <label class=\"radio-item\">\n              <input type=\"radio\" name=\"prediction-period\" value=\"60\"> 60日\n            </label>\n          </div>\n        </div>\n\n        <!-- データソース選択 -->\n        <div class=\"form-section\">\n          <h4>使用データソース <span class=\"required\">*</span></h4>\n          <div class=\"checkbox-group\">\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" id=\"select-all-datasources\"> 全て選択\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" name=\"datasource\" value=\"sales\"> 売上データ\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" name=\"datasource\" value=\"weather\"> 天候データ\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" name=\"datasource\" value=\"event\"> イベントデータ\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" name=\"datasource\" value=\"season\"> 季節データ\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" name=\"datasource\" value=\"inventory\"> 在庫データ\n            </label>\n          </div>\n          <div class=\"error-message\" id=\"datasource-error\"></div>\n        </div>\n\n        <!-- アルゴリズム設定 -->\n        <div class=\"form-section\">\n          <h4>アルゴリズム設定</h4>\n          <div class=\"form-row\">\n            <label for=\"algorithm\">アルゴリズム</label>\n            <select id=\"algorithm\" class=\"input\">\n              <option value=\"ARIMA\">ARIMA</option>\n              <option value=\"LSTM\">LSTM</option>\n              <option value=\"RandomForest\">Random Forest</option>\n              <option value=\"XGBoost\">XGBoost</option>\n              <option value=\"AutoML\">機械学習（自動選択）</option>\n            </select>\n          </div>\n          \n          <div class=\"form-row\">\n            <label for=\"learning-rate\">学習率: <span id=\"learning-rate-value\">0.01</span></label>\n            <input type=\"range\" id=\"learning-rate\" min=\"0.0001\" max=\"1\" step=\"0.0001\" value=\"0.01\" class=\"slider\">\n          </div>\n        </div>\n\n        <!-- 重み付け設定 -->\n        <div class=\"form-section\">\n          <h4>重み付け設定</h4>\n          <div class=\"table-wrap\">\n            <table class=\"weight-table\">\n              <thead>\n                <tr>\n                  <th>要因</th>\n                  <th>重み</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <td>売上履歴</td>\n                  <td><input type=\"number\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"40\" data-factor=\"sales\"></td>\n                </tr>\n                <tr>\n                  <td>天候</td>\n                  <td><input type=\"number\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" data-factor=\"weather\"></td>\n                </tr>\n                <tr>\n                  <td>イベント</td>\n                  <td><input type=\"number\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" data-factor=\"event\"></td>\n                </tr>\n                <tr>\n                  <td>季節性</td>\n                  <td><input type=\"number\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" data-factor=\"season\"></td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        <!-- 季節性調整 -->\n        <div class=\"form-section\">\n          <h4>季節性調整パラメータ</h4>\n          <div class=\"form-row\">\n            <label for=\"seasonal-factor\">季節係数</label>\n            <input type=\"number\" id=\"seasonal-factor\" class=\"input\" min=\"0.1\" max=\"5.0\" step=\"0.1\" value=\"1.0\">\n          </div>\n          <div class=\"form-row\">\n            <label for=\"trend-factor\">トレンド係数</label>\n            <input type=\"number\" id=\"trend-factor\" class=\"input\" min=\"0.1\" max=\"5.0\" step=\"0.1\" value=\"1.0\">\n          </div>\n        </div>\n\n        <!-- 異常値除外設定 -->\n        <div class=\"form-section\">\n          <h4>異常値除外設定</h4>\n          <div class=\"checkbox-group\">\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" id=\"exclude-outliers\" checked> 異常値を自動除外する\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" id=\"exclude-holidays\"> 祝日データを除外する\n            </label>\n            <label class=\"checkbox-item\">\n              <input type=\"checkbox\" id=\"exclude-special-events\"> 特売日データを除外する\n            </label>\n          </div>\n        </div>\n\n        <!-- モデル精度目標 -->\n        <div class=\"form-section\">\n          <h4>モデル精度目標値</h4>\n          <div class=\"form-row\">\n            <label for=\"accuracy-target\">精度目標 (%)</label>\n            <input type=\"number\" id=\"accuracy-target\" class=\"input\" min=\"0\" max=\"100\" value=\"85\">\n            <div class=\"error-message\" id=\"accuracy-error\"></div>\n          </div>\n        </div>\n\n        <!-- 通知設定 -->\n        <div class=\"form-section\">\n          <h4>通知設定</h4>\n          <div class=\"form-row\">\n            <label for=\"notification-email\">管理者メールアドレス</label>\n            <input type=\"email\" id=\"notification-email\" class=\"input\">\n          </div>\n        </div>\n      </div>\n\n      <!-- フォームボタン -->\n      <div class=\"form-actions\">\n        <button type=\"button\" id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button type=\"button\" id=\"btn-save\" class=\"action-btn\">モデル作成</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<style>\n.model-config-screen {\n  padding: 20px;\n}\n\n.screen-header {\n  margin-bottom: 30px;\n}\n\n.screen-header h2 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n  gap: 30px;\n  margin-bottom: 30px;\n}\n\n.form-section {\n  background: var(--bg-card);\n  padding: 20px;\n  border-radius: 8px;\n  border: 1px solid var(--border);\n}\n\n.form-section h4 {\n  color: var(--text);\n  margin-bottom: 15px;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.form-row {\n  margin-bottom: 15px;\n}\n\n.form-row label {\n  display: block;\n  color: var(--text);\n  margin-bottom: 5px;\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6b6b;\n}\n\n.checkbox-group, .radio-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.checkbox-item, .radio-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--text);\n  cursor: pointer;\n}\n\n.checkbox-item input, .radio-item input {\n  margin: 0;\n}\n\n.slider {\n  width: 100%;\n  height: 6px;\n  border-radius: 3px;\n  background: var(--border);\n  outline: none;\n  -webkit-appearance: none;\n}\n\n.slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: var(--primary);\n  cursor: pointer;\n}\n\n.weight-table {\n  width: 100%;\n}\n\n.weight-table td {\n  padding: 8px;\n}\n\n.weight-input {\n  width: 80px;\n}\n\n.form-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 15px;\n  padding-top: 20px;\n  border-top: 1px solid var(--border);\n}\n\n.table-controls {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 15px;\n}\n\n.search-box {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.search-box input {\n  width: 250px;\n}\n\n.error-message {\n  color: #ff6b6b;\n  font-size: 14px;\n  margin-top: 5px;\n  display: none;\n}\n\n.error-message.show {\n  display: block;\n}\n\n.status-badge {\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.status-active {\n  background: rgba(34, 197, 94, 0.1);\n  color: #22c55e;\n}\n\n.status-inactive {\n  background: rgba(239, 68, 68, 0.1);\n  color: #ef4444;\n}\n\n.status-training {\n  background: rgba(249, 115, 22, 0.1);\n  color: #f97316;\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}