{
  "screenId": "scr-1778591984641",
  "screenName": "モデル設定画面",
  "html": "<div style=\"background: var(--bg-main); color: var(--text); padding: 20px; min-height: 100vh;\">\n  <!-- ヘッダー -->\n  <div style=\"background: var(--bg-card); padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--border);\">\n    <h1 style=\"margin: 0; color: var(--text); font-size: 24px;\">モデル設定画面</h1>\n    <p style=\"margin: 8px 0 0 0; color: var(--text-muted);\">AI需要予測モデルのパラメータ設定、学習データの選択、予測精度の調整を行い、店舗や商品に最適化された予測モデルを構築・管理します</p>\n  </div>\n\n  <!-- モデル設定フォーム -->\n  <div class=\"card\" style=\"margin-bottom: 20px;\">\n    <h2 style=\"margin: 0 0 20px 0; color: var(--text); font-size: 18px;\">モデル設定</h2>\n    \n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n      <!-- モデル名 -->\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">モデル名 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"text\" id=\"input-model-name\" class=\"input\" placeholder=\"モデル名を入力してください\" maxlength=\"255\" style=\"width: 100%;\">\n      </div>\n\n      <!-- 対象店舗選択 -->\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">対象店舗 <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"select-store\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">店舗を選択してください</option>\n        </select>\n      </div>\n    </div>\n\n    <!-- 対象商品カテゴリ選択 -->\n    <div style=\"margin-bottom: 20px;\">\n      <label style=\"display: block; margin-bottom: 10px; color: var(--text); font-weight: bold;\">対象商品カテゴリ <span style=\"color: #ff6a00;\">*</span></label>\n      <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; border: 1px solid var(--border);\">\n        <div style=\"margin-bottom: 10px;\">\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" id=\"check-all-categories\" style=\"margin-right: 8px;\">\n            全て選択\n          </label>\n        </div>\n        <div id=\"category-checkboxes\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;\">\n          <!-- カテゴリチェックボックスが動的に生成される -->\n        </div>\n      </div>\n    </div>\n\n    <!-- 学習期間設定 -->\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">学習期間開始日 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"date\" id=\"input-learning-start\" class=\"input\" style=\"width: 100%;\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">学習期間終了日 <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"date\" id=\"input-learning-end\" class=\"input\" style=\"width: 100%;\">\n      </div>\n    </div>\n\n    <!-- 予測期間設定 -->\n    <div style=\"margin-bottom: 20px;\">\n      <label style=\"display: block; margin-bottom: 10px; color: var(--text); font-weight: bold;\">予測期間 <span style=\"color: #ff6a00;\">*</span></label>\n      <div style=\"display: flex; gap: 20px;\">\n        <label style=\"color: var(--text);\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"7\" style=\"margin-right: 8px;\">\n          7日\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"14\" style=\"margin-right: 8px;\">\n          14日\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"30\" style=\"margin-right: 8px;\">\n          30日\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"60\" style=\"margin-right: 8px;\">\n          60日\n        </label>\n        <label style=\"color: var(--text);\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"90\" style=\"margin-right: 8px;\">\n          90日\n        </label>\n      </div>\n    </div>\n\n    <!-- 使用データソース選択 -->\n    <div style=\"margin-bottom: 20px;\">\n      <label style=\"display: block; margin-bottom: 10px; color: var(--text); font-weight: bold;\">使用データソース <span style=\"color: #ff6a00;\">*</span></label>\n      <div style=\"background: var(--bg-main); padding: 15px; border-radius: 6px; border: 1px solid var(--border);\">\n        <div style=\"margin-bottom: 10px;\">\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" id=\"check-all-datasources\" style=\"margin-right: 8px;\">\n            全て選択\n          </label>\n        </div>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px;\">\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" name=\"datasource\" value=\"sales\" style=\"margin-right: 8px;\">\n            売上データ\n          </label>\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" name=\"datasource\" value=\"weather\" style=\"margin-right: 8px;\">\n            天候データ\n          </label>\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" name=\"datasource\" value=\"event\" style=\"margin-right: 8px;\">\n            イベントデータ\n          </label>\n          <label style=\"color: var(--text);\">\n            <input type=\"checkbox\" name=\"datasource\" value=\"season\" style=\"margin-right: 8px;\">\n            季節データ\n          </label>\n        </div>\n      </div>\n    </div>\n\n    <!-- アルゴリズム選択 -->\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">アルゴリズム <span style=\"color: #ff6a00;\">*</span></label>\n        <select id=\"select-algorithm\" class=\"input\" style=\"width: 100%;\">\n          <option value=\"\">アルゴリズムを選択してください</option>\n          <option value=\"ARIMA\">ARIMA</option>\n          <option value=\"LSTM\">LSTM</option>\n          <option value=\"RandomForest\">Random Forest</option>\n          <option value=\"XGBoost\">XGBoost</option>\n          <option value=\"AutoML\">機械学習（自動選択）</option>\n        </select>\n      </div>\n\n      <!-- 学習率設定 -->\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">学習率</label>\n        <div style=\"display: flex; align-items: center; gap: 10px;\">\n          <input type=\"range\" id=\"slider-learning-rate\" min=\"0.0001\" max=\"1\" step=\"0.0001\" value=\"0.01\" style=\"flex: 1;\">\n          <span id=\"learning-rate-value\" style=\"color: var(--text); min-width: 60px;\">0.01</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 重み付け設定テーブル -->\n    <div style=\"margin-bottom: 20px;\">\n      <label style=\"display: block; margin-bottom: 10px; color: var(--text); font-weight: bold;\">重み付け設定</label>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>重み（%）</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>売上実績</td>\n              <td><input type=\"number\" id=\"weight-sales\" class=\"input\" value=\"40\" min=\"0\" max=\"100\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td>天候</td>\n              <td><input type=\"number\" id=\"weight-weather\" class=\"input\" value=\"20\" min=\"0\" max=\"100\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td>イベント</td>\n              <td><input type=\"number\" id=\"weight-event\" class=\"input\" value=\"20\" min=\"0\" max=\"100\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td>季節性</td>\n              <td><input type=\"number\" id=\"weight-season\" class=\"input\" value=\"20\" min=\"0\" max=\"100\" style=\"width: 80px;\"></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- 季節性調整パラメータ -->\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;\">\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">季節性調整係数</label>\n        <input type=\"number\" id=\"input-seasonal-factor\" class=\"input\" value=\"1.0\" min=\"0.1\" max=\"5.0\" step=\"0.1\" style=\"width: 100%;\">\n      </div>\n      <div>\n        <label style=\"display: block; margin-bottom: 5px; color: var(--text); font-weight: bold;\">モデル精度目標値（%） <span style=\"color: #ff6a00;\">*</span></label>\n        <input type=\"number\" id=\"input-accuracy-target\" class=\"input\" placeholder=\"85\" min=\"0\" max=\"100\" style=\"width: 100%;\">\n      </div>\n    </div>\n\n    <!-- 異常値除外設定 -->\n    <div style=\"margin-bottom: 20px;\">\n      <label style=\"color: var(--text);\">\n        <input type=\"checkbox\" id=\"check-outlier-removal\" style=\"margin-right: 8px;\">\n        異常値除外を有効にする\n      </label>\n    </div>\n\n    <!-- エラーメッセージ表示エリア -->\n    <div id=\"error-messages\" style=\"margin-bottom: 20px; display: none;\">\n      <div style=\"background: rgba(255, 106, 0, 0.1); border-left: 3px solid #ff6a00; padding: 10px; border-radius: 4px;\">\n        <ul id=\"error-list\" style=\"margin: 0; padding-left: 20px; color: var(--text);\"></ul>\n      </div>\n    </div>\n\n    <!-- 操作ボタン -->\n    <div style=\"display: flex; gap: 10px; justify-content: flex-end;\">\n      <button id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-save\" class=\"action-btn\">モデル作成</button>\n    </div>\n  </div>\n\n  <!-- 既存モデル一覧 -->\n  <div class=\"card\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n      <h2 style=\"margin: 0; color: var(--text); font-size: 18px;\">既存モデル一覧</h2>\n      <div style=\"display: flex; gap: 10px;\">\n        <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"モデル名で検索...\" style=\"width: 200px;\">\n        <button id=\"btn-search\" class=\"action-btn secondary\">検索</button>\n      </div>\n    </div>\n\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>モデル名</th>\n            <th>対象店舗</th>\n            <th>アルゴリズム</th>\n            <th>予測期間</th>\n            <th>精度目標</th>\n            <th>ステータス</th>\n            <th>作成日時</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"model-list-tbody\">\n          <!-- モデル一覧が動的に生成される -->\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- 成功メッセージ表示エリア -->\n  <div id=\"success-message\" style=\"position: fixed; top: 20px; right: 20px; background: rgba(0, 150, 0, 0.9); color: white; padding: 15px; border-radius: 6px; display: none; z-index: 1000;\">\n    <span id=\"success-text\"></span>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}