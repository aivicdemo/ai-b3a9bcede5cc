{
  "screenId": "scr-1778591984641",
  "screenName": "モデル設定画面",
  "html": "<div class=\"card\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;\">\n    <h2 style=\"color: var(--text); margin: 0;\">モデル設定</h2>\n    <div>\n      <button id=\"btn-new-model\" class=\"action-btn\">新規モデル作成</button>\n      <button id=\"btn-export-csv\" class=\"action-btn secondary\">CSVエクスポート</button>\n    </div>\n  </div>\n\n  <!-- 検索フィルター -->\n  <div style=\"background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin-bottom: 24px;\">\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: end;\">\n      <div>\n        <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">モデル名</label>\n        <input type=\"text\" id=\"input-search-name\" class=\"input\" placeholder=\"モデル名で検索\">\n      </div>\n      <div>\n        <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">店舗</label>\n        <select id=\"select-search-store\" class=\"input\">\n          <option value=\"\">全店舗</option>\n        </select>\n      </div>\n      <div>\n        <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">ステータス</label>\n        <select id=\"select-search-status\" class=\"input\">\n          <option value=\"\">全て</option>\n          <option value=\"作成中\">作成中</option>\n          <option value=\"学習中\">学習中</option>\n          <option value=\"完了\">完了</option>\n          <option value=\"エラー\">エラー</option>\n        </select>\n      </div>\n      <button id=\"btn-search\" class=\"action-btn\">検索</button>\n    </div>\n  </div>\n\n  <!-- モデル一覧テーブル -->\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th>モデル名</th>\n          <th>対象店舗</th>\n          <th>対象商品カテゴリ</th>\n          <th>予測期間</th>\n          <th>アルゴリズム</th>\n          <th>精度目標</th>\n          <th>ステータス</th>\n          <th>作成日時</th>\n          <th>操作</th>\n        </tr>\n      </thead>\n      <tbody id=\"model-list-tbody\">\n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- モデル設定モーダル -->\n<div id=\"model-config-modal\" class=\"hidden\" style=\"position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;\">\n  <div class=\"card\" style=\"width: 90%; max-width: 1200px; max-height: 90vh; overflow-y: auto;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;\">\n      <h3 id=\"modal-title\" style=\"color: var(--text); margin: 0;\">新規モデル作成</h3>\n      <button id=\"btn-close-modal\" class=\"action-btn secondary\">×</button>\n    </div>\n\n    <form id=\"model-form\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 24px;\">\n        <!-- 左列 -->\n        <div>\n          <!-- 基本設定 -->\n          <div style=\"margin-bottom: 24px;\">\n            <h4 style=\"color: var(--text); margin-bottom: 16px;\">基本設定</h4>\n            \n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">モデル名 <span style=\"color: #ff6a00;\">*</span></label>\n              <input type=\"text\" id=\"input-model-name\" class=\"input\" placeholder=\"モデル名を入力\" maxlength=\"255\" required>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">対象店舗 <span style=\"color: #ff6a00;\">*</span></label>\n              <select id=\"select-target-store\" class=\"input\" required>\n                <option value=\"\">店舗を選択してください</option>\n              </select>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 8px; display: block;\">対象商品カテゴリ <span style=\"color: #ff6a00;\">*</span></label>\n              <div id=\"category-checkboxes\" style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; max-height: 120px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px; padding: 12px;\">\n              </div>\n            </div>\n          </div>\n\n          <!-- 学習設定 -->\n          <div style=\"margin-bottom: 24px;\">\n            <h4 style=\"color: var(--text); margin-bottom: 16px;\">学習設定</h4>\n            \n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">学習期間開始日 <span style=\"color: #ff6a00;\">*</span></label>\n              <input type=\"date\" id=\"input-learning-start\" class=\"input\" required>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">学習期間終了日 <span style=\"color: #ff6a00;\">*</span></label>\n              <input type=\"date\" id=\"input-learning-end\" class=\"input\" required>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 8px; display: block;\">予測期間 <span style=\"color: #ff6a00;\">*</span></label>\n              <div style=\"display: flex; gap: 16px;\">\n                <label style=\"color: var(--text); display: flex; align-items: center; gap: 4px;\">\n                  <input type=\"radio\" name=\"prediction-period\" value=\"7\" required> 7日\n                </label>\n                <label style=\"color: var(--text); display: flex; align-items: center; gap: 4px;\">\n                  <input type=\"radio\" name=\"prediction-period\" value=\"30\" required> 30日\n                </label>\n                <label style=\"color: var(--text); display: flex; align-items: center; gap: 4px;\">\n                  <input type=\"radio\" name=\"prediction-period\" value=\"60\" required> 60日\n                </label>\n                <label style=\"color: var(--text); display: flex; align-items: center; gap: 4px;\">\n                  <input type=\"radio\" name=\"prediction-period\" value=\"90\" required> 90日\n                </label>\n              </div>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">アルゴリズム <span style=\"color: #ff6a00;\">*</span></label>\n              <select id=\"select-algorithm\" class=\"input\" required>\n                <option value=\"\">アルゴリズムを選択してください</option>\n                <option value=\"機械学習\">機械学習</option>\n                <option value=\"ディープラーニング\">ディープラーニング</option>\n                <option value=\"時系列分析\">時系列分析</option>\n                <option value=\"回帰分析\">回帰分析</option>\n                <option value=\"自動選択\">自動選択</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- 右列 -->\n        <div>\n          <!-- データソース設定 -->\n          <div style=\"margin-bottom: 24px;\">\n            <h4 style=\"color: var(--text); margin-bottom: 16px;\">使用データソース <span style=\"color: #ff6a00;\">*</span></h4>\n            <div style=\"display: grid; gap: 8px;\">\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" id=\"datasource-all\" style=\"margin: 0;\"> 全て選択\n              </label>\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" name=\"datasource\" value=\"売上\" class=\"datasource-item\" style=\"margin: 0;\"> 売上履歴\n              </label>\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" name=\"datasource\" value=\"天候\" class=\"datasource-item\" style=\"margin: 0;\"> 天候データ\n              </label>\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" name=\"datasource\" value=\"イベント\" class=\"datasource-item\" style=\"margin: 0;\"> イベントデータ\n              </label>\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" name=\"datasource\" value=\"季節\" class=\"datasource-item\" style=\"margin: 0;\"> 季節要因\n              </label>\n            </div>\n          </div>\n\n          <!-- パラメータ設定 -->\n          <div style=\"margin-bottom: 24px;\">\n            <h4 style=\"color: var(--text); margin-bottom: 16px;\">パラメータ設定</h4>\n            \n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">学習率</label>\n              <input type=\"range\" id=\"input-learning-rate\" min=\"0.00001\" max=\"1\" step=\"0.00001\" value=\"0.01\" style=\"width: 100%; margin-bottom: 4px;\">\n              <div style=\"display: flex; justify-content: space-between; color: var(--text-muted); font-size: 12px;\">\n                <span>0.00001</span>\n                <span id=\"learning-rate-value\">0.01</span>\n                <span>1.0</span>\n              </div>\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">モデル精度目標値 (%)</label>\n              <input type=\"number\" id=\"input-accuracy-target\" class=\"input\" min=\"0\" max=\"100\" placeholder=\"85\" value=\"85\">\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); font-size: 14px; margin-bottom: 4px; display: block;\">季節性調整パラメータ</label>\n              <input type=\"number\" id=\"input-seasonality\" class=\"input\" step=\"0.1\" placeholder=\"1.0\" value=\"1.0\">\n            </div>\n\n            <div style=\"margin-bottom: 16px;\">\n              <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n                <input type=\"checkbox\" id=\"checkbox-outlier-removal\" style=\"margin: 0;\"> 異常値除外設定\n              </label>\n            </div>\n          </div>\n\n          <!-- 重み付け設定 -->\n          <div style=\"margin-bottom: 24px;\">\n            <h4 style=\"color: var(--text); margin-bottom: 16px;\">重み付け設定</h4>\n            <div style=\"font-size: 12px; color: var(--text-muted); margin-bottom: 8px;\">合計: <span id=\"weight-total\">100</span>%</div>\n            <div style=\"display: grid; gap: 8px;\">\n              <div style=\"display: flex; align-items: center; gap: 8px;\">\n                <label style=\"color: var(--text); width: 80px; font-size: 14px;\">売上履歴</label>\n                <input type=\"number\" id=\"weight-sales\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"40\" style=\"flex: 1;\">\n                <span style=\"color: var(--text); font-size: 14px;\">%</span>\n              </div>\n              <div style=\"display: flex; align-items: center; gap: 8px;\">\n                <label style=\"color: var(--text); width: 80px; font-size: 14px;\">天候</label>\n                <input type=\"number\" id=\"weight-weather\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" style=\"flex: 1;\">\n                <span style=\"color: var(--text); font-size: 14px;\">%</span>\n              </div>\n              <div style=\"display: flex; align-items: center; gap: 8px;\">\n                <label style=\"color: var(--text); width: 80px; font-size: 14px;\">イベント</label>\n                <input type=\"number\" id=\"weight-event\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" style=\"flex: 1;\">\n                <span style=\"color: var(--text); font-size: 14px;\">%</span>\n              </div>\n              <div style=\"display: flex; align-items: center; gap: 8px;\">\n                <label style=\"color: var(--text); width: 80px; font-size: 14px;\">季節要因</label>\n                <input type=\"number\" id=\"weight-season\" class=\"input weight-input\" min=\"0\" max=\"100\" value=\"20\" style=\"flex: 1;\">\n                <span style=\"color: var(--text); font-size: 14px;\">%</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border);\">\n        <button type=\"button\" id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n        <button type=\"submit\" id=\"btn-save-model\" class=\"action-btn\">保存</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<!-- 成功メッセージ -->\n<div id=\"success-message\" class=\"hidden\" style=\"position: fixed; top: 20px; right: 20px; background: var(--bg-card); border: 1px solid #28a745; border-radius: 8px; padding: 16px; z-index: 1001; color: var(--text);\">\n  <div style=\"display: flex; align-items: center; gap: 8px;\">\n    <span style=\"color: #28a745;\">✓</span>\n    <span id=\"success-text\">モデルが正常に作成されました</span>\n  </div>\n</div>\n\n<!-- エラーメッセージ -->\n<div id=\"error-message\" class=\"hidden\" style=\"position: fixed; top: 20px; right: 20px; background: var(--bg-card); border: 1px solid #dc3545; border-radius: 8px; padding: 16px; z-index: 1001; color: var(--text);\">\n  <div style=\"display: flex; align-items: center; gap: 8px;\">\n    <span style=\"color: #dc3545;\">✗</span>\n    <span id=\"error-text\"></span>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}