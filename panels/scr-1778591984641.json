{
  "screenId": "scr-1778591984641",
  "screenName": "モデル設定画面",
  "html": "<div class=\"model-settings-screen\">\n  <!-- ヘッダー -->\n  <div class=\"screen-header\">\n    <h1>モデル設定</h1>\n    <p class=\"muted\">AI需要予測モデルのパラメータ設定、学習データの選択、予測精度の調整を行い、店舗や商品に最適化された予測モデルを構築・管理します</p>\n  </div>\n\n  <!-- メイン設定エリア -->\n  <div class=\"settings-container\">\n    <!-- 基本設定 -->\n    <div class=\"card\">\n      <h2>基本設定</h2>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label for=\"model-name\">モデル名 <span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"model-name\" class=\"input\" placeholder=\"モデル名を入力してください\" maxlength=\"255\">\n          <div class=\"error-message\" id=\"model-name-error\"></div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"target-store\">対象店舗 <span class=\"required\">*</span></label>\n          <select id=\"target-store\" class=\"input\">\n            <option value=\"\">店舗を選択してください</option>\n          </select>\n          <div class=\"error-message\" id=\"target-store-error\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 商品カテゴリ設定 -->\n    <div class=\"card\">\n      <h2>対象商品カテゴリ <span class=\"required\">*</span></h2>\n      <div class=\"checkbox-group\" id=\"product-categories\">\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"all\" id=\"select-all-categories\">\n          <span>全て選択</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"food\" name=\"category\">\n          <span>食品</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"daily\" name=\"category\">\n          <span>日用品</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"clothing\" name=\"category\">\n          <span>衣料品</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"electronics\" name=\"category\">\n          <span>電化製品</span>\n        </label>\n      </div>\n      <div class=\"error-message\" id=\"categories-error\"></div>\n    </div>\n\n    <!-- 学習期間設定 -->\n    <div class=\"card\">\n      <h2>学習期間設定 <span class=\"required\">*</span></h2>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label for=\"learning-start-date\">開始日</label>\n          <input type=\"date\" id=\"learning-start-date\" class=\"input\">\n        </div>\n        <div class=\"form-group\">\n          <label for=\"learning-end-date\">終了日</label>\n          <input type=\"date\" id=\"learning-end-date\" class=\"input\">\n        </div>\n      </div>\n      <div class=\"error-message\" id=\"learning-period-error\"></div>\n    </div>\n\n    <!-- 予測期間設定 -->\n    <div class=\"card\">\n      <h2>予測期間設定 <span class=\"required\">*</span></h2>\n      <div class=\"radio-group\">\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"7\">\n          <span>7日</span>\n        </label>\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"30\" checked>\n          <span>30日</span>\n        </label>\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"60\">\n          <span>60日</span>\n        </label>\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"90\">\n          <span>90日</span>\n        </label>\n      </div>\n    </div>\n\n    <!-- データソース設定 -->\n    <div class=\"card\">\n      <h2>使用データソース <span class=\"required\">*</span></h2>\n      <div class=\"checkbox-group\" id=\"data-sources\">\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"all\" id=\"select-all-sources\">\n          <span>全て選択</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"sales\" name=\"datasource\">\n          <span>売上履歴</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"weather\" name=\"datasource\">\n          <span>天候データ</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"events\" name=\"datasource\">\n          <span>イベントデータ</span>\n        </label>\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" value=\"seasonal\" name=\"datasource\">\n          <span>季節データ</span>\n        </label>\n      </div>\n      <div class=\"error-message\" id=\"datasources-error\"></div>\n    </div>\n\n    <!-- アルゴリズム設定 -->\n    <div class=\"card\">\n      <h2>アルゴリズム設定 <span class=\"required\">*</span></h2>\n      <div class=\"form-group\">\n        <label for=\"algorithm\">アルゴリズム</label>\n        <select id=\"algorithm\" class=\"input\">\n          <option value=\"\">アルゴリズムを選択してください</option>\n          <option value=\"linear\">線形回帰</option>\n          <option value=\"ml\">機械学習</option>\n          <option value=\"neural\">ニューラルネットワーク</option>\n          <option value=\"auto\">自動選択</option>\n        </select>\n        <div class=\"error-message\" id=\"algorithm-error\"></div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label for=\"learning-rate\">学習率: <span id=\"learning-rate-value\">0.01</span></label>\n        <input type=\"range\" id=\"learning-rate\" class=\"slider\" min=\"0.00001\" max=\"1\" step=\"0.00001\" value=\"0.01\">\n      </div>\n    </div>\n\n    <!-- 重み付け設定 -->\n    <div class=\"card\">\n      <h2>重み付け設定</h2>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>要因</th>\n              <th>重み（%）</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>売上履歴</td>\n              <td><input type=\"number\" class=\"input weight-input\" data-factor=\"sales\" min=\"0\" max=\"100\" value=\"40\"></td>\n            </tr>\n            <tr>\n              <td>天候</td>\n              <td><input type=\"number\" class=\"input weight-input\" data-factor=\"weather\" min=\"0\" max=\"100\" value=\"20\"></td>\n            </tr>\n            <tr>\n              <td>イベント</td>\n              <td><input type=\"number\" class=\"input weight-input\" data-factor=\"events\" min=\"0\" max=\"100\" value=\"20\"></td>\n            </tr>\n            <tr>\n              <td>季節性</td>\n              <td><input type=\"number\" class=\"input weight-input\" data-factor=\"seasonal\" min=\"0\" max=\"100\" value=\"20\"></td>\n            </tr>\n          </tbody>\n          <tfoot>\n            <tr>\n              <td><strong>合計</strong></td>\n              <td><strong><span id=\"weight-total\">100</span>%</strong></td>\n            </tr>\n          </tfoot>\n        </table>\n      </div>\n      <div class=\"error-message\" id=\"weights-error\"></div>\n    </div>\n\n    <!-- 詳細設定 -->\n    <div class=\"card\">\n      <h2>詳細設定</h2>\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label for=\"seasonal-param\">季節性調整パラメータ</label>\n          <input type=\"number\" id=\"seasonal-param\" class=\"input\" step=\"0.1\" min=\"0\" max=\"10\" value=\"1.0\">\n          <div class=\"error-message\" id=\"seasonal-param-error\"></div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"accuracy-target\">モデル精度目標値（%）</label>\n          <input type=\"number\" id=\"accuracy-target\" class=\"input\" min=\"0\" max=\"100\" value=\"85\">\n          <div class=\"error-message\" id=\"accuracy-target-error\"></div>\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" id=\"exclude-outliers\" checked>\n          <span>異常値除外設定を有効にする</span>\n        </label>\n      </div>\n      \n      <div class=\"form-group\">\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" id=\"seasonal-consideration\" checked>\n          <span>季節要因を考慮する</span>\n        </label>\n      </div>\n      \n      <div class=\"form-group\">\n        <label class=\"checkbox-item\">\n          <input type=\"checkbox\" id=\"alert-notification\">\n          <span>アラート通知を有効にする</span>\n        </label>\n      </div>\n    </div>\n\n    <!-- アクションボタン -->\n    <div class=\"action-buttons\">\n      <button type=\"button\" class=\"action-btn\" id=\"btn-create-model\">モデル作成</button>\n      <button type=\"button\" class=\"action-btn secondary\" id=\"btn-save-settings\">設定保存</button>\n      <button type=\"button\" class=\"action-btn secondary\" id=\"btn-test-model\">モデルテスト</button>\n      <button type=\"button\" class=\"action-btn secondary\" onclick=\"window.showScreen('scr-1778591780173')\">ダッシュボードに戻る</button>\n    </div>\n  </div>\n\n  <!-- 既存モデル一覧 -->\n  <div class=\"card\">\n    <div class=\"card-header\">\n      <h2>既存モデル一覧</h2>\n      <div class=\"header-actions\">\n        <input type=\"text\" id=\"input-search\" class=\"input\" placeholder=\"モデル名で検索...\">\n        <button type=\"button\" class=\"action-btn secondary\" id=\"btn-search\">検索</button>\n      </div>\n    </div>\n    \n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>モデル名</th>\n            <th>対象店舗</th>\n            <th>アルゴリズム</th>\n            <th>精度目標</th>\n            <th>作成日</th>\n            <th>ステータス</th>\n            <th>操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"models-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<style>\n.model-settings-screen {\n  padding: 20px;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.screen-header {\n  margin-bottom: 30px;\n}\n\n.screen-header h1 {\n  color: var(--text);\n  margin-bottom: 8px;\n}\n\n.settings-container {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  margin-bottom: 30px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.form-group label {\n  color: var(--text);\n  font-weight: 500;\n}\n\n.required {\n  color: #ff6a6a;\n}\n\n.checkbox-group, .radio-group {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 12px;\n  padding: 16px;\n  background: var(--bg-main);\n  border-radius: 8px;\n}\n\n.checkbox-item, .radio-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n  color: var(--text);\n}\n\n.checkbox-item input, .radio-item input {\n  margin: 0;\n}\n\n.slider {\n  width: 100%;\n  height: 6px;\n  border-radius: 3px;\n  background: var(--bg-main);\n  outline: none;\n}\n\n.slider::-webkit-slider-thumb {\n  appearance: none;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: var(--primary);\n  cursor: pointer;\n}\n\n.weight-input {\n  width: 80px;\n  text-align: center;\n}\n\n.action-buttons {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-start;\n  flex-wrap: wrap;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.header-actions {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.header-actions .input {\n  width: 200px;\n}\n\n.error-message {\n  color: #ff6a6a;\n  font-size: 14px;\n  min-height: 20px;\n}\n\n@media (max-width: 768px) {\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .checkbox-group, .radio-group {\n    grid-template-columns: 1fr;\n  }\n  \n  .card-header {\n    flex-direction: column;\n    gap: 16px;\n    align-items: stretch;\n  }\n  \n  .header-actions {\n    justify-content: stretch;\n  }\n  \n  .header-actions .input {\n    flex: 1;\n  }\n}\n</style>",
  "initJs": "function(container, apiUrl, tables) {}"
}