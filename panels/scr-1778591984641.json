{
  "screenId": "scr-1778591984641",
  "screenName": "モデル設定画面",
  "html": "<div class=\"model-config-screen\">\n  <!-- ヘッダー -->\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;\">\n    <h1 style=\"color: var(--text); margin: 0; font-size: 24px;\">モデル設定画面</h1>\n    <div>\n      <button id=\"btn-new-model\" class=\"action-btn\" style=\"margin-right: 8px;\">新規モデル作成</button>\n      <button id=\"btn-dashboard\" class=\"action-btn secondary\">ダッシュボードへ</button>\n    </div>\n  </div>\n\n  <!-- 既存モデル一覧 -->\n  <div class=\"card\" style=\"margin-bottom: 24px;\">\n    <h2 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 18px;\">既存モデル一覧</h2>\n    <div style=\"display: flex; gap: 12px; margin-bottom: 16px;\">\n      <input id=\"input-search\" type=\"text\" class=\"input\" placeholder=\"モデル名で検索...\" style=\"flex: 1;\">\n      <button id=\"btn-search\" class=\"action-btn secondary\">検索</button>\n    </div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th style=\"color: var(--text);\">モデル名</th>\n            <th style=\"color: var(--text);\">対象店舗</th>\n            <th style=\"color: var(--text);\">商品カテゴリ</th>\n            <th style=\"color: var(--text);\">アルゴリズム</th>\n            <th style=\"color: var(--text);\">精度目標</th>\n            <th style=\"color: var(--text);\">ステータス</th>\n            <th style=\"color: var(--text);\">操作</th>\n          </tr>\n        </thead>\n        <tbody id=\"model-list-tbody\">\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- モデル設定フォーム -->\n  <div class=\"card\" id=\"model-form-card\" style=\"display: none;\">\n    <h2 style=\"color: var(--text); margin: 0 0 24px 0; font-size: 18px;\" id=\"form-title\">新規モデル作成</h2>\n    \n    <!-- 基本設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">基本設定</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">モデル名 <span style=\"color: #ff6a00;\">*</span></label>\n          <input id=\"input-model-name\" type=\"text\" class=\"input\" placeholder=\"モデル名を入力\" maxlength=\"255\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">対象店舗 <span style=\"color: #ff6a00;\">*</span></label>\n          <select id=\"select-store\" class=\"input\">\n            <option value=\"\">店舗を選択してください</option>\n          </select>\n        </div>\n      </div>\n    </div>\n\n    <!-- 対象商品カテゴリ -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">対象商品カテゴリ <span style=\"color: #ff6a00;\">*</span></h3>\n      <div id=\"category-checkboxes\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;\">\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"食品\" name=\"category\"> 食品\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"日用品\" name=\"category\"> 日用品\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"衣料品\" name=\"category\"> 衣料品\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"家電\" name=\"category\"> 家電\n        </label>\n      </div>\n    </div>\n\n    <!-- 学習期間設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">学習期間設定</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">開始日</label>\n          <input id=\"input-start-date\" type=\"date\" class=\"input\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">終了日</label>\n          <input id=\"input-end-date\" type=\"date\" class=\"input\">\n        </div>\n      </div>\n    </div>\n\n    <!-- 予測期間設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">予測期間設定</h3>\n      <div style=\"display: flex; gap: 16px; flex-wrap: wrap;\">\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"7\"> 7日\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"30\" checked> 30日\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"60\"> 60日\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"radio\" name=\"prediction-period\" value=\"90\"> 90日\n        </label>\n      </div>\n    </div>\n\n    <!-- 使用データソース -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">使用データソース <span style=\"color: #ff6a00;\">*</span></h3>\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px;\">\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"売上\" name=\"datasource\"> 売上\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"天候\" name=\"datasource\"> 天候\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"イベント\" name=\"datasource\"> イベント\n        </label>\n        <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n          <input type=\"checkbox\" value=\"季節\" name=\"datasource\"> 季節\n        </label>\n      </div>\n    </div>\n\n    <!-- アルゴリズム選択 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">アルゴリズム選択 <span style=\"color: #ff6a00;\">*</span></h3>\n      <select id=\"select-algorithm\" class=\"input\" style=\"width: 300px;\">\n        <option value=\"\">アルゴリズムを選択してください</option>\n        <option value=\"機械学習\">機械学習</option>\n        <option value=\"時系列分析\">時系列分析</option>\n        <option value=\"回帰分析\">回帰分析</option>\n        <option value=\"自動選択\">自動選択</option>\n      </select>\n    </div>\n\n    <!-- 学習率設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">学習率設定</h3>\n      <div style=\"display: flex; align-items: center; gap: 16px;\">\n        <input id=\"input-learning-rate\" type=\"range\" min=\"0.00001\" max=\"1\" step=\"0.00001\" value=\"0.01\" style=\"flex: 1;\">\n        <span id=\"learning-rate-value\" style=\"color: var(--text); min-width: 80px;\">0.01</span>\n      </div>\n    </div>\n\n    <!-- 重み付け設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">重み付け設定</h3>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th style=\"color: var(--text);\">要因</th>\n              <th style=\"color: var(--text);\">重み(%)</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td style=\"color: var(--text);\">売上履歴</td>\n              <td><input id=\"weight-sales\" type=\"number\" class=\"input\" min=\"0\" max=\"100\" value=\"40\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td style=\"color: var(--text);\">天候要因</td>\n              <td><input id=\"weight-weather\" type=\"number\" class=\"input\" min=\"0\" max=\"100\" value=\"20\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td style=\"color: var(--text);\">季節要因</td>\n              <td><input id=\"weight-season\" type=\"number\" class=\"input\" min=\"0\" max=\"100\" value=\"25\" style=\"width: 80px;\"></td>\n            </tr>\n            <tr>\n              <td style=\"color: var(--text);\">イベント要因</td>\n              <td><input id=\"weight-event\" type=\"number\" class=\"input\" min=\"0\" max=\"100\" value=\"15\" style=\"width: 80px;\"></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <div style=\"margin-top: 8px;\">\n        <span style=\"color: var(--text-muted); font-size: 14px;\">合計: </span>\n        <span id=\"weight-total\" style=\"color: var(--text); font-weight: bold;\">100%</span>\n      </div>\n    </div>\n\n    <!-- 季節性調整パラメータ -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">季節性調整パラメータ</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">季節係数</label>\n          <input id=\"input-season-coefficient\" type=\"number\" class=\"input\" min=\"0\" max=\"10\" step=\"0.1\" value=\"1.0\">\n        </div>\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">トレンド係数</label>\n          <input id=\"input-trend-coefficient\" type=\"number\" class=\"input\" min=\"0\" max=\"10\" step=\"0.1\" value=\"1.0\">\n        </div>\n      </div>\n    </div>\n\n    <!-- その他設定 -->\n    <div style=\"margin-bottom: 24px;\">\n      <h3 style=\"color: var(--text); margin: 0 0 16px 0; font-size: 16px;\">その他設定</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;\">\n        <div>\n          <label style=\"color: var(--text); display: block; margin-bottom: 4px;\">モデル精度目標値(%)</label>\n          <input id=\"input-accuracy-target\" type=\"number\" class=\"input\" min=\"0\" max=\"100\" value=\"85\">\n        </div>\n        <div style=\"display: flex; align-items: end;\">\n          <label style=\"color: var(--text); display: flex; align-items: center; gap: 8px;\">\n            <input id=\"checkbox-outlier-removal\" type=\"checkbox\" checked> 異常値除外設定\n          </label>\n        </div>\n      </div>\n    </div>\n\n    <!-- ボタン -->\n    <div style=\"display: flex; gap: 12px; justify-content: flex-end;\">\n      <button id=\"btn-cancel\" class=\"action-btn secondary\">キャンセル</button>\n      <button id=\"btn-save\" class=\"action-btn\">保存</button>\n    </div>\n  </div>\n\n  <!-- エラーメッセージ表示エリア -->\n  <div id=\"error-message\" class=\"card\" style=\"display: none; background: rgba(255, 106, 0, 0.1); border-left: 3px solid #ff6a00; margin-top: 16px;\">\n    <p style=\"color: var(--text); margin: 0;\" id=\"error-text\"></p>\n  </div>\n\n  <!-- 成功メッセージ表示エリア -->\n  <div id=\"success-message\" class=\"card\" style=\"display: none; background: rgba(34, 197, 94, 0.1); border-left: 3px solid #22c55e; margin-top: 16px;\">\n    <p style=\"color: var(--text); margin: 0;\" id=\"success-text\"></p>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}